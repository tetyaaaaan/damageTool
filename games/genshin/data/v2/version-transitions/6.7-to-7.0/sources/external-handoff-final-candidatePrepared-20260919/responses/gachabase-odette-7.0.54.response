ad="this.__e=event" onerror="this.__e=event"/> <!--[-1--><!--]--> <!--[-1--><!--]--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----><!----></div> <section class="flex flex-col gap-2.5 w-full bg-glass bg-border scroll-m-4"><!--[0--><div class="flex items-stretch "><!--[-1--><!--]--> <h3 class="flex px-2.5 gap-2.5 bg-section-header grow min-w-0 items-stretch min-h-12 py-1 max-w-full"><div class="flex min-w-0 basis-0 grow self-stretch gap-2.5 items-center max-sm:w-full max-w-full"><!--[-1--><!--]--> <!--[0--><!--[1--><a href="/inventory/210287/210287/beta" class="group flex min-w-0 max-w-full items-center gap-1 self-center text-current no-underline"><!--[0--><span class="relative min-w-0 max-w-full text-left"><span class="min-w-0 block"><!--[0--><!--[0--><span class="gb-wrap-text font-semibold text-sm leading-3.5 uppercase tracking-widest"><!---->オデット・孤高の雪鳥<!----></span><!--]--><!--]--><!----></span></span><!--]--> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 shrink-0 not-group-hover:opacity-0 opacity-100 transition-opacity duration-100 pointer-events-none select-none"><path d="M21 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6"></path><path d="m21 3-9 9"></path><path d="M15 3h6v6"></path></svg><!----></a><!--]--><!--]--></div> <!--[-1--><!--]--></h3></div><!--]--> <!--[0--><div class="p-2.5 pt-0 flex flex-col gap-5"><!--[0--><span class="gb-wrap-text text-sm"><!--[0--><!---->名刺の飾り紋。<br/>璃月でもスネージナヤでも、白鳥は大きくて誇り高い鳥だと思われている。しかし、群れで暮らす習性を持つ雪鳥の中に、たった一羽だけ黒い雪鳥もいる。もちろん、これはあくまで『黒雪鳥』の物語での話だ。<!----><!--]--></span> <!--[-1--><!--]--><!--]--><!----></div><!--]--></section><!----></div><!--]--> <!--[0--><div class="flex flex-col sidebar:lg:flex-row not-sidebar:sm:flex-row gap-2.5 sidebar:max-lg:items-center not-sidebar:max-sm:items-center"><div class="max-w-64 max-h-64 w-full h-full aspect-square flex flex-col items-center justify-center relative bg-section-header rounded-[10px]"><!----><!--[0--><!--[0--><img class="max-w-64 cursor-pointer hover:opacity-90 transition-opacity svelte-sapi7u" loading="lazy" decoding="async" src="https://i.gachabase.net/7gxICgyEFGOCqJzLrqk3-tOvNptKAYBOYnSzUXzce9A/q:50/f:webp/plain/gi/assets/0bcbf57371d1ba4867b3375c3044b744.png" style="aspect-ratio: 256/256; aspect-ratio: 256/256;" data-preview-src="https://cdn.gachabase.net/gi/assets/0bcbf57371d1ba4867b3375c3044b744.png" data-preview-alt="Image" data-preview-download="https://cdn.gachabase.net/gi/assets/0bcbf57371d1ba4867b3375c3044b744.png" data-preview-thumbnail="https://i.gachabase.net/7gxICgyEFGOCqJzLrqk3-tOvNptKAYBOYnSzUXzce9A/q:50/f:webp/plain/gi/assets/0bcbf57371d1ba4867b3375c3044b744.png" onload="this.__e=event" onerror="this.__e=event"/> <!--[0--><div class="absolute  z-5 gb-lazy-spinner svelte-sapi7u"></div><!--]--> <!--[-1--><!--]--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----><!----></div> <section class="flex flex-col gap-2.5 w-full bg-glass bg-border scroll-m-4"><!--[0--><div class="flex items-stretch "><!--[-1--><!--]--> <h3 class="flex px-2.5 gap-2.5 bg-section-header grow min-w-0 items-stretch min-h-12 py-1 max-w-full"><div class="flex min-w-0 basis-0 grow self-stretch gap-2.5 items-center max-sm:w-full max-w-full"><!--[-1--><!--]--> <!--[0--><!--[1--><a href="/inventory/132017/132017/beta" class="group flex min-w-0 max-w-full items-center gap-1 self-center text-current no-underline"><!--[0--><span class="relative min-w-0 max-w-full text-left"><span class="min-w-0 block"><!--[0--><!--[0--><span class="gb-wrap-text font-semibold text-sm leading-3.5 uppercase tracking-widest"><!---->「湖畔の雪鳥」<!----></span><!--]--><!--]--><!----></span></span><!--]--> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 shrink-0 not-group-hover:opacity-0 opacity-100 transition-opacity duration-100 pointer-events-none select-none"><path d="M21 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6"></path><path d="m21 3-9 9"></path><path d="M15 3h6v6"></path></svg><!----></a><!--]--><!--]--></div> <!--[-1--><!--]--></h3></div><!--]--> <!--[0--><div class="p-2.5 pt-0 flex flex-col gap-5"><!--[0--><span class="gb-wrap-text text-sm"><!--[0--><!---->オデットのオリジナル料理。少量のサラダが皿の中心に静かに置かれている様は、まるでスポットライトが舞台の中央を照らし出しているかのよう。各層の造形も、彼女のステップのように正確だ。使われている食材も彼女が綿密に計算しており、全部食べても翌日の体重には絶対に影響しない…だから安心して、思い切り食べよう！<!----><!--]--></span> <!--[-1--><!--]--><!--]--><!----> <div class="flex flex-col gap-2.5"><h4 class="text-sm font-semibold text-gi-cryo uppercase">Effects</h4> <!--[0--><ul class="flex flex-col gap-2.5"><!--[--><li class="leading-4"><!--[0--><span class="gb-wrap-text text-sm"><!--[0--><!---->チーム全員の攻撃力+<span style="color: #3399CC;">160~228</span>、継続時間300秒。<!----><!--]--></span> <!--[-1--><!--]--><!--]--><!----></li><li class="leading-4"><!--[0--><span class="gb-wrap-text text-sm"><!--[0--><!---->マルチプレイ中、自分のキャラクターにのみ有効。<!----><!--]--></span> <!--[-1--><!--]--><!--]--><!----></li><!--]--></ul><!--]--></div> <div class="flex flex-col gap-2.5"><h4 class="text-sm font-semibold text-gi-cryo uppercase">Ingredients</h4> <!--[0--><div class="grid grid-cols-1 lg:grid-cols-2 gap-2.5"><!--[--><div class="bg-border rounded-[10px] svelte-76hoi7"><!--[0--><a class="border-rank-0 ingredient-entry shadow-splash-primary need-outline rounded-[10px] pl-3.75 p-2.5 flex justify-between items-center gap-2.5 text-sm leading-4 font-semibold border-l-[5px] bg-[#0d0d0d] text-left no-underline transition-shadow duration-300" href="/inventory/101280/101280/beta?lang=ja"><span class="flex gap-2.5 items-center min-w-0 svelte-76hoi7"><!----><!--[0--><!--[0--><img class="h-6 -m-1  svelte-sapi7u" loading="lazy" decoding="async" src="https://i.gachabase.net/ZUBLkhaDQnI74ThjBQCW-8OuCvPr2PN5RWYPbW2n7ds/q:50/f:webp/plain/gi/assets/c793ed3808d1fa827bb18ef1b4a50881.png" style="a