{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "genshin-version-transition-behavior-shard06-snapshot.schema.json",
  "title": "Genshin version transition behavior shard 06 snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generatedAt", "claim", "summary", "gateEligibility", "fieldDigestAlgorithm", "fieldDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "genshinVersionTransitionBehaviorShard06Snapshot" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "claim": { "$ref": "#/$defs/claim" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shardId", "authoritativeCandidates", "authoritativeEntities", "resolvedEntities", "overlapSkippedEntities", "ambiguousEntities", "resolvedRecords", "changedRecords", "changedFields", "sourceFamilyCount", "certificateEligibleClaims"],
      "properties": {
        "shardId": { "const": "behavior:behaviorSpec:semanticDecisionRequired:standard:06" },
        "authoritativeCandidates": { "const": 100 },
        "authoritativeEntities": { "const": 8 },
        "resolvedEntities": { "const": 8 },
        "overlapSkippedEntities": { "const": 0 },
        "ambiguousEntities": { "const": 0 },
        "resolvedRecords": { "const": 16 },
        "changedRecords": { "type": "integer", "minimum": 0 },
        "changedFields": { "type": "integer", "minimum": 0 },
        "sourceFamilyCount": { "const": 1 },
        "certificateEligibleClaims": { "const": 0 }
      }
    },
    "gateEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sourceFamilyCount", "canIssueEligibilityCertificate", "canPromoteCanonical", "reasons"],
      "properties": {
        "status": { "const": "singleCorrelatedFamilyFailClosed" },
        "sourceFamilyCount": { "const": 1 },
        "canIssueEligibilityCertificate": { "const": false },
        "canPromoteCanonical": { "const": false },
        "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "fieldDigestAlgorithm": { "const": "sha256-stable-json-v1" },
    "fieldDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "gitBlob": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameVersion", "revision", "packageVersion", "providerPath", "path", "url", "providerRecordId", "embeddedCharacterIds", "embeddedCharacterIdStatus", "gitBlob", "rawArtifactBytes", "rawArtifactSha256", "normalizedRecordDigest"],
      "properties": {
        "gameVersion": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/revision" },
        "packageVersion": { "type": "string", "minLength": 1 },
        "providerPath": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "providerRecordId": { "type": "integer", "minimum": 0 },
        "embeddedCharacterIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^100000[0-9]{2}$" } },
        "embeddedCharacterIdStatus": { "enum": ["present", "notProvidedByProviderRecord"] },
        "gitBlob": { "$ref": "#/$defs/gitBlob" },
        "rawArtifactBytes": { "type": "integer", "minimum": 1 },
        "rawArtifactSha256": { "$ref": "#/$defs/sha256" },
        "normalizedRecordDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameVersion", "revision", "packageVersion", "path", "url", "gitBlob", "rawArtifactBytes", "rawArtifactSha256", "name", "description"],
      "properties": {
        "gameVersion": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/revision" },
        "packageVersion": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "gitBlob": { "$ref": "#/$defs/gitBlob" },
        "rawArtifactBytes": { "type": "integer", "minimum": 1 },
        "rawArtifactSha256": { "$ref": "#/$defs/sha256" },
        "name": { "const": "genshin-db" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "fieldDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonPointer", "beforeValue", "afterValue", "beforeFieldDigest", "afterFieldDigest"],
      "properties": {
        "jsonPointer": { "type": "string" },
        "beforeValue": {},
        "afterValue": {},
        "beforeFieldDigest": { "$ref": "#/$defs/sha256" },
        "afterFieldDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "beforeNormalizedRecordDigest", "afterNormalizedRecordDigest", "changedFieldCount", "fieldDiffs"],
      "properties": {
        "status": { "enum": ["rawRecordMatch", "rawRecordChanged"] },
        "beforeNormalizedRecordDigest": { "$ref": "#/$defs/sha256" },
        "afterNormalizedRecordDigest": { "$ref": "#/$defs/sha256" },
        "changedFieldCount": { "type": "integer", "minimum": 0 },
        "fieldDiffs": { "type": "array", "items": { "$ref": "#/$defs/fieldDiff" } }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordKind", "before", "after", "comparison"],
      "properties": {
        "recordKind": { "enum": ["talents", "constellations"] },
        "before": { "$ref": "#/$defs/artifact" },
        "after": { "$ref": "#/$defs/artifact" },
        "comparison": { "$ref": "#/$defs/comparison" }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entityId", "name", "nameJa", "providerSlug", "resolutionStatus", "providerEntityIdEvidence", "treeResolution", "records"],
      "properties": {
        "entityId": { "type": "string", "pattern": "^100000[0-9]{2}$" },
        "name": { "type": "string", "minLength": 1 },
        "nameJa": { "type": "string", "minLength": 1 },
        "providerSlug": { "type": "string", "minLength": 1 },
        "resolutionStatus": { "const": "resolvedUnambiguousByProviderName" },
        "providerEntityIdEvidence": { "type": "string", "minLength": 1 },
        "treeResolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "directoryPaths", "pathResolution"],
          "properties": {
            "method": { "const": "pinnedProviderPathWithEmbeddedRecordIdentity" },
            "directoryPaths": { "type": "array", "const": ["src/data/English/talents", "src/data/English/constellations"] },
            "pathResolution": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["recordKind", "path"],
                "properties": {
                  "recordKind": { "enum": ["talents", "constellations"] },
                  "path": { "type": "string", "pattern": "^src/data/English/(talents|constellations)/[a-z0-9-]+\\.json$" }
                }
              }
            }
          }
        },
        "records": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/record" } }
      }
    },
    "queueShard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shardId", "queuePath", "requestedPrimaryBlockReason", "observedPrimaryBlockReason", "authoritativeCandidateCount", "authoritativeCandidateIds", "authoritativeCandidateIdsDigest", "authoritativeEntityCount", "authoritativeEntityIds", "authoritativeEntityIdsDigest", "overlapEntityIds", "overlapPolicy"],
      "properties": {
        "shardId": { "const": "behavior:behaviorSpec:semanticDecisionRequired:standard:06" },
        "queuePath": { "const": "reports/genshin-evidence-task-queue.json" },
        "requestedPrimaryBlockReason": { "const": "sourceMissing" },
        "observedPrimaryBlockReason": { "const": "semanticDecisionRequired" },
        "authoritativeCandidateCount": { "const": 100 },
        "authoritativeCandidateIds": { "type": "array", "minItems": 100, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^behavior:100000[0-9]{2}:[^:]+:.+$" } },
        "authoritativeCandidateIdsDigest": { "$ref": "#/$defs/sha256" },
        "authoritativeEntityCount": { "const": 8 },
        "authoritativeEntityIds": { "type": "array", "const": ["10000054", "10000055", "10000056", "10000057", "10000059", "10000060", "10000062", "10000063"] },
        "authoritativeEntityIdsDigest": { "$ref": "#/$defs/sha256" },
        "overlapEntityIds": { "const": [] },
        "overlapPolicy": { "const": "noneWithMaterializedBehaviorShards01To04" }
      }
    },
    "versionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameVersion", "revision", "packageVersion", "status", "package"],
      "properties": {
        "gameVersion": { "enum": ["6.7", "7.0"] },
        "revision": { "$ref": "#/$defs/revision" },
        "packageVersion": { "type": "string", "minLength": 1 },
        "status": { "const": "strictlyBound" },
        "package": { "$ref": "#/$defs/package" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transitionId", "fromGameVersion", "toGameVersion", "provider", "sourceFamily", "repository", "sourceFamilyCount", "queueShard", "versionBindings", "resolvedEntities", "travelerVariantEvidence", "variantAmbiguities", "coverage"],
      "properties": {
        "transitionId": { "const": "genshin:6.7->7.0" },
        "fromGameVersion": { "const": "6.7" },
        "toGameVersion": { "const": "7.0" },
        "provider": { "const": "genshin-db" },
        "sourceFamily": { "const": "GenshinData-derived" },
        "repository": { "const": "theBowja/genshin-db" },
        "sourceFamilyCount": { "const": 1 },
        "queueShard": { "$ref": "#/$defs/queueShard" },
        "versionBindings": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/versionBinding" } },
        "resolvedEntities": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/entity" } },
        "travelerVariantEvidence": { "const": [] },
        "variantAmbiguities": { "const": [] },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resolvedEntityIds", "ambiguousEntityIds", "recordKinds", "authoritativeCandidateCoverage", "resolvedEntityRecordCoverage", "travelerVariantRecordCoverage", "embeddedCharacterIdCoverage", "repositoryCandidateCoverage", "authoritativeCandidateCount", "authoritativeEntityCount", "resolvedEntityCount", "resolvedRecordCount", "changedRecordCount", "changedFieldCount", "overlapEntityCount", "crossVariantComparisons", "canIssueEligibilityCertificate", "canPromoteCanonical"],
          "properties": {
            "resolvedEntityIds": { "type": "array", "const": ["10000054", "10000055", "10000056", "10000057", "10000059", "10000060", "10000062", "10000063"] },
            "ambiguousEntityIds": { "const": [] },
            "recordKinds": { "const": ["talents", "constellations"] },
            "authoritativeCandidateCoverage": { "const": "entitySourceRecordsComplete" },
            "resolvedEntityRecordCoverage": { "const": "complete" },
            "travelerVariantRecordCoverage": { "const": "notApplicable" },
            "embeddedCharacterIdCoverage": { "const": "providerRecordDoesNotEmbedEntityId" },
            "repositoryCandidateCoverage": { "enum": ["partial", "complete"] },
            "authoritativeCandidateCount": { "const": 100 },
            "authoritativeEntityCount": { "const": 8 },
            "resolvedEntityCount": { "const": 8 },
            "resolvedRecordCount": { "const": 16 },
            "changedRecordCount": { "type": "integer", "minimum": 0 },
            "changedFieldCount": { "type": "integer", "minimum": 0 },
            "overlapEntityCount": { "const": 0 },
            "crossVariantComparisons": { "const": 0 },
            "canIssueEligibilityCertificate": { "const": false },
            "canPromoteCanonical": { "const": false }
          }
        }
      }
    }
  }
}
