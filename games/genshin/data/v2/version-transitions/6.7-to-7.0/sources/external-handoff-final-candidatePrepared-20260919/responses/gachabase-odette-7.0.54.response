file_size:6432,width:100,height:100},"7743092517765791823":{id:"7743092517765791823",url:"https://cdn.gachabase.net/gi/assets/9ef1d26dd6bfc5074648a1e08256cc4c.png",file_size:6239,width:100,height:100},"7813570102193008401":{id:"7813570102193008401",url:"https://cdn.gachabase.net/gi/assets/0bcbf57371d1ba4867b3375c3044b744.png",file_size:66339,width:256,height:256},"8183625270590285066":{id:"8183625270590285066",url:"https://cdn.gachabase.net/gi/assets/e2ae90ac6c14326555456ea4833726be.png",file_size:89512,width:256,height:256},"8925994068622777753":{id:"8925994068622777753",url:"https://cdn.gachabase.net/gi/assets/e9328819c2db6a76749976e86020c424.png",file_size:104702,width:256,height:256},"8947209970613809006":{id:"8947209970613809006",url:"https://cdn.gachabase.net/gi/assets/722565267cd631899407d15c430087e2.png",file_size:29639,width:256,height:256},"90063621133016508":{id:"90063621133016508",url:"https://cdn.gachabase.net/gi/assets/480de671c0c0640a04285c43c41ec441.png",file_size:7438,width:100,height:101},"9151787039196111838":{id:"9151787039196111838",url:"https://cdn.gachabase.net/gi/assets/8c3294c7d502f5a7a0366480a1338dac.png",file_size:7521,width:101,height:101}},weapon_types:{"1":{id:1,name:{key:"1338971406",text:"片手剣",override:null},icon_path_hash:"11528883048139936686"}},elements:{"5":{id:5,name:{key:"3168728290",text:"氷元素",override:null},icon_path_hash:"17846557813871886887",buff_icon_path_hash:"11619819545097023600"}},character_tags:{},stats:{"1":{id:1,name:{key:"931326071",text:"基礎HP",override:null},icon_path_hash:"8538967866437102284",format:"Integer"},"4":{id:4,name:{key:"2334963823",text:"基礎攻撃力",override:null},icon_path_hash:"10739234163512199809",format:"Integer"},"7":{id:7,name:{key:"466638175",text:"基礎防御力",override:null},icon_path_hash:"8826562612159629598",format:"Integer"},"22":{id:22,name:{key:"4137935949",text:"会心ダメージ",override:null},icon_path_hash:null,format:"Float1Percent"}},growth_curves:{"21":{id:21,operation:2,values:[1,1.083,1.166,1.25,1.333,1.417,1.5,1.584,1.668,1.751,1.835,1.919,2.003,2.088,2.172,2.256,2.341,2.425,2.51,2.594,2.679,2.764,2.849,2.934,3.019,3.105,3.19,3.275,3.361,3.446,3.532,3.618,3.704,3.789,3.875,3.962,4.048,4.134,4.22,4.307,4.393,4.48,4.567,4.653,4.74,4.827,4.914,5.001,5.089,5.176,5.263,5.351,5.438,5.526,5.614,5.702,5.79,5.878,5.966,6.054,6.142,6.23,6.319,6.407,6.496,6.585,6.673,6.762,6.851,6.94,7.029,7.119,7.208,7.297,7.387,7.476,7.566,7.656,7.746,7.836,7.926,8.016,8.106,8.196,8.286,8.377,8.467,8.558,8.649,8.739,8.83,8.921,9.012,9.103,9.195,9.286,9.377,9.469,9.56,9.652]},"31":{id:31,operation:2,values:[1,1.083,1.166,1.25,1.333,1.417,1.5,1.584,1.668,1.751,1.835,1.919,2.003,2.088,2.172,2.256,2.341,2.425,2.51,2.594,2.679,2.764,2.849,2.934,3.019,3.105,3.19,3.275,3.361,3.446,3.532,3.618,3.704,3.789,3.875,3.962,4.048,4.134,4.22,4.307,4.393,4.48,4.567,4.653,4.74,4.827,4.914,5.001,5.089,5.176,5.263,5.351,5.438,5.526,5.614,5.702,5.79,5.878,5.966,6.054,6.142,6.23,6.319,6.407,6.496,6.585,6.673,6.762,6.851,6.94,7.029,7.119,7.208,7.297,7.387,7.476,7.566,7.656,7.746,7.836,7.926,8.016,8.106,8.196,8.286,8.377,8.467,8.558,8.649,8.739,9.028,9.317,9.606,9.895,10.184,10.473,10.762,11.051,11.34,11.629]}},items:{"202":{id:202,name:{key:"3578052980",text:"モラ",override:null},description:{key:"495211989",text:"大陸で流通しているお金。世界で通用する共通言語、誰でも理解できる貴金属。",override:null},rarity:3,icon_path_hash:"17755734626094028860",namecard_alpha_path_hash:null,namecard_big_icon_path_hash:null},"100062":{id:100062,name:{key:"2577348708",text:"鳥の卵",override:null},description:{key:"783346733",text:"無限の可能性を持つ鳥類の卵。一日に必要なたんぱく質を摂取できる。",override:null},rarity:0,icon_path_hash:"1404789693290859748",namecard_alpha_path_hash:null,namecard_big_icon_path_hash:null},"100084":{id:100084,name:{key:"3499209748",text:"魚肉",override:null},description:{key:"524650565",text:"魚類の新鮮な肉。適切な料理をすると、とても味わい深い食事になる。",override:null},rarity:0,icon_path_hash:"3913571164442621596",namecard_alpha_path_hash:null,namecard_big_icon_path_hash:null},"101275":{id:101275,name:{key:"560079332",text:"フロストフラワー",override:null},description:{key:"167197085",text:"いかなる過酷な風雪の中でも開花する聖なる花。常に人の心を惹きつける微かな光を放っている。",override:null},rarity:0,icon_path_hash:"17448328805685852160",namecard_alpha_path_hash:null,namecard_big_icon_path_hash:null},"101280":{id:101280,name:{key:"3800890404",text:"雪玉花",override:null},description:{key:"3833144605",text:"花序が球形に近い可愛らしい花。雪が花びらに積もると、花全体がまるで雪玉のようになる。",override:null},rarity:0,icon_path_hash:"1865362235170915160",namecard_alpha_path_hash:null,namecard_big_icon_path_hash:null},"104161":{id:104161,name:{key:"3090648092",text:"哀切なアイスクリスタル·砕屑",override:null},description:{key:"709753093",text:"キャラクターの突破用アイテム。",override:null},rarity:2,icon_path_hash:"18276017949956885197",namecard_alpha_path_hash:null,namecard_big_icon_path_hash:null},"104162":{id:104162,name:{key:"2226067636",text:"哀切なアイスクリスタル·欠片",override:null},description:{key:"1129611469",text:"キャラクターの突破用アイテム。\\n「…ごめんなさい…」",override:null},rarity:3,icon_path_hash:"16478715774902447096",namecard_alpha_path_hash:null,namecard_big_icon_path_hash:null},"104163":{id:104163,name:{key:"498228604",text:"哀切なアイスクリスタル·塊",override:null},description:{key:"3291194701",text:"キャラクターの突破用アイテム。\\n「…ごめんなさい…」\\n「あなたたちにまで、この世界の悲しみを背負わせてしまって…」",override:null},rarity:4,icon_path_hash:"8947209970613809006",namecard_alpha_path_hash:null,namecard_big_icon_path_hash:null},"104164":{id:104164,name:{key:"1494672620",text:"哀切なアイスクリスタル",override:null},description:{key:"4048716093",text:"キャラクターの突破用アイテム。\\n「…ごめんなさい。あなたたちにまで、この世界の悲しみを背負わせてしまって…」\\n「私の寒さに耐えられる者は、きっと胸の内に燃え上がるような欲望を抱いているのでしょう。」\\n「ならば、私の代わりに、この旧世界を焼き尽くして。」",override:null},rarity:5,icon_path_hash:"13998602462318431899",namecard_alpha_path_hash:null,namecard_big_icon_path_hash:null},"104319":{id:104319,name:{key:"2454932596",text:"知恵の冠",override:null},description:{key:"290910685",text:"天賦のLvUpに必要なレア素材。\\n遥か昔に、知恵の伝承に使用していた儀式の器具。現在、知恵はすでに言語や典籍と一体化している。しかし「知恵の冠」に残された力と知識は今の人に偉大なる突破をもたらしてくれる。",override:null},rarity:5,icon_path_hash:"713684430359232183",namecard_alpha_path_hash:null,namecard_big_icon_path_hash:null},"104365":{id:104365,name:{key:"505625700",text:"「慈愛」の教え",override:null},description:{key:"2745158085",text:"天賦育成素材。\\n「慈愛」は氷の国の救済である。\\nそれは凡人の間で分かち合われる、慈しみと寄り添いの心。この広大無辺の地において、人々はこれによって霜雪がもたらす寒さに抗い、記憶に刻まれた傷跡を癒やす。",override:null},rarity:2,icon_path_hash:"1941205315277563924",namecard_alpha_path_hash:null,namecard_big_icon_path_hash:null},"104366":{id:104366,name:{key:"222584948",text:"「慈愛」の導き",override:null},description:{key:"2534157317",text:"天賦育成素材。\\n「慈愛」は氷の国土の救済である。\\n慈愛は他者への憐れみを育む。風雪の国において、魂の罪責を心から悔い改める者は、慈愛という名の許しを得ることができる。",override:null},rarity:3,icon_path_hash:"2997102573983989643",namecard_alpha_path_hash:null,namecard_big_icon_path_hash:null},"104367":{id:104367,name:{key:"1248493628",text:"「慈愛」の哲学",override:null},description:{key:"2522683797",text:"天賦育成素材。\\n「慈愛」は氷の国土の救済である。\\n慈愛とは衆生への思いやりであり、身分の高低や貴賤を消し去り、血脈や国境を越える。慈愛の眼差しは常にすべての人に注がれ、不幸な者には加護を与え、人々には永遠の解放を約束する。",override:null},rarity:4,icon_path_hash:"11269780026371967385",namecard_alpha_path_hash:null,namecard_big_icon_path_hash:null},"110009":{id:110009,name:{key:"276445548",text:"チーズ",override:null},description:{key:"921668909",text:"牛乳を濃縮させて発酵させた乳製品。エネルギーを補充できるだけでなく、料理に無限の可能性を与えてくれる。",override:null},rarity:0,icon_path_hash:"12905622642702554841",namecard_alpha_path_hash:null,namecard_big_icon_path_hash:null},"112146":{id:112146,name:{key:"1458299076",text:"幻光の屑",override:null},description:{key:"1247080909",text:"スネージナヤのフェイが戦闘後に残したもの。\\nフェイの体表に育つ結晶の欠片の細かい屑。剥がれ落ちる時に色を失い、まるで蛾の鱗粉のようだ。",override:null},rarity:1,icon_path_hash:"12064371681326627947",namecard_alpha_path_hash:null,namecard_big_icon_path_hash:null},"112147":{id:112147,name:{key:"398604620",text:"幻光の裂晶",override:null},description:{key:"3481637973",text:"スネージナヤのフェイが戦闘後に残したもの。\\nフェイの体表で育つ結晶が砕けた欠片。すでに空っぽになってはいるが、かつてそこに宿っていた独特な力を感じ取ることができる。",override:null},rarity:2,icon_path_hash:"3719546492695393408",namecard_alpha_path_hash:null,namecard_big_icon_path_hash:null},"112148":{id:112148,name:{key:"3631088012",text:"幻光の晶鱗石",override:null},description:{key:"2650010693",text:"スネージナヤのフェイが戦闘後に残したもの。\\nフェイの体表で育つ結晶の欠片。体表に結晶の欠片を多く持つフェイほど、より多くの力を操れると言われている。しかし、その力がフェイの体内に宿り、晶塊を通して放たれているだけなのか、それとも晶塊こそが力の器なのかは、誰にも分からない。",override:null},rarity:3,icon_path_hash:"2345412370370215044",namecard_alpha_path_hash:null,namecard_big_icon_path_hash:null},"113088":{id:113088,name:{key:"2160225572",text:"歪曲した枯れ枝",override:null},description:{key:"4059858197",text:"世界樹に潜む異端者を打ち倒し、損壊した地脈の奥深くから拾得した枯れ枝。\\n本来、深遠なる地の底に隠されているはずの巨木から生えた歪んだ枝。主の元から遠く離れてもなお、奇怪で邪悪な力が残留している。",override:null},rarity:5,icon_path_hash:"5128928566432387154",namecard_alpha_path_hash:null,namecard_big_icon_path_hash:null},"113090":{id:113090,name:{key:"3455637732",text:"炎中不滅の枝",override:null},description:{key:"2444730661",text:"ある者が私欲のために作り出した合成獣の体から切り取られた、炎の中でも焼け焦げない花をつけた枝。\\n陰鬱な錬金術師は、命を永遠にする方法を見つけた。それを実行に移す前、創り出された赤い羽のような葉を持つ獣の体を撫でながら、いつの日か不滅の合成獣が炎の中から、長らく待ち望んだ友を迎える光景を思い描いた。その時が来たら…創造物の身体から永遠に咲く花を折り、相手が闇域から逃れた祝いに贈るべきなのかもしれない。",override:null},rarity:4,icon_path_hash:"12742494260449313961",namecard_alpha_path_hash:null,namecard_big_icon_path_hash:null},"132017":{id:132017,name:{key:"2993894548",text:"「湖畔の雪鳥」",override:null},description:{key:"788231285",text:"オデットのオリジナル料理。少量のサラダが皿の中心に静かに置かれている様は、まるでスポットライトが舞台の中央を照らし出しているかのよう。各層の造形も、彼女のステップのように正確だ。使われている食材も彼女が綿密に計算しており、全部食べても翌日の体重には絶対に影響しない…だから安心して、思い切り食べよう！",override:null},rarity:3,icon_path_hash:"7813570102193008401",namecard_alpha_path_hash:null,namecard_big_icon_path_hash:null},"210287":{id:210287,name:{key:"504799708",text:"オデット・孤高の雪鳥",override:null},description:{key:"1654452429",text:"名刺の飾り紋。\\n璃月でもスネージナヤでも、白鳥は大きくて誇り高い鳥だと思われている。しかし、群れで暮らす習性を持つ雪鳥の中に、たった一羽だけ黒い雪鳥もいる。もちろん、これはあくまで『黒雪鳥』の物語での話だ。",override:null},rarity:4,icon_path_hash:"17695981262840418851",namecard_alpha_path_hash:"5686446211024434841",namecard_big_icon_path_hash:"17846632495462411121"}},proud_skill_types:{"2":{id:2,name:{key:"2602723764",text:"固有天賦",override:null}}},tooltips:{"11190007":{id:11190007,name:{key:"65905204",text:"向上",override:null},description:{key:"3069893425",text:"特殊なダメージアップ効果。他のダメージアップ効果とは別に計算される。",override:null},parameters:["","","","",""]},"11330003":{id:11330003,name:{key:"952980404",text:"極星フィールド",override:null},description:{key:"1792761473",text:"星電導反応を発動すると、近くのエリアがしばらくの間\u003Ccolor=#FFD780FF>極星フィールド\u003C/color>に変化する。極星フィールド内にいる間、特定のキャラクターは\u003Ccolor=#FFD780FF>輝映・星電導\u003C/color>状態に入り、各スキルはそれぞれに対応する強化効果を得る。",override:null},parameters:["","","","",""]},"11500001":{id:11500001,name:{key:"4264272788",text:"独舞者のシルエット",override:null},description:{key:"918370817",text:"オデットと共に舞う心象の倒影。元素スキルまたは元素爆発を発動することでフィールド上に召喚できる。\\n\u003Ccolor=#FFD780FF>プルーム\u003C/color>と\u003Ccolor=#FFD780FF>ウィング\u003C/color>の2種類のステップを交互に踏み、優雅で軽やかな舞いによって一定時間ごとに付近の敵を攻撃し、\u003Ccolor=#99FFFFFF>氷元素範囲ダメージ\u003C/color>を与える。\\nオデット自身が創造した\u003Ccolor=#FFD780FF>独舞者のシルエット\u003C/color>は1つのみ存在可能。\\n\\nまた、周囲にオデット自身が召喚した\u003Ccolor=#FFD780FF>独舞者のシルエット\u003C/color>が存在する時、オデットの元素スキル\u003Ccolor=#FFD780FF>柔きファントムの夜の舞\u003C/color>は特殊な元素スキル\u003Ccolor=#FFD780FF>柔き払暁のコーダ\u003C/color>に変化する。",override:null},parameters:["","","","",""]},"11500002":{id:11500002,name:{key:"1114765276",text:"柔き払暁のコーダ",override:null},description:{key:"775812049",text:"オデットの特殊な元素スキル。周囲の敵に持続的に\u003Ccolor=#99FFFFFF>氷元素範囲ダメージ\u003C/color>を与え、踊りが終わると、星電導反応ダメージと見なされる\u003Ccolor=#99FFFFFF>氷元素範囲ダメージ\u003C/color>を1回与える。踊りの間、オデットはステップの方向をコントロールできる。\\n\u003Ccolor=#FFD780FF>輝映・星閃\u003C/color>：踊りの終了時、代わりに対応する星反応ダメージと見なされる\u003Ccolor=#99FFFFFF>氷元素範囲ダメージ\u003C/color>を1回与える。\\n\\nさらに、特殊な元素スキル\u003Ccolor=#FFD780FF>柔き払暁のコーダ\u003C/color>を発動した後、\u003Ccolor=#FFD780FF>独舞者のシルエット\u003C/color>の残り継続時間内にオデットが\u003Ccolor=#FFD780FF>輝映・星閃\u003C/color>状態にある場合、\u003Ccolor=#FFD780FF>独舞者のシルエット\u003C/color>の2種類のステップは、対応する星反応ダメージと見なされる\u003Ccolor=#99FFFFFF>氷元素範囲ダメージ\u003C/color>を追加で与える。",override:null},parameters:["","","","",""]},"11500003":{id:11500003,name:{key:"1527880684",text:"春の華",override:null},description:{key:"2362663849",text:"固有天賦「選ばれし者の祝祭」を解放後、オデットが\u003Ccolor=#FFD780FF>独舞者のシルエット\u003C/color>を召喚した際に獲得できる特殊効果。\\n\u003Ccolor=#FFD780FF>春の華\u003C/color>1層につき、キャラクターが与える星反応ダメージ+15%。この効果は\u003Ccolor=#FFD780FF>独舞者のシルエット\u003C/color>が退場するか、\u003Ccolor=#FFD780FF>独舞者のシルエット\u003C/color>を再召喚するまで持続する。\\nオデットが待機中の場合、オデットは毎秒1層の\u003Ccolor=#FFD780FF>春の華\u003C/color>をクリアし、付近にいるチーム内の他のキャラクターに対応する層数の\u003Ccolor=#FFD780FF>春の華\u003C/color>を獲得させる。",override:null},parameters:["0.15","1","","",""]},"11500004":{id:11500004,name:{key:"3157748",text:"輝映・星閃",override:null},description:{key:"337661713",text:"\u003Ccolor=#FFD780FF>輝映・星電導\u003C/color>と\u003Ccolor=#FFD780FF>輝映・星拡散\u003C/color>を\u003Ccolor=#FFD780FF>輝映・星閃\u003C/color>状態と総称する。\\nキャラクターはどちらか1種類の輝映状態からしか影響を受けられず、優先的に\u003Ccolor=#FFD780FF>輝映・星電導\u003C/color>の影響を受ける。",override:null},parameters:["","","","",""]}},text_maps:{},recipes:{"3706":{id:3706,slug:"snowball-blooms-atop-snowfields",name:{key:"3771622840",text:"白の雪玉花",override:null},description:{key:"162741338",text:"定番のレイヤードサラダ。下ごしらえした食材を層状に重ね、各層の間に味付けしたサワークリームソースを塗る。盛り付け後は、味をしっかりとなじませるためにしばらく寝かせるのが一般的だ。出来上がった姿が、雪原に雪玉花が群れ咲く様子に似ていることから、この名が付けられた。",override:null},effect_descriptions:[{key:"3573748053",text:"チーム全員の攻撃力+\u003Ccolor=#3399CCFF>160~228\u003C/color>、継続時間300秒。",override:null},{key:"1771608073",text:"マルチプレイ中、自分のキャラクターにのみ有効。",override:null},null,null],required_items:[{item_id:101280,amount:3},{item_id:100084,amount:2},{item_id:110009,amount:1},{item_id:100062,amount:1},{item_id:0,amount:0}]}}},character_id:10000150,base_slug:"odette",display_name:void 0,variant_element_id:void 0,variant_depot_id:void 0,colors:{bgColor:"bg-gi-cryo text-section-body",bgColorHalf:"bg-gi-cryo/50 text-white",hoverBgColor:"hover:bg-gi-cryo hover:text-section-body",textColor:"text-gi-cryo",pairTextColor:"text-section-body",borderColor:"border-gi-cryo"},variants:{"10613035475164543785":{webp:"https://i.gachabase.net/B10tEWkpEXngVQyyuYr0yyPfZ0gGVDX5EdPfEddSkoU/q:50/f:webp/plain/gi/assets/6ead9454891939ae5bd696e53d986916.png"},"11016985440208467066":{webp:"https://i.gachabase.net/xSNXO0MaKObCrsZ9hCSbQwXe5gJKirXpborvZFbluaE/q:50/f:webp/plain/gi/assets/c7dc10c1650ba0d168f389212803ca4e.png"},"11269780026371967385":{webp:"https://i.gachabase.net/V1f5yQmd5gOkq8Z8qT6Kmi5V2Hz0LACTp8sdqVp371c/q:50/f:webp/plain/gi/assets/c073425c31543779f8db8a61185538b6.png"},"11528883048139936686":{webp:"https://i.gachabase.net/-OVyY-W7dxQas5_QFBzVYvfti48a9ZjNfMBNauMRe6Q/q:50/f:webp/plain/gi/assets/1fcb7b09b82b0fd3eb99b690dd5fea05.png"},"12064371681326627947":{webp:"https://i.gachabase.net/WkuarR8ahpFE-Z13UkEUq8Px8CuBhejjZsVK6w_cxSI/q:50/f:webp/plain/gi/assets/d315ce40a4d2918fba96ad4dab1456ab.png"},"12088921804868560726":{webp:"https://i.gachabase.net/WTyhHi9ySi78NC-TSwC20Qn9ydzZKDxW5ZOjXatKcqs/q:50/f:webp/plain/gi/assets/da396fe27883de894c4a4a7ec8bba2a3.png"},"12742494260449313961":{webp:"https://i.gachabase.net/BMvzz0Wzw-HP_tsjlCRjge3zp_Rpx0b8DD6-chp0tLM/q:50/f:webp/plain/gi/assets/de62ea27ebe5a2c0848aae5c6ea8fab8.png"},"12846472216925348440":{webp:"https://i.gachabase.net/OtGVOjFv6qRVHHZU5TIvG4KGR7EMRScb81rJGNEAx6s/q:50/f:webp/plain/gi/assets/2643b825e8148220ba22ab90019719c0.png"},"12905622642702554841":{webp:"https://i.gachabase.net/EAqZxAxlojWOOtf0isLYK4GkNvQxQ2mRyt0js0guhUc/q:50/f:webp/plain/gi/assets/8fd9fcfeaa88804476180fbb887f3b27.png"},"12929499050509717953":{webp:"https://i.gachabase.net/PY-ul6ZStguo7lMVMyXb7DkCml4zfy8XiWwuZPtYLDs/q:50/f:webp/plain/gi/assets/8c597021140d7303825f3659f8ee1c75.png"},"13433933038932466161":{webp:"https://i.gachabase.net/ByDHnYH6CziTGAHqwSQGEELWPdOX-xQoDJitV2nZOsM/q:50/f:webp/plain/gi/assets/50ff2e009c1ef521aa347bed72e5e9aa.png"},"13464862790376013535":{webp:"https://i.gachabase.net/Aw_y3WNSUMfepSF0KBEsu4SDreUjTIyheUthcDM3Tmw/q:50/f:webp/plain/gi/assets/6f6912c96a5f1b61ee1a12e481e9695b.png"},"1387479322476826027":{webp:"https://i.gachabase.net/sZnVXj8muCzK-ycakUaY3nUXEtPlKc0sokOATOe-8vc/q:50/f:webp/plain/gi/assets/53f6f9270706c42d2de5256d5059c78e.png"},"13998602462