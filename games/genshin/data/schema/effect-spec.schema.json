{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tetinet.example/schemas/genshin/effect-spec.schema.json",
  "title": "Genshin structured effect specification",
  "type": "object",
  "required": ["id", "entity", "sourceRefs", "interpretation", "effect", "verification", "runtime"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "entity": {
      "type": "object",
      "required": ["kind", "id", "component"],
      "properties": {
        "kind": { "enum": ["character", "weapon", "artifactSet", "constellation", "talent", "reaction"] },
        "id": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "interpretation": {
      "type": "object",
      "required": ["method", "author", "version"],
      "properties": {
        "method": { "enum": ["human", "deterministicParser", "aiAssisted"] },
        "author": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "required": ["dataset", "entityId", "collection"],
      "properties": {
        "dataset": { "enum": ["weaponModifiers", "artifactSetModifiers", "talentModifiers", "constellationModifiers", "behaviorModifiers"] },
        "entityId": { "type": "string", "minLength": 1 },
        "collection": { "enum": ["modifiers", "onePiece", "twoPiece", "fourPiece", "passive", "constellation"] },
        "sourceId": { "type": "string", "minLength": 1 },
        "level": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "dataset": { "const": "weaponModifiers" } } },
          "then": { "properties": { "collection": { "const": "modifiers" } } }
        },
        {
          "if": { "properties": { "dataset": { "const": "artifactSetModifiers" } } },
          "then": { "properties": { "collection": { "enum": ["onePiece", "twoPiece", "fourPiece"] } } }
        },
        {
          "if": { "properties": { "dataset": { "const": "talentModifiers" } } },
          "then": { "required": ["sourceId"], "properties": { "collection": { "const": "passive" } } }
        },
        {
          "if": { "properties": { "dataset": { "const": "constellationModifiers" } } },
          "then": { "required": ["level"], "properties": { "collection": { "const": "constellation" } } }
        },
        {
          "if": { "properties": { "dataset": { "const": "behaviorModifiers" } } },
          "then": { "properties": { "collection": { "const": "modifiers" } } }
        }
      ],
      "additionalProperties": false
    },
    "supersedesLegacyModifierIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "effect": {
      "type": "object",
      "required": ["kind", "targets", "activation"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "targets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "activation": { "type": "object" },
        "value": {},
        "durationSeconds": { "type": ["number", "null"], "minimum": 0 },
        "intervalSeconds": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "cooldownSeconds": { "type": ["number", "null"], "minimum": 0 },
        "hitCount": { "type": ["number", "null"], "minimum": 0 },
        "charges": { "type": ["number", "null"], "minimum": 0 },
        "maxInstances": { "type": ["number", "null"], "minimum": 0 },
        "stack": { "type": ["object", "null"] },
        "elementApplication": { "type": ["object", "null"] },
        "energy": { "type": ["object", "null"] },
        "snapshot": { "enum": ["yes", "no", "unknown", null] },
        "offField": { "enum": ["yes", "no", "unknown", null] },
        "area": { "enum": ["single", "aoe", "variable", "unknown", null] }
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": ["status", "reviewedBy", "reviewedAt", "sourceAgreement", "claims", "discrepancies"],
      "properties": {
        "status": { "enum": ["unreviewed", "needsReview", "verified", "rejected"] },
        "verificationMode": { "enum": ["human", "deterministicConsensus"] },
        "reviewedBy": { "type": ["string", "null"] },
        "reviewedAt": { "type": ["string", "null"], "format": "date-time" },
        "sourceAgreement": { "enum": ["singleSource", "agreed", "disputed", "unknown"] },
        "claims": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["status", "sourceRefs"],
            "properties": {
              "status": { "enum": ["verified", "needsReview", "disputed", "notApplicable"] },
              "claimKind": { "enum": ["externalFactual", "internalRuntimeRoute", "mappingMaterialization", "derivedDeterministic", "notApplicable"] },
              "sourceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "notes": { "type": "string" },
              "candidateId": { "type": "string", "minLength": 1 },
              "claimId": { "type": "string", "minLength": 1 },
              "field": { "type": "string", "minLength": 1 },
              "verificationAttestation": { "type": "object", "minProperties": 1 },
              "eligibilityCertificate": { "type": "object", "minProperties": 1 },
              "machineEvidence": {
                "type": "object",
                "required": ["ready", "blockedReasons"],
                "properties": {
                    "ready": { "type": "boolean" },
                    "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                    "comparison": { "enum": ["match", "mismatch", "notComparable", "notRequired"] },
                    "codeProvenance": {
                      "type": "object",
                      "required": ["deterministic", "path", "locator", "digest"],
                      "properties": {
                        "deterministic": { "const": true },
                        "path": { "type": "string", "minLength": 1 },
                        "locator": { "type": "string", "minLength": 1 },
                        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                      },
                      "additionalProperties": false
                    },
                    "focusedTests": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": ["id", "status"],
                        "properties": {
                          "id": { "type": "string", "minLength": 1 },
                          "status": { "const": "passed" }
                        },
                        "additionalProperties": false
                      }
                    },
                    "sourceInputsVerified": { "type": "boolean" },
                    "applicabilityDetermined": { "type": "boolean" },
                    "blockedReasons": { "type": "array", "items": { "type": "string", "minLength": 1 } }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "discrepancies": { "type": "array", "items": { "type": "object" } },
        "machineEvidenceReady": { "type": "boolean" },
        "canonicalEligibility": { "type": "boolean" },
        "state": { "enum": ["rawEvidence", "machineEvidenceComplete", "humanReviewReady", "humanReviewed", "canonicalEligible", "productionCanonical"] },
        "claimProofs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["candidateId", "claimId", "field", "verificationAttestation", "eligibilityCertificate"],
            "properties": {
              "candidateId": { "type": "string", "minLength": 1 },
              "claimId": { "type": "string", "minLength": 1 },
              "field": { "type": "string", "minLength": 1 },
              "verificationAttestation": { "type": "object", "minProperties": 1 },
              "eligibilityCertificate": { "type": "object", "minProperties": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "verificationMode": { "const": "human" } } },
          "then": { "properties": { "reviewedBy": { "type": "string", "minLength": 1 }, "reviewedAt": { "type": "string", "format": "date-time" } } }
        },
        {
          "if": { "properties": { "verificationMode": { "const": "deterministicConsensus" } } },
          "then": { "properties": { "reviewedBy": { "type": "null" }, "reviewedAt": { "type": "null" } } }
        }
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["status", "modifierIds", "generator"],
      "properties": {
        "status": { "enum": ["blocked", "candidate", "canonical", "displayOnly"] },
        "modifierIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "generator": { "type": ["string", "null"] },
        "blockedReasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "destination": {
          "type": "object",
          "required": ["dataset", "entityId", "collection"],
          "properties": {
            "dataset": { "enum": ["weaponModifiers", "artifactSetModifiers", "talentModifiers", "constellationModifiers", "behaviorModifiers"] },
            "entityId": { "type": "string", "minLength": 1 },
            "collection": { "enum": ["modifiers", "onePiece", "twoPiece", "fourPiece", "passive", "constellation"] },
            "sourceId": { "type": "string", "minLength": 1 },
            "level": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "supersedesLegacyModifierIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
