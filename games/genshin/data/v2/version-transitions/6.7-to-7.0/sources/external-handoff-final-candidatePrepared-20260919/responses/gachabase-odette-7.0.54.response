    10</span><!----> <!--[--><!--$s2--><!--[-1--><!----><div data-scope="slider" data-part="root" data-orientation="horizontal" id="slider:s2" dir="ltr" style="--slider-thumb-offset-0:calc(64.28571428571429% - 0px);--slider-thumb-transform:translateX(-50%);--slider-range-start:0%;--slider-range-end:35.71428571428571%;" class="relative flex w-full touch-none select-none items-center overflow-hidden h-8"><!--[--><!--[-1--><!----><div data-scope="slider" data-part="control" dir="ltr" id="slider:s2:control" data-orientation="horizontal" style="touch-action:none;user-select:none;webkit-user-select:none;position:relative;" class="w-full relative flex items-center"><!--[--><!--[-1--><!----><div data-scope="slider" data-part="track" dir="ltr" id="slider:s2:track" data-orientation="horizontal" style="position:relative;" class="bg-white relative h-1 w-full grow cursor-pointer rounded-full"><!--[--><!--[-1--><!----><div id="slider:s2:range" data-scope="slider" data-part="range" dir="ltr" data-orientation="horizontal" style="position:absolute;left:var(--slider-range-start);right:var(--slider-range-end);" class="bg-gi-cryo text-section-body absolute h-full rounded-full"><!----><!----></div><!----><!--]--><!--]--><!----><!----></div><!----><!--]--><!--]--> <!--[--><!--[-1--><!----><div data-scope="slider" data-part="thumb" dir="ltr" data-index="0" id="slider:s2:thumb:0" data-orientation="horizontal" draggable="false" aria-labelledby="slider:s2:label" aria-orientation="horizontal" aria-valuemax="15" aria-valuemin="1" aria-valuenow="10" role="slider" tabindex="0" style="visibility:hidden;position:absolute;transform:var(--slider-thumb-transform);inset-inline-start:var(--slider-thumb-offset-0);" class="bg-white size-5 border-3 sm:size-3.5 rounded-full sm:border-2 border-gi-cryo outline-none ring-0 cursor-pointer"><!--[--><!--[2--><!----><input type="text" hidden="" value="10" id="slider:s2:input:0"><!----><!--]--><!--]--><!----><!----></div><!----><!--]--><!----><!--]--><!----><!----></div><!----><!--]--><!--]--><!----><!----></div><!----><!--]--><!--]--></div><!----></div><!--]--></h3></div><!--]--> <!--[0--><div class="p-2.5 pt-0 flex flex-col gap-5"><div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_minmax(22rem,0.95fr)] gap-2.5 items-stretch min-w-0"><div class="flex flex-col gap-4 text-sm leading-4 min-w-0"><div class="text-sm"><p class="leading-6"><!--[0--><span class="gb-wrap-text text-sm leading-6 min-w-0 wrap-break-word"><!--[0--><!----><span style="color: #FFD780;">通常攻撃</span><br/>剣による最大5段の連続攻撃を行う。<br/><br/><span style="color: #FFD780;">重撃</span><br/>一定のスタミナを消費し、前方にまばゆい斬撃を放つ。<br/><br/><span style="color: #FFD780;">落下攻撃</span><br/>空中から落下し地面に衝撃を与える。経路上の敵を攻撃し、落下時に範囲ダメージを与える。<!----><!--]--></span> <!--[-1--><!--]--><!--]--><!----></p></div></div> <!--[0--><div class="flex min-w-0 flex-col gap-2.5"><div class="min-w-0 overflow-x-auto"><div class="flex h-full flex-col gap-2.5 p-2.5 border border-white min-w-0 w-full" style="container-type: inline-size;"><div class="flex items-center justify-between gap-4 flex-wrap"><h3 class="text-sm leading-5 font-extrabold uppercase flex items-center gap-2.5 text-white">Skill Attributes</h3></div> <!--[0--><div class="overflow-x-auto min-w-0 w-full"><table class="table-auto min-w-full cursor-default text-sm leading-5"><thead><tr class="bg-gi-cryo text-section-body"><th scope="col" class="p-2.5 text-left text-sm font-semibold align-middle">Attribute</th><th scope="col" class="p-2.5 text-right text-sm font-semibold whitespace-nowrap align-middle">Value</th></tr></thead><tbody><!--[--><tr class="bg-section-body"><td class="text-left font-extrabold p-2.5 align-top min-w-44">1段ダメージ</td><td class="p-2.5 text-right whitespace-nowrap"><!--[0--><!--[-1--><!--[--><!--[-1--><!--[--><!--[0--><!--[-1--><!--[-1--><!--]--><!--[-1--><span class="inline-block inline-flex cursor-pointer"><!---->102.5%<!----></span><!--]--><!--]--><!--]--><!--]--><!--]--><!--]--><!--]--><!--]--></td></tr><tr class="bg-section-header">