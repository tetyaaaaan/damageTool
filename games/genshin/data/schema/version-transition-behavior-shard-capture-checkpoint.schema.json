{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "genshin-version-transition-behavior-shard-capture-checkpoint.schema.json",
  "title": "Genshin version-transition behavior shard capture checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "transitionId", "shardId", "status", "revisions", "materializedSnapshot", "nextTask", "gateEligibility", "claim", "fieldDigestAlgorithm", "fieldDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "genshinVersionTransitionBehaviorShardCaptureCheckpoint" },
    "generatedAt": { "type": "string" },
    "transitionId": { "const": "genshin:6.7->7.0" },
    "shardId": { "type": "string", "pattern": "^behavior:behaviorSpec:semanticDecisionRequired:standard:[0-9]{2}$" },
    "status": { "const": "complete" },
    "authoritativeCandidateCount": { "type": "integer", "minimum": 1 },
    "requestedEntityCount": { "type": "integer", "minimum": 1 },
    "capturedEntityCount": { "type": "integer", "minimum": 1 },
    "skippedOverlapEntityCount": { "type": "integer", "minimum": 0 },
    "revisions": {
      "type": "object",
      "required": ["before", "after"],
      "properties": {
        "before": { "$ref": "#/$defs/revisionProgress" },
        "after": { "$ref": "#/$defs/revisionProgress" }
      }
    },
    "materializedSnapshot": {
      "type": "object",
      "required": ["path", "fieldDigest", "entityCount", "recordCount", "changedRecordCount", "changedFieldCount"],
      "properties": {
        "path": { "type": "string" },
        "fieldDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "entityCount": { "type": "integer", "minimum": 0 },
        "recordCount": { "type": "integer", "minimum": 0 },
        "changedRecordCount": { "type": "integer", "minimum": 0 },
        "changedFieldCount": { "type": "integer", "minimum": 0 }
      }
    },
    "nextTask": { "type": "string", "minLength": 1 },
    "gateEligibility": {
      "type": "object",
      "required": ["sourceFamilyCount", "canIssueEligibilityCertificate", "canPromoteCanonical"],
      "properties": {
        "sourceFamilyCount": { "const": 1 },
        "canIssueEligibilityCertificate": { "const": false },
        "canPromoteCanonical": { "const": false }
      }
    },
    "claim": { "type": "object" },
    "fieldDigestAlgorithm": { "const": "sha256-stable-json-v1" },
    "fieldDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "revisionProgress": {
      "type": "object",
      "required": ["gameVersion", "revision", "status", "completedEntityIds", "completedArtifactCount"],
      "properties": {
        "gameVersion": { "enum": ["6.7", "7.0"] },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "status": { "const": "complete" },
        "completedEntityIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "completedArtifactCount": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
