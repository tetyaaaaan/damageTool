{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "genshin-upstream-version-head.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "evidenceId", "observedGameVersion", "capturedAt", "evidence", "scope", "invalidationConditions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "genshinUpstreamVersionHead" },
    "evidenceId": { "type": "string", "minLength": 1 },
    "observedGameVersion": { "type": "string", "pattern": "^\\d+(?:\\.\\d+)*$" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "providerFamily", "postId", "url", "apiUrl", "rawApiResponseDigest", "rawApiResponseBytes", "claim", "fieldDigest"],
      "properties": {
        "kind": { "const": "officialReleaseNotes" },
        "provider": { "type": "string", "minLength": 1 },
        "providerFamily": { "const": "official-hoyoverse" },
        "postId": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "apiUrl": { "type": "string", "format": "uri" },
        "rawApiResponseDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rawApiResponseBytes": { "type": "integer", "minimum": 1 },
        "claim": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gameVersion", "subject", "explicitText", "publishedAt", "releaseAt"],
          "properties": {
            "gameVersion": { "type": "string" },
            "subject": { "type": "string" },
            "explicitText": { "type": "string" },
            "publishedAt": { "type": "string", "format": "date-time" },
            "releaseAt": { "type": "string", "format": "date-time" }
          }
        },
        "fieldDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "scope": { "type": "string", "minLength": 1 },
    "invalidationConditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
