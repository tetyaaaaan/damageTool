{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "genshin-version-transition-behavior-shard-14-capture-checkpoint.schema.json",
  "title": "Genshin version transition behavior shard 14 capture checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generatedAt", "transitionId", "shardId", "status", "authoritativeCandidateCount", "requestedEntityCount", "capturedEntityCount", "skippedOverlapEntityCount", "ambiguousEntityCount", "revisions", "materializedSnapshot", "nextTask", "gateEligibility", "claim", "fieldDigestAlgorithm", "fieldDigest"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "genshinVersionTransitionBehaviorShardCaptureCheckpoint" }, "generatedAt": { "type": "string", "format": "date-time" }, "transitionId": { "const": "genshin:6.7->7.0" }, "shardId": { "const": "behavior:behaviorSpec:semanticDecisionRequired:standard:14" }, "status": { "const": "blockedByIdentityAmbiguity" }, "authoritativeCandidateCount": { "const": 100 }, "requestedEntityCount": { "const": 8 }, "capturedEntityCount": { "const": 6 }, "skippedOverlapEntityCount": { "const": 1 }, "ambiguousEntityCount": { "const": 1 },
    "revisions": { "type": "object", "additionalProperties": false, "required": ["before", "after"], "properties": { "before": { "$ref": "#/$defs/progress" }, "after": { "$ref": "#/$defs/progress" } } },
    "materializedSnapshot": { "type": "object", "additionalProperties": false, "required": ["path", "fieldDigest", "entityCount", "recordCount", "changedRecordCount", "changedFieldCount"], "properties": { "path": { "type": "string", "minLength": 1 }, "fieldDigest": { "$ref": "#/$defs/sha256" }, "entityCount": { "const": 6 }, "recordCount": { "const": 12 }, "changedRecordCount": { "type": "integer", "minimum": 0 }, "changedFieldCount": { "type": "integer", "minimum": 0 } } }, "nextTask": { "type": "string", "minLength": 1 }, "gateEligibility": { "type": "object", "required": ["sourceFamilyCount", "canIssueEligibilityCertificate", "canPromoteCanonical"], "properties": { "sourceFamilyCount": { "const": 1 }, "canIssueEligibilityCertificate": { "const": false }, "canPromoteCanonical": { "const": false } } },
    "claim": { "type": "object", "required": ["queueShardId", "queuePath", "authoritativeCandidateIdsDigest", "authoritativeEntityIdsDigest", "requestedEntityIds", "capturedEntityIds", "skippedOverlapEntityIds", "ambiguousEntityIds", "materializedSnapshotPath", "materializedSnapshotFieldDigest", "sourceNamespace", "identityResolutionStatus", "sourceFamilyCount", "canIssueEligibilityCertificate", "canPromoteCanonical"], "properties": { "queueShardId": { "const": "behavior:behaviorSpec:semanticDecisionRequired:standard:14" }, "queuePath": { "type": "string" }, "authoritativeCandidateIdsDigest": { "$ref": "#/$defs/sha256" }, "authoritativeEntityIdsDigest": { "$ref": "#/$defs/sha256" }, "requestedEntityIds": { "const": ["10000115", "10000116", "10000119", "10000120", "10000121", "10000122", "10000123", "10000124"] }, "capturedEntityIds": { "const": ["10000116", "10000119", "10000120", "10000121", "10000122", "10000123"] }, "skippedOverlapEntityIds": { "const": ["10000115"] }, "ambiguousEntityIds": { "const": ["10000124"] }, "materializedSnapshotPath": { "type": "string" }, "materializedSnapshotFieldDigest": { "$ref": "#/$defs/sha256" }, "sourceNamespace": { "const": "genshin-db-behavior-shard14" }, "identityResolutionStatus": { "type": "string" }, "sourceFamilyCount": { "const": 1 }, "canIssueEligibilityCertificate": { "const": false }, "canPromoteCanonical": { "const": false } } }, "fieldDigestAlgorithm": { "const": "sha256-stable-json-v1" }, "fieldDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "progress": { "type": "object", "additionalProperties": false, "required": ["gameVersion", "revision", "status", "completedEntityIds", "completedArtifactCount", "ambiguousEntityIds"], "properties": { "gameVersion": { "enum": ["6.7", "7.0"] }, "revision": { "$ref": "#/$defs/revision" }, "status": { "const": "complete" }, "completedEntityIds": { "const": ["10000116", "10000119", "10000120", "10000121", "10000122", "10000123"] }, "completedArtifactCount": { "const": 12 }, "ambiguousEntityIds": { "const": ["10000124"] } } } }
}
