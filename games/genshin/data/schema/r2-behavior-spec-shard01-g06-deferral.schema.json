{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "r2-behavior-spec-shard01-g06-deferral.schema.json",
  "title": "Genshin r2 behaviorSpec shard01 persisted-provider G06 deferral draft",
  "description": "Candidate-scoped draft-only evidence waits. The finite frontier is limited to persisted provider artifacts; this schema never grants verification or promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "policyId", "transitionId", "fromGameVersion", "targetGameVersion", "status", "draftOnly", "generatedAt", "generator", "scope", "queueObservation", "frontier", "evidence", "decisions", "summary", "gate", "policy", "validation", "fieldDigestAlgorithm", "fieldDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "genshinR2BehaviorSpecShard01G06Deferral" },
    "policyId": { "const": "genshin-goal-2026-08-28-r2" },
    "transitionId": { "const": "genshin:6.7->7.0" },
    "fromGameVersion": { "const": "6.7" },
    "targetGameVersion": { "const": "7.0" },
    "status": { "const": "draft" },
    "draftOnly": { "const": true },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generator": { "$ref": "#/$defs/generator" },
    "scope": { "$ref": "#/$defs/scope" },
    "queueObservation": { "$ref": "#/$defs/queueObservation" },
    "frontier": { "$ref": "#/$defs/frontier" },
    "evidence": { "type": "object", "additionalProperties": true, "required": ["sourceAudit", "providerSurface", "candidateEvidence", "candidateFieldEvidenceCandidateCount", "candidateFieldEvidenceClaimCount", "independentVersionBoundFieldEvidenceClaimCount", "rawIntegrityVerifiedCandidateCount", "rawIntegrityGapCandidateCount", "sourceRefs"] },
    "decisions": { "type": "array", "minItems": 100, "maxItems": 100, "items": { "$ref": "#/$defs/decision" } },
    "summary": { "$ref": "#/$defs/summary" },
    "gate": { "$ref": "#/$defs/gate" },
    "policy": { "type": "object", "additionalProperties": true, "required": ["candidateScopedFrontierRequired", "persistedProviderSurfaceOnly", "futureProviderSurfaceRemainsOpen", "providerIndependenceRequired", "explicitGameVersionBindingRequired", "completeCandidateClaimCoverageRequired", "proseInference", "tokenMatching", "sameUpstreamDoubleCount", "strictVerification", "queueMutation", "runtimeOrCanonicalMutation"] },
    "validation": { "$ref": "#/$defs/validation" },
    "fieldDigestAlgorithm": { "const": "sha256-stable-json-v1" },
    "fieldDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generator": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": { "name": { "const": "genshinR2BehaviorSpecShard01G06Deferral.cjs" }, "version": { "const": "genshinR2BehaviorSpecShard01G06Deferral/1" } }
    },
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/digest" } }
    },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["shardId", "layer", "candidateCount", "candidateIds", "candidateIdDigest", "externalClaimFields", "candidateSelection", "frontierId"],
      "properties": {
        "shardId": { "const": "behavior:behaviorSpec:semanticDecisionRequired:standard:01" },
        "layer": { "const": "behaviorSpec" },
        "candidateCount": { "const": 100 },
        "candidateIds": { "type": "array", "minItems": 100, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "candidateIdDigest": { "$ref": "#/$defs/digest" },
        "externalClaimFields": { "const": ["sourceText", "timing", "execution", "lifecycle", "energy", "snapshot"] },
        "candidateSelection": { "type": "string", "minLength": 1 },
        "frontierId": { "const": "genshin-7.0-behavior-spec-shard01-persisted-provider-frontier" }
      }
    },
    "queueObservation": {
      "type": "object", "additionalProperties": false, "required": ["path", "bytes", "rawSha256", "taskCount", "note"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "bytes": { "type": "integer", "minimum": 0 }, "rawSha256": { "$ref": "#/$defs/digest" }, "taskCount": { "const": 100 }, "note": { "type": "string", "minLength": 1 } }
    },
    "frontier": {
      "type": "object", "additionalProperties": false, "required": ["id", "status", "finite", "scopeUnit", "shardId", "transitionId", "targetGameVersion", "candidateCount", "candidateIds", "candidateIdDigest", "claimFields", "externalClaimFields", "searchScope", "lastSearchedAt", "providersExamined", "providerCount", "exactCandidateFieldEvidenceCount", "independentVersionBoundFieldEvidenceCount", "negativeResult", "unsearchedScope", "reopenTrigger", "evidenceRefs", "sourceAuditDigest", "digest"],
      "properties": {
        "id": { "const": "genshin-7.0-behavior-spec-shard01-persisted-provider-frontier" },
        "status": { "const": "searchExhausted" },
        "finite": { "const": true },
        "scopeUnit": { "const": "candidate×claim" },
        "shardId": { "const": "behavior:behaviorSpec:semanticDecisionRequired:standard:01" },
        "transitionId": { "const": "genshin:6.7->7.0" },
        "targetGameVersion": { "const": "7.0" },
        "candidateCount": { "const": 100 },
        "candidateIds": { "type": "array", "minItems": 100, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "candidateIdDigest": { "$ref": "#/$defs/digest" },
        "claimFields": { "const": ["sourceText", "timing", "execution", "lifecycle", "energy", "snapshot", "runtime"] },
        "externalClaimFields": { "const": ["sourceText", "timing", "execution", "lifecycle", "energy", "snapshot"] },
        "searchScope": { "type": "string", "minLength": 1 },
        "lastSearchedAt": { "type": "string", "format": "date" },
        "providersExamined": { "type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "providerCount": { "const": 9 },
        "exactCandidateFieldEvidenceCount": { "const": 0 },
        "independentVersionBoundFieldEvidenceCount": { "const": 0 },
        "negativeResult": { "type": "string", "minLength": 1 },
        "unsearchedScope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "reopenTrigger": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } },
        "sourceAuditDigest": { "$ref": "#/$defs/digest" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "fieldFinding": {
      "type": "object", "additionalProperties": true, "required": ["field", "knownStatus", "currentValue", "historicalValue", "missingEvidence", "candidateFieldValueMaterialized", "strictVerified", "certificateEligible"],
      "properties": { "field": { "type": "string", "pattern": "^claim\\.(sourceText|timing|execution|lifecycle|energy|snapshot)$" }, "knownStatus": { "const": "unknown" }, "currentValue": { "type": ["number", "string", "boolean", "object", "array", "null"] }, "historicalValue": { "type": "null" }, "missingEvidence": { "type": "string", "minLength": 1 }, "candidateFieldValueMaterialized": { "const": false }, "strictVerified": { "const": false }, "certificateEligible": { "const": false } }
    },
    "decision": {
      "type": "object", "additionalProperties": true, "required": ["id", "kind", "policyId", "candidateId", "targetGameVersion", "queueTaskDigest", "assessment", "fieldFindings", "search", "safety", "draftDisposition"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "kind": { "const": "genshinEvidenceDeferral" }, "policyId": { "const": "genshin-goal-2026-08-28-r2" }, "candidateId": { "type": "string", "minLength": 1 }, "targetGameVersion": { "const": "7.0" }, "queueTaskDigest": { "$ref": "#/$defs/digest" },
        "assessment": { "type": "object", "additionalProperties": true, "required": ["actorId", "assessedAt", "reason", "boundedScope"], "properties": { "actorId": { "const": "luna_worker" }, "assessedAt": { "type": "string", "format": "date-time" }, "reason": { "type": "string", "minLength": 1 }, "boundedScope": { "type": "object", "additionalProperties": true, "required": ["candidateId", "taskId", "remainingSearches", "notExecutableReasons", "artifactRefs", "deferredLaneDispositions"] } } },
        "fieldFindings": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/fieldFinding" } },
        "search": { "type": "object", "additionalProperties": true, "required": ["scope", "lastSearchedAt", "providersExamined", "negativeResult", "unsearchedScope", "reopenTrigger", "nextTask", "artifactRefs"] },
        "safety": { "type": "object", "additionalProperties": true, "required": ["impact", "action", "runtimeStatus", "artifactRefs"] },
        "draftDisposition": { "type": "object", "additionalProperties": false, "required": ["status", "evidenceDeferred", "workClosed", "strictVerified", "certificateEligible", "canonicalPromotionEligible", "queueMutation"], "properties": { "status": { "const": "externalEvidenceWait" }, "evidenceDeferred": { "const": true }, "workClosed": { "const": false }, "strictVerified": { "const": false }, "certificateEligible": { "const": false }, "canonicalPromotionEligible": { "const": false }, "queueMutation": { "const": "none" } } }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": true, "required": ["candidateCount", "entityCount", "claimCount", "externalClaimCount", "internalClaimCount", "candidateScopedFrontierProvenCandidateCount", "finiteFrontierStatus", "evidenceDeferredDraftCandidateCount", "candidateFieldEvidenceCandidateCount", "candidateFieldEvidenceClaimCount", "strictVerifiedCandidateCount", "certificateEligibleClaimCount", "canonicalPromotionEligibleCandidateCount", "providerCount", "providerExactCandidateFieldHitCount", "unsearchedExternalRemainderCandidateCount", "queueMutated"],
      "properties": { "candidateCount": { "const": 100 }, "entityCount": { "const": 8 }, "claimCount": { "const": 700 }, "externalClaimCount": { "const": 600 }, "internalClaimCount": { "const": 100 }, "candidateScopedFrontierProvenCandidateCount": { "const": 100 }, "finiteFrontierStatus": { "const": "searchExhaustedForPersistedProviderSurface" }, "evidenceDeferredDraftCandidateCount": { "const": 100 }, "candidateFieldEvidenceCandidateCount": { "const": 0 }, "candidateFieldEvidenceClaimCount": { "const": 0 }, "strictVerifiedCandidateCount": { "const": 0 }, "certificateEligibleClaimCount": { "const": 0 }, "canonicalPromotionEligibleCandidateCount": { "const": 0 }, "providerCount": { "const": 9 }, "providerExactCandidateFieldHitCount": { "const": 0 }, "unsearchedExternalRemainderCandidateCount": { "const": 100 }, "queueMutated": { "const": false } }
    },
    "gate": {
      "type": "object", "additionalProperties": true, "required": ["draftEligibleForEvidenceWait", "canIssueEligibilityCertificate", "canPromoteCanonical", "verificationGranted", "promotionGranted", "runtimeChanged", "certificateIssued", "queueChanged", "reason"],
      "properties": { "draftEligibleForEvidenceWait": { "const": true }, "canIssueEligibilityCertificate": { "const": false }, "canPromoteCanonical": { "const": false }, "verificationGranted": { "const": false }, "promotionGranted": { "const": false }, "runtimeChanged": { "const": false }, "certificateIssued": { "const": false }, "queueChanged": { "const": false }, "reason": { "type": "string", "minLength": 1 } }
    },
    "validation": {
      "type": "object", "additionalProperties": false, "required": ["valid", "invalidDecisionCount", "decisionResults"],
      "properties": { "valid": { "const": true }, "invalidDecisionCount": { "const": 0 }, "decisionResults": { "type": "array", "minItems": 100, "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["valid", "errors"], "properties": { "valid": { "const": true }, "errors": { "type": "array", "maxItems": 0 } } } } }
    }
  }
}
