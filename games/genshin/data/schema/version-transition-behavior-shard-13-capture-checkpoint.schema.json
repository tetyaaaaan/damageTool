{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "genshin-version-transition-behavior-shard-13-capture-checkpoint.schema.json",
  "title": "Genshin version transition behavior shard 13 capture checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generatedAt", "transitionId", "shardId", "status", "authoritativeCandidateCount", "requestedEntityCount", "capturedEntityCount", "skippedOverlapEntityCount", "revisions", "materializedSnapshot", "nextTask", "gateEligibility", "claim", "fieldDigestAlgorithm", "fieldDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "genshinVersionTransitionBehaviorShardCaptureCheckpoint" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "transitionId": { "const": "genshin:6.7->7.0" },
    "shardId": { "const": "behavior:behaviorSpec:semanticDecisionRequired:standard:13" },
    "status": { "const": "complete" },
    "authoritativeCandidateCount": { "const": 100 },
    "requestedEntityCount": { "const": 8 },
    "capturedEntityCount": { "const": 8 },
    "skippedOverlapEntityCount": { "const": 0 },
    "revisions": { "type": "object", "additionalProperties": false, "required": ["before", "after"], "properties": { "before": { "$ref": "#/$defs/progress" }, "after": { "$ref": "#/$defs/progress" } } },
    "materializedSnapshot": { "type": "object", "additionalProperties": false, "required": ["path", "fieldDigest", "entityCount", "recordCount", "changedRecordCount", "changedFieldCount"], "properties": { "path": { "type": "string", "minLength": 1 }, "fieldDigest": { "$ref": "#/$defs/sha256" }, "entityCount": { "const": 8 }, "recordCount": { "const": 16 }, "changedRecordCount": { "type": "integer", "minimum": 0 }, "changedFieldCount": { "type": "integer", "minimum": 0 } } },
    "nextTask": { "type": "string", "minLength": 1 },
    "gateEligibility": { "type": "object", "required": ["sourceFamilyCount", "canIssueEligibilityCertificate", "canPromoteCanonical"], "properties": { "sourceFamilyCount": { "const": 1 }, "canIssueEligibilityCertificate": { "const": false }, "canPromoteCanonical": { "const": false } } },
    "claim": { "type": "object", "required": ["queueShardId", "queuePath", "authoritativeCandidateIdsDigest", "authoritativeEntityIdsDigest", "requestedEntityIds", "capturedEntityIds", "skippedOverlapEntityIds", "materializedSnapshotPath", "materializedSnapshotFieldDigest", "sourceNamespace", "identityResolutionStatus", "sourceFamilyCount", "canIssueEligibilityCertificate", "canPromoteCanonical"], "properties": { "queueShardId": { "const": "behavior:behaviorSpec:semanticDecisionRequired:standard:13" }, "queuePath": { "type": "string" }, "authoritativeCandidateIdsDigest": { "$ref": "#/$defs/sha256" }, "authoritativeEntityIdsDigest": { "$ref": "#/$defs/sha256" }, "requestedEntityIds": { "const": ["10000108", "10000109", "10000110", "10000111", "10000112", "10000113", "10000114", "10000115"] }, "capturedEntityIds": { "const": ["10000108", "10000109", "10000110", "10000111", "10000112", "10000113", "10000114", "10000115"] }, "skippedOverlapEntityIds": { "const": [] }, "materializedSnapshotPath": { "type": "string" }, "materializedSnapshotFieldDigest": { "$ref": "#/$defs/sha256" }, "sourceNamespace": { "const": "genshin-db-behavior-shard13" }, "identityResolutionStatus": { "type": "string" }, "sourceFamilyCount": { "const": 1 }, "canIssueEligibilityCertificate": { "const": false }, "canPromoteCanonical": { "const": false } } },
    "fieldDigestAlgorithm": { "const": "sha256-stable-json-v1" },
    "fieldDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "progress": { "type": "object", "additionalProperties": false, "required": ["gameVersion", "revision", "status", "completedEntityIds", "completedArtifactCount"], "properties": { "gameVersion": { "enum": ["6.7", "7.0"] }, "revision": { "$ref": "#/$defs/revision" }, "status": { "const": "complete" }, "completedEntityIds": { "const": ["10000108", "10000109", "10000110", "10000111", "10000112", "10000113", "10000114", "10000115"] }, "completedArtifactCount": { "const": 16 } } }
  }
}
