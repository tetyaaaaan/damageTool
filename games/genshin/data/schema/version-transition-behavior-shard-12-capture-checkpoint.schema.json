{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "genshin-version-transition-behavior-shard-12-capture-checkpoint.schema.json",
  "title": "Genshin version transition behavior shard 12 capture checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generatedAt", "transitionId", "shardId", "status", "authoritativeCandidateCount", "requestedEntityCount", "capturedEntityCount", "skippedOverlapEntityCount", "revisions", "materializedSnapshot", "nextTask", "gateEligibility", "claim", "fieldDigestAlgorithm", "fieldDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "genshinVersionTransitionBehaviorShardCaptureCheckpoint" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "transitionId": { "const": "genshin:6.7->7.0" },
    "shardId": { "const": "behavior:behaviorSpec:semanticDecisionRequired:standard:12" },
    "status": { "const": "complete" },
    "authoritativeCandidateCount": { "const": 100 },
    "requestedEntityCount": { "const": 8 },
    "capturedEntityCount": { "const": 7 },
    "skippedOverlapEntityCount": { "const": 1 },
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": { "$ref": "#/$defs/progress" },
        "after": { "$ref": "#/$defs/progress" }
      }
    },
    "materializedSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fieldDigest", "entityCount", "recordCount", "changedRecordCount", "changedFieldCount"],
      "properties": {
        "path": { "const": "games/genshin/data/v2/version-transitions/6.7-to-7.0/behavior-shard-12-snapshot.json" },
        "fieldDigest": { "$ref": "#/$defs/sha256" },
        "entityCount": { "const": 7 },
        "recordCount": { "const": 14 },
        "changedRecordCount": { "type": "integer", "minimum": 0 },
        "changedFieldCount": { "type": "integer", "minimum": 0 }
      }
    },
    "nextTask": { "type": "string", "minLength": 1 },
    "gateEligibility": {
      "type": "object",
      "required": ["sourceFamilyCount", "canIssueEligibilityCertificate", "canPromoteCanonical"],
      "properties": {
        "sourceFamilyCount": { "const": 1 },
        "canIssueEligibilityCertificate": { "const": false },
        "canPromoteCanonical": { "const": false }
      }
    },
    "claim": {
      "type": "object",
      "required": ["queueShardId", "queuePath", "authoritativeCandidateIdsDigest", "authoritativeEntityIdsDigest", "requestedEntityIds", "capturedEntityIds", "skippedOverlapEntityIds", "materializedSnapshotPath", "materializedSnapshotFieldDigest", "sourceNamespace", "identityResolutionStatus", "sourceFamilyCount", "canIssueEligibilityCertificate", "canPromoteCanonical"],
      "properties": {
        "queueShardId": { "const": "behavior:behaviorSpec:semanticDecisionRequired:standard:12" },
        "queuePath": { "const": "reports/genshin-evidence-task-queue.json" },
        "authoritativeCandidateIdsDigest": { "const": "615ba09b1142eb23bfaa8cf863a971383a2a70ab8ccfba63d30576c1d7ddaf44" },
        "authoritativeEntityIdsDigest": { "const": "c4fc2a2d61ff85d973805170ae091971891413b4b2bb72ef095e377733a8cdab" },
        "requestedEntityIds": { "const": ["10000101", "10000102", "10000103", "10000104", "10000105", "10000106", "10000107", "10000108"] },
        "capturedEntityIds": { "const": ["10000102", "10000103", "10000104", "10000105", "10000106", "10000107", "10000108"] },
        "skippedOverlapEntityIds": { "const": ["10000101"] },
        "materializedSnapshotPath": { "const": "games/genshin/data/v2/version-transitions/6.7-to-7.0/behavior-shard-12-snapshot.json" },
        "materializedSnapshotFieldDigest": { "$ref": "#/$defs/sha256" },
        "sourceNamespace": { "const": "genshin-db-behavior-shard12" },
        "identityResolutionStatus": { "const": "localCatalogProviderIdentityResolved" },
        "sourceFamilyCount": { "const": 1 },
        "canIssueEligibilityCertificate": { "const": false },
        "canPromoteCanonical": { "const": false }
      }
    },
    "fieldDigestAlgorithm": { "const": "sha256-stable-json-v1" },
    "fieldDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameVersion", "revision", "status", "completedEntityIds", "completedArtifactCount"],
      "properties": {
        "gameVersion": { "enum": ["6.7", "7.0"] },
        "revision": { "$ref": "#/$defs/revision" },
        "status": { "const": "complete" },
        "completedEntityIds": { "const": ["10000102", "10000103", "10000104", "10000105", "10000106", "10000107", "10000108"] },
        "completedArtifactCount": { "const": 14 }
      }
    }
  }
}
