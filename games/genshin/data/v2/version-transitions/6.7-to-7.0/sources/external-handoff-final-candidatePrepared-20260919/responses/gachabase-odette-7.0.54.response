aximum_level:60,stat_additions:[{stat_id:1,value:2302.8767},{stat_id:7,value:139.6224},{stat_id:4,value:59.40214},{stat_id:22,value:.192}],upgrade_costs:[{item_id:104162,amount:6},{item_id:113090,amount:4},{item_id:101275,amount:20},{item_id:112147,amount:12},{item_id:202,amount:60000}]},{level:4,maximum_level:70,stat_additions:[{stat_id:1,value:2918.497},{stat_id:7,value:176.9472},{stat_id:4,value:75.28192},{stat_id:22,value:.192}],upgrade_costs:[{item_id:104163,amount:3},{item_id:113090,amount:8},{item_id:101275,amount:30},{item_id:112147,amount:18},{item_id:202,amount:80000}]},{level:5,maximum_level:80,stat_additions:[{stat_id:1,value:3534.1177},{stat_id:7,value:214.272},{stat_id:4,value:91.1617},{stat_id:22,value:.288}],upgrade_costs:[{item_id:104163,amount:6},{item_id:113090,amount:12},{item_id:101275,amount:45},{item_id:112148,amount:12},{item_id:202,amount:100000}]},{level:6,maximum_level:90,stat_additions:[{stat_id:1,value:4149.7383},{stat_id:7,value:251.5968},{stat_id:4,value:107.04148},{stat_id:22,value:.384}],upgrade_costs:[{item_id:104164,amount:6},{item_id:113090,amount:20},{item_id:101275,amount:60},{item_id:112148,amount:24},{item_id:202,amount:120000}]}],constellations:[{id:1501,depot_id:15001,name:{key:"506551577",text:"「踊らぬ朝に彼女は 己の影を見つめる」",override:null},description:{key:"3311011959",text:"特殊な元素スキル{LINK#N11500002}\u003Ccolor=#FFD780FF>柔き払暁のコーダ\u003C/color>{/LINK}の発動後、踊りが終わると、オデットは周囲の敵に\u003Ccolor=#99FFFFFF>氷元素範囲ダメージ\u003C/color>を追加で1回与える。このダメージは下記の通りとなる。\\n・\u003Ccolor=#FFD780FF>輝映・星電導\u003C/color>とみなされる場合、または輝映状態にない場合、オデットの攻撃力の300%に相当する星電導反応ダメージとなる。\\n・\u003Ccolor=#FFD780FF>輝映・星拡散\u003C/color>とみなされる場合、オデットの攻撃力の450%に相当する星拡散反応ダメージとなる。\\n\\nさらに、固有天賦「選ばれし者の祝祭」が強化される。{LINK#N11500001}\u003Ccolor=#FFD780FF>独舞者のシルエット\u003C/color>{/LINK}を生成する時、オデットは{LINK#N11500003}\u003Ccolor=#FFD780FF>春の華\u003C/color>{/LINK}を追加で2層獲得し、オデットが待機中の場合、\u003Ccolor=#FFD780FF>春の華\u003C/color>をクリアする速度が毎秒2層に上昇する。",override:null},description_tooltip_ids:[11500002,11500001,11500003],buffed_description:null,buffed_description_tooltip_ids:[],icon_path_hash:"1387479322476826027",parameters:[2,2,4,3,4.5]},{id:1502,depot_id:15001,name:{key:"3180445905",text:"「雪鳥の見ぬ夢を只 見届けたいだけで」",override:null},description:{key:"2840799639",text:"固有天賦「選ばれし者の祝祭」が強化される。{LINK#N11500003}\u003Ccolor=#FFD780FF>春の華\u003C/color>{/LINK}1層につき、さらにキャラクターの攻撃力が7%アップする。\\nまた、{LINK#N11500001}\u003Ccolor=#FFD780FF>独舞者のシルエット\u003C/color>{/LINK}が存在する時、オデットが{LINK#N11500004}\u003Ccolor=#FFD780FF>輝映・星閃\u003C/color>{/LINK}状態の場合、\u003Ccolor=#FFD780FF>独舞者のシルエット\u003C/color>付近の敵の対応する元素耐性がさらに20%ダウンする。\\n・\u003Ccolor=#FFD780FF>輝映・星電導\u003C/color>：\u003Ccolor=#99FFFFFF>氷元素\u003C/color>、\u003Ccolor=#FFACFFFF>雷元素\u003C/color>。\\n・\u003Ccolor=#FFD780FF>輝映・星拡散\u003C/color>：\u003Ccolor=#99FFFFFF>氷元素\u003C/color>、\u003Ccolor=#80FFD7FF>風元素\u003C/color>。",override:null},description_tooltip_ids:[11500003,11500004,11500001],buffed_description:null,buffed_description_tooltip_ids:[],icon_path_hash:"17988216312721515086",parameters:[.07,.2]},{id:1503,depot_id:15001,name:{key:"645006425",text:"「荒れ狂う風を追い ひとり高みへ昇る」",override:null},description:{key:"882400383",text:"元素スキル\u003Ccolor=#FFD780FF>{LINK#S11502}柔きファントムの夜の舞{/LINK}\u003C/color>のスキルLv.+3。\\n最大Lv.15まで。",override:null},description_tooltip_ids:[],buffed_description:null,buffed_description_tooltip_ids:[],icon_path_hash:"9151787039196111838",parameters:[]},{id:1504,depot_id:15001,name:{key:"3514552353",text:"「燃ゆる青空の中へ 恍惚と堕ちていく」",override:null},description:{key:"2344606007",text:"元素爆発\u003Ccolor=#FFD780FF>疾きブルーバードの夢\u003C/color>が強化される。オデットが\u003Ccolor=#FFD780FF>雪鳥の夢\u003C/color>を獲得した時、付近にいるチーム内の他のキャラクターが与える星反応ダメージがさらにアップする。ダメージアップ量は\u003Ccolor=#FFD780FF>雪鳥の夢\u003C/color>の効果の50%分に相当する。\\n\\nまた、チーム内のキャラクターが敵に星反応ダメージを与えた時、オデットは敵に対して追加攻撃を1回行い、\u003Ccolor=#99FFFFFF>氷元素範囲ダメージ\u003C/color>を1回与える。3.5秒毎に1回のみ発動可能。詳細はそれぞれ、以下の通り。\\n・ダメージが\u003Ccolor=#FFD780FF>輝映・星電導\u003C/color>とみなされる場合、または輝映状態でない場合、オデットの攻撃力の66%分の星電導反応ダメージを与える。\\n・ダメージが\u003Ccolor=#FFD780FF>輝映・星拡散\u003C/color>とみなされる場合、オデットの攻撃力の99%分の星拡散反応ダメージを与える。",override:null},description_tooltip_ids:[],buffed_description:null,buffed_description_tooltip_ids:[],icon_path_hash:"746006444965149696",parameters:[.66,.99,3.5,.5]},{id:1505,depot_id:15001,name:{key:"3101692001",text:"「見よ——塵と土の 痛みと別れる時を」",override:null},description:{key:"4043656263",text:"元素爆発\u003Ccolor=#FFD780FF>{LINK#S11505}疾きブルーバードの夢{/LINK}\u003C/color>のスキルLv.+3。\\n最大Lv.15まで。",override:null},description_tooltip_ids:[],buffed_description:null,buffed_description_tooltip_ids:[],icon_path_hash:"6245077189103867127",parameters:[]},{id:1506,depot_id:15001,name:{key:"4200065385",text:"「さあ手を伸ばして 永遠の空に触れて」",override:null},description:{key:"2445198519",text:"固有天賦「選ばれし者の祝祭」が強化される。オデットが周囲のチーム全員に{LINK#N11500003}\u003Ccolor=#FFD780FF>春の華\u003C/color>{/LINK}を付与する時、自身の春の華は減少しなくなる。\\nまた、\u003Ccolor=#FFD780FF>春の華\u003C/color>の影響下にあるキャラクターは、敵に与える星反応ダメージが25%{LINK#N11190007}\u003Ccolor=#FFD780FF>向上\u003C/color>{/LINK}し、オデットが敵に与える星反応ダメージが追加で20%向上する。",override:null},description_tooltip_ids:[11500003,11190007],buffed_description:null,buffed_description_tooltip_ids:[],icon_path_hash:"90063621133016508",parameters:[.25,.2]}],talents:[{id:11501,depot_id:15001,name:{key:"3863914893",text:"雪鳥のヴァリエーション",override:null},description:{key:"3340244208",text:"\u003Ccolor=#FFD780FF>通常攻撃\u003C/color>\\n剣による最大5段の連続攻撃を行う。\\n\\n\u003Ccolor=#FFD780FF>重撃\u003C/color>\\n一定のスタミナを消費し、前方にまばゆい斬撃を放つ。\\n\\n\u003Ccolor=#FFD780FF>落下攻撃\u003C/color>\\n空中から落下し地面に衝撃を与える。経路上の敵を攻撃し、落下時に範囲ダメージを与える。",override:null},description_tooltip_ids:[],buffed_description:null,buffed_description_tooltip_ids:[],icon_path_hash:"15664253407751301348",levels:[{level:1,descriptions:a,parameters:b,id:0,skill_id:1503101,upgrade_costs:[]},{level:2,descriptions:c,parameters:d,id:0,skill_id:1503102,upgrade_costs:[{item_id:104365,amount:3},{item_id:112146,amount:6},{item_id:202,amount:12500}]},{level:3,descriptions:e,parameters:f,id:0,skill_id:1503103,upgrade_costs:[{item_id:104366,amount:2},{item_id:112147,amount:3},{item_id:202,amount:17500}]},{level:4,descriptions:g,parameters:h,id:0,skill_id:1503104,upgrade_costs:[{item_id:104366,amount:4},{item_id:112147,amount:4},{item_id:202,amount:25000}]},{level:5,descriptions:i,parameters:j,id:0,skill_id:1503105,upgrade_costs:[{item_id:104366,amount:6},{item_id:112147,amount:6},{item_id:202,amount:30000}]},{level:6,descriptions:k,parameters:l,id:0,skill_id:1503106,upgrade_costs:[{item_id:104366,amount:9},{item_id:112147,amount:9},{item_id:202,amount:37500}]},{level:7,descriptions:m,parameters:n,id:0,skill_id:1503107,upgrade_costs:[{item_id:104367,amount:4},{item_id:112148,amount:4},{item_id:113088,amount:1},{item_id:202,amount:120000}]},{level:8,descriptions:o,parameters:p,id:0,skill_id:1503108,upgrade_costs:[{item_id:104367,amount:6},{item_id:112148,amount:6},{item_id:113088,amount:1},{item_id:202,amount:260000}]},{level:9,descriptions:q,parameters:r,id:0,skill_id:1503109,upgrade_costs:[{item_id:104367,amount:12},{item_id:112148,amount:9},{item_id:113088,amount:2},{item_id:202,amount:450000}]},{level:10,descriptions:s,parameters:t,id:0,skill_id:1503110,upgrade_costs:[{item_id:104367,amount:16},{item_id:112148,amount:12},{item_id:113088,amount:2},{item_id:104319,amount:1},{item_id:202,amount:700000}]},{level:11,descriptions:u,parameters:v,id:0,skill_id:1503111,upgrade_costs:[]},{level:12,descriptions:w,parameters:x,id:0,skill_id:1503112,upgrade_costs:[]},{level:13,descriptions:y,parameters:z,id:0,skill_id:1503113,upgrade_costs:[]},{level:14,descriptions:A,parameters:B,id:0,skill_id:1503114,upgrade_costs:[]},{level:15,descriptions:C,parameters:D,id:0,skill_id:1503115,upgrade_costs:[]}],attributes:[{level:1,descriptions:a,parameters:b},{level:2,descriptions:c,parameters:d},{level:3,descriptions:e,parameters:f},{level:4,descriptions:g,parameters:h},{level:5,descriptions:i,parameters:j},{level:6,descriptions:k,parameters:l},{level:7,descriptions:m,parameters:n},{level:8,descriptions:o,parameters:p},{level:9,descriptions:q,parameters:r},{level:10,descriptions:s,parameters:t},{level:11,descriptions:u,parameters:v},{level:12,descriptions:w,parameters:x},{level:13,descriptions:y,parameters:z},{level:14,descriptions:A,parameters:B},{level:15,descriptions:C,parameters:D}],upgrade_costs:[{item_id:104365,amount:3},{item_id:112146,amount:6},{item_id:202,amount:1652500},{item_id:104366,amount:21},{item_id:112147,amount:22},{item_id:104367,amount:38},{item_id:112148,amount:31},{item_id:113088,amount:6},{item_id:104319,amount:1}]},{id:11502,depot_id:15001,name:{key:"3993927085",text:"柔きファントムの夜の舞",override:null},description:{key:"4207142936",text:"緩やかなステップで\u003Ccolor=#99FFFFFF>氷元素範囲ダメージ\u003C/color>を与え、自身の{LINK#N11500001}\u003Ccolor=#FFD780FF>独舞者（ソリスト）のシルエット\u003C/color>{/LINK}を召喚する。\\nフィールド上にオデット自身が召喚した\u003Ccolor=#FFD780FF>独舞者のシルエット\u003C/color>がすでに存在する場合は再召喚となり、継続時間がリセットされる。\\n\\n\u003Ccolor=#FFD780FF>独舞者のシルエット\u003C/color>\\n\u003Ccolor=#FFD780FF>プルーム\u003C/color>と\u003Ccolor=#FFD780FF>ウィング\u003C/color>の2種類のステップを交互に踏み、優雅で軽やかな舞いによって一定時間ごとに付近の敵を攻撃し、\u003Ccolor=#99FFFFFF>氷元素範囲ダメージ\u003C/color>を与える。\\nまた、元素スキル\u003Ccolor=#FFD780FF>柔きファントムの夜の舞\u003C/color>を発動した後の6秒間、オデットの元素スキル\u003Ccolor=#FFD780FF>柔きファントムの夜の舞\u003C/color>は特殊な元素スキル{LINK#N11500002}\u003Ccolor=#FFD780FF>柔き払暁のコーダ\u003C/color>{/LINK}{LINK#N11500004}{/LINK}に変化し、共に踊って付近の敵に継続的に\u003Ccolor=#99FFFFFF>氷元素範囲ダメージ\u003C/color>を与える。さらに、踊りの終了時に、星電導または星拡散反応ダメージと見なされる\u003Ccolor=#99FFFFFF>氷元素範囲ダメージ\u003C/color>を1回与える。",override:null},description_tooltip_ids:[11500001,11500002,11500004],buffed_description:null,buffed_description_tooltip_ids:[],icon_path_hash:"6847394198104031388",levels:[{level:1,descriptions:E,parameters:F,id:0,skill_id:1503201,upgrade_costs:[]},{level:2,descriptions:G,parameters:H,id:0,skill_id:1503202,upgrade_costs:[{item_id:104365,amount:3},{item_id:112146,amount:6},{item_id:202,amount:12500}]},{level:3,descriptions:I,parameters:J,id:0,skill_id:1503203,upgrade_costs:[{item_id:104366,amount:2},{item_id:112147,amount:3},{item_id:202,amount:17500}]},{level:4,descriptions:K,parameters:L,id:0,skill_id:1503204,upgrade_costs:[{item_id:104366,amount:4},{item_id:112147,amount:4},{item_id:202,amount:25000}]},{level:5,descriptions:M,parameters:N,id:0,skill_id:1503205,upgrade_costs:[{item_id:104366,amount:6},{item_id:112147,amount:6},{item_id:202,amount:30000}]},{level:6,descriptions:O,parameters:P,id:0,skill_id:1503206,upgrade_costs:[{item_id:104366,amount:9},{item_id:112147,amount:9},{item_id:202,amount:37500}]},{level:7,descriptions:Q,parameters:R,id:0,skill_id:1503207,upgrade_costs:[{item_id:104367,amount:4},{item_id:112148,amount:4},{item_id:113088,amount:1},{item_id:202,amount:120000}]},{level:8,descriptions:S,parameters:T,id:0,skill_id:1503208,upgrade_costs:[{item_id:104367,amount:6},{item_id:112148,amount:6},{item_id:113088,amount:1},{item_id:202,amount:260000}]},{level:9,descriptions:U,parameters:V,id:0,skill_id:1503209,upgrade_costs:[{item_id:104367,amount:12},{item_id:112148,amount:9},{item_id:113088,amount:2},{item_id:202,amount:450000}]},{level:10,descriptions:W,parameters:X,id:0,skill_id:1503210,upgrade_costs:[{item_id:104367,amount:16},{item_id:112148,amount:12},{item_id:113088,amount:2},{item_id:104319,amount:1},{item_id:202,amount:700000}]},{level:11,descriptions:Y,parameters:Z,id:0,skill_id:1503211,upgrade_costs:[]},{level:12,descriptions:_,parameters:$,id:0,skill_id:1503212,upgrade_costs:[]},{level:13,descriptions:aa,parameters:ab,id:0,skill_id:1503213,upgrade_costs:[]},{level:14,descriptions:ac,parameters:ad,id:0,skill_id:1503214,upgrade_costs:[]},{level:15,descriptions:ae,parameters:af,id:0,skill_id:1503215,upgrade_costs:[]}],attributes:[{level:1,descriptions:E,parameters:F},{level:2,descriptions:G,parameters:H},{level:3,descriptions:I,parameters:J},{level:4,descriptions:K,parameters:L},{level:5,descriptions:M,parameters:N},{level:6,descriptions:O,parameters:P},{level:7,descriptions:Q,parameters:R},{level:8,descriptions:S,parameters:T},{level:9,descriptions:U,parameters:V},{level:10,descriptions:W,parameters:X},{level:11,descriptions:Y,parameters:Z},{level:12,descriptions:_,parameters:$},{level:13,descriptions:aa,parameters:ab},{level:14,descriptions:ac,parameters:ad},{level:15,descriptions:ae,parameters:af}],upgrade_costs:[{item_id:104365,amount:3},{item_id:112146,amount:6},{item_id:202,amount:1652500},{item_id:104366,amount:21},{item_id:112147,amount:22},{item_id:104367,amount:38},{item_id:112148,amount:31},{item_id:113088,amount:6},{item_id:104319,amount:1}]},{id:11505,depot_id:15001,name:{key:"3338360085",text:"疾きブルーバードの夢",override:null},description:{key:"2390546936",text:"素早いステップを踏んで複数回の\u003Ccolor=#99FFFFFF>氷元素範囲ダメージ\u003C/color>を与え、自身の{LINK#N11500001}\u003Ccolor=#FFD780FF>独舞者のシルエット\u003C/color>{/LINK}を召喚し、\u003Ccolor=#FFD780FF>雪鳥の夢\u003C/color>効果を獲得する。雪鳥の夢：オデットが与える星反応ダメージをアップする。\\nまた、元素爆発\u003Ccolor=#FFD780FF>疾きブルーバードの夢\u003C/color>を発動した後の6秒間、オデットの元素スキル\u003Ccolor=#FFD780FF>柔きファントムの夜の舞\u003C/color>は、特別な元素スキル{LINK#N11500002}\u003Ccolor=#FFD780FF>柔き払暁のコーダ\u003C/color>{/LINK}{LINK#N11500004}{/LINK}に変わる。\\n\\nすでにフィールド上にオデット自身が作り出した独舞者のシルエットが存在する場合、自身の傍に再生成し、継続時間をリセットする。",override:null},description_tooltip_ids:[11500001,11500002,11500004],buffed_description:null,buffed_description_tooltip_ids:[],icon_path_hash:"12846472216925348440",levels:[{level:1,descriptions:ag,parameters:ah,id:0,skill_id:1503901,upgrade_costs:[]},{level:2,descriptions:ai,parameters:aj,id:0,skill_id:1503902,upgrade_costs:[{item_id:104365,amount:3},{item_id:112146,amount:6},{item_id:202,amount:12500}]},{level:3,descriptions:ak,parameters:al,id:0,skill_id:1503903,upgrade_costs:[{item_id:104366,amount:2},{item_id:112147,amount:3},{item_id:202,amount:17500}]},{level:4,descriptions:am,parameters:an,id:0,skill_id:1503904,upgrade_costs:[{item_id:104366,amount:4},{item_id:112147,amount:4},{item_id:202,amount:25000}]},{level:5,descriptions:ao,parameters:ap,id:0,skill_id:1503905,upgrade_costs:[{item_id:104366,amount:6},{item_id:112147,amount:6},{item_id:202,amount:30000}]},{level:6,descriptions:aq,parameters:ar,id:0,skill_id:1503906,upgrade_costs:[{item_id:104366,amount:9},{item_id:112147,amount:9},{item_id:202,amount:37500}]},{level:7,descriptions:as,parameters:at,id:0,skill_id:1503907,upgrade_costs:[{item_id:104367,amount:4},{item_id:112148,amount:4},{item_id:113088,amount:1},{item_id:202,amount:120000}]},{level:8,descriptions:au,parameters:av,id:0,skill_id:1503908,upgrade_costs:[{item_id:104367,amount:6},{item_id:112148,amount:6},{item_id:113088,amount:1},{item_id:202,amount:260000}]},{level:9,descriptions:aw,parameters:ax,id:0,skill_id:1503909,upgrade_costs:[{item_id:104367,amount:12},{item_id:112148,amount:9},{item_id:113088,amount:2},{item_id:202,amount:450000}]},{level:10,descriptions:ay,parameters:az,id:0,skill_id:1503910,upgrade_costs:[{item_id:104367,amount:16},{item_id:112148,amount:12},{item_id:113088,amount:2},{item_id:104319,amount:1},{item_id:202,amount:700000}]},{level:11,descriptions:aA,parameters:aB,id:0,skill_id:1503911,upgrade_costs:[]},{level:12,descriptions:aC,parameters:aD,id:0,skill_id:1503912,upgrade_costs:[]},{level:13,descriptions:aE,parameters:aF,id:0,skill_id:1503913,upgrade_costs:[]},{level:14,descriptions:aG,parameters:aH,id:0,skill_id:1503914,upgrade_costs:[]},{level:15,descriptions:aI,parameters:aJ,id:0,skill_id:1503915,upgrade_costs:[]}],attributes:[{level:1,descriptions:ag,parameters:ah},{level:2,descriptions:ai,parameters:aj},{level:3,descriptions:ak,parameters:al},{level:4,descriptions:am,parameters:an},{level:5,descriptions:ao,parameters:ap},{level:6,descriptions:aq,parameters:ar},{level:7,descriptions:as,parameters:at},{level:8,descriptions:au,parameters:av},{level:9,descriptions:aw,parameters:ax},{level:10,descriptions:ay,parameters:az},{level:11,descriptions:aA,parameters:aB},{level:12,descriptions:aC,parameters:aD},{level:13,descriptions:aE,parameters:aF},{level:14,descriptions:aG,parameters:aH},{level:15,descriptions:aI,parameters:aJ}],upgrade_costs:[{item_id:104365,amount:3},{item_id:112146,amount:6},{item_id:202,amount:1652500},{item_id:104366,amount:21},{item_id:112147,amount:22},{item_id:104367,amount:38},{item_id:112148,amount:31},{item_id:113088,amount:6},{item_id:104319,amount:1}]}],passives:[{id:1502101,depot_id:15001,name:{key:"3743873237",text:"選ばれし者の祝祭",override:null},description:{key:"4090785243",text:"オデットが{LINK#N11500001}\u003Ccolor=#FFD780FF>独舞者のシルエット\u003C/color>{/LINK}を召喚すると、さらに4層の{LINK#N11500003}\u003Ccolor=#FFD780FF>春の華\u003C/color>{/LINK}を獲得する。",override:null},description_tooltip_ids:[11500001,11500003],buffed_description:null,buffed_description_tooltip_ids:[],parameters:[4,.15,1],proud_skill_type_id:2,required_ascension:1,icon_path_hash:"7743092517765791823"},{id:1502201,depot_id:15001,name:{key:"2140340685",text:"誠実なる者の悲しき歌",override:null},description:{key:"2696262859",text:"オデットの攻撃力のうち1000を超えた部分を基準に、攻撃力100につき、オデットの与える星反応ダメージに本来のダメージの1.5%分の追加ダメージが発生する。この方法による追加ダメージは最大で本来のダメージの30%まで。",override:null},description_tooltip_ids:[],buffed_description:null,buffed_description_tooltip_ids:[],parameters:[1000,.015,.3],proud_skill_type_id:2,required_ascension:4,icon_path_hash:"2018603008986192444"},{id:1502301,depot_id:15001,name:{key:"1891330541",text:"星光の祝福・銀暁の舞",override:null},description:{key:"3264381339",text:"{LINK#N11330003}\u003Ccolor=#FFD780FF>極星フィールド\u003C/color>{/LINK}内にいる時/チーム内のキャラクターが付近で星拡散反応を起こした後の8秒間、オデットはそれぞれ\u003Ccolor=#FFD780FF>輝映・星電導\u003C/color>/\u003Ccolor=#FFD780FF>輝映・星拡散\u003C/color>状態に入る。\\nチーム内のキャラクターが超電導/氷元素拡散反応を起こすと、超電導/氷元素拡散反応は星電導/星拡散反応へと変わり、オデットの攻撃力に基づいて、チームのキャラクターが与える上記反応の基礎ダメージがアップする。攻撃力100につき、上記反応の基礎ダメージ+0.7%。この方法でアップできるダメージは最大14%まで。",override:null},description_tooltip_ids:[11330003],buffed_description:null,buffed_description_tooltip_ids:[],parameters:[.007,.14],proud_skill_type_id:2,required_ascension:0,icon_path_hash:"12088921804868560726"},{id:1502501,depot_id:15001,name:{key:"3238235293",text:"こだまする冬の夢",override:null},description:{key:"3756380339",text:"ミニマップで周囲の\u003Ccolor=#FFD780FF>スネージナヤ地域の特産\u003C/color>の位置を表示する。\\n暇な時はダンスの練習をすると、他の効果が発動するかもしれない…",override:null},description_tooltip_ids:[],buffed_description:null,buffed_description_tooltip_ids:[],parameters:[50,10],proud_skill_type_id:2,required_ascension:0,icon_path_hash:"12929499050509717953"}],skins:[{id:215000,name:{key:"3392385466",text:"雪鳥の舞",override:null},description:{key:"3908224122",text:"オデットの衣装。雪鳥をモチーフにした精巧なバレエの衣装で、勤勉なバレリーナと共に無数の夜を過ごしてきた。あしらわれた宝石は舞台の照明の下で常に静かで優雅な輝光を放ち、まるで透明感あふれる彼女本人のようである。",override:null},lore:{id:0,title:null,description:null,pages:[]},rarity:0,is_default:true,assets:{square_icon_path_hash:null,circle_icon_path_hash:null,side_icon_path_hash:null,splash_art_path_hash:null}}],friendship_rewards:[{level:10,items:[{item_id:210287,amount:1}]}],namecard_id:210287,echoes:[],special_dish:{recipe_id:3706,item_id:132017},profile:{title:{key:"702023914",text:"凛風とともに舞い戻る雪",override:null},birthday_day:20,birthday_month:2,constellation_before:{key:"247244850",text:"雪鳥座",override:null},constellation_after:null,affiliation_before:{key:"1787852161",text:"コロレフスキー劇団",override:null},affiliation_after:null,vision_name_before:{key:"3357476346",text:"星の楔",override:null},vision_name_after:null,vision_before:{key:"2731174348",text:"氷",override:null},vision_after:null,cn_vo:{key:"3103234214",text:"潘丹妮",override:null},jp_vo:{key:"4005213408",text:"上坂すみれ",override:null},kr_vo:{key:"4038567343",text:"최현지",override:null},en_vo:{key:"2491314404",text:"Alexis Tipton",override:null},stories:[{id:150200,title_before:{key:"294617414",text:"キャラクター詳細",override:null},title_after:null,content_before:{key:"2804287856",text:"他国で「踊り子」と言えば、人々は長い人生の旅路に差し込む癒やしの光のように、親しみ深く温かいイメージを抱くだろう。\\nしかしスネージナヤの人々が「踊り子」という言葉から真っ先に連想するのは、あの冷たく研ぎ澄まされた姿である。\\nコロレフスキー劇団のプリンシパルであるオデット・スペシーヴァが、プロモーションポスター上で見せる表情はいつも変わらない。淡々としたまなざしに、軽く結ばれた唇——それはまるで、薄霜をまとった彫像のようにも思える。\\nそれとは対照的に、ファンによる崇拝は情熱的だ。その理由はシンプルで、彼女の均整の取れた体型、冷徹で緊張感のあるパフォーマンスにある。ステップやポーズの一つ一つが、まるで宝石のファセットのように精密に作り込まれ、その鮮烈な輝きで見る者の心を奪う。\\nそして観客は、ここに至るまでに積み重ねられた努力がいかほどであるかを、否が応でも痛感させられる。オデットが舞台に立った瞬間、いかなる疑念の声もたちまち消え去るのだ。\\nだが幕が下りた後、彼女がアンコールに応じることはない。ファンから花や称賛の言葉を贈られても、返答はいつも簡潔だ。\\n「応援、ありがとうございます。それでは。」\\n彼女は決して高慢な態度を取っているわけではない。輝かしい舞台を降りた後も、彼女には果たすべき責務が待っているのだ。彼女の生活は予定で埋め尽くされたカレンダーそのもので、自分自身のための余白など、どこにも残されてはいない。\\n深夜、音もなく横切る人影を目にしても、その身のこなしが人とは思えないほど軽やかであったなら、好奇心に駆られて軽はずみな行動はとらないほうがいい。スネージナヤの雪夜は凍えるほどの寒さで、真っ当な市民なら家で眠りについている。そんな時分に出歩く者には、相応の使命があるのだ。\\nしかし翌朝には、オデットは時間どおりに劇場の稽古場に姿を現す。中から音楽が漏れ聞こえることもあれば、つま先が床を打つかすかな鈍い音だけが響くこともある。鏡張りの壁には、繰り返し脚を上げては下ろす彼女の姿が映る。そのリズムはメトロノームのように正確だ。\\nやがて朝の光が差し込み、他の団員が稽古場に入る時、彼らはしばしば驚きの表情を浮かべる。\\nプリンシパルはまさか一晩中ここにいたのでは、と——",override:null},content_after:null},{id:150201,title_before:{key:"683346214",text:"キャラクターストーリー1",override:null},title_after:null,content_before:{key:"2790730984",text:"スネージナヤのコロレフスキー劇団が毎シーズンの公演を終えるたびに、各紙の文芸欄ではプリンシパルであるオデットをめぐって熱い討論が巻き起こる。\\n「完璧にして、氷のごとく冷然」——とある文芸誌が繰り返し用いたこの評語は、いつしか彼女の代名詞のようになっていた。\\n著名な評論家であるトリポレフは、以前コラムでこう述べた。「オデットの踊りを観ていると、極限まで研ぎ澄まされたナイフが空を切り裂く瞬間を目にしているような心地がする。誰もがその鋭さと正確さに息を飲むが、手を伸ばして触れようとは決して思わない。」\\n仮に他の踊り子がこのような評価を下されたとしたら、その後芸の道を歩むうえで少なからず悪影響を及ぼすだろう。観客は美しいものを好むのが常だ。そして美しいものとは、柔らかく、抒情的で、感動的であるべきとされる。気軽に手を伸ばせるものほど、心の琴線にも触れやすいのだ。\\nしかしオデットはまったく違う。観客が求める情熱や感動、幕が下りる際の心からの笑顔さえ、一切提供しようとはしない。\\n演目に合わせて表情を作る以外は、ファンとの交流会であろうと、プライベートであろうと、彼女は感情をほとんど表に出さないのだ。\\nまるで持てる力のすべてをバレエ技術の研鑽に注ぎ込んでいるかのような彼女は、プリンシパルに求められる以上の厳しさで自身を追い込む。そうして成功を手にしたことは、誰の目にも明らかだ。一方で、自分の感情を偽ってまで観客を喜ばせることが、果たしてプリンシパルの役目なのだろうか？少なくとも彼女はそう思っていない。\\n巷にはオデットに関するちょっとした噂話がある。\\nある貴族が大金を積んで一等席を一列まるごと押さえ、公演終了後には大きなアイスブルーの花束を抱えて楽屋前で二時間待ち続けた。しかし、最終的にスタッフから告げられたのは「プリンシパルは通用口からお帰りになられました。」の一言だけだったという。\\n十ページにもわたる熱烈なファンレターへの返事は、いつも通り「応援、ありがとうございます」の一言のみ。その筆跡がオデットのサインと一致していなければ、代筆を疑っていただろう。\\nさらには、呂律も回らないほど酒に酔った熱狂的ファンが劇場の入口に居座り、バレエがスネージナヤに与える影響についてオデットと語り合おうとしたことがあった。劇場を出たオデットは彼を避けようともせず、ただ足を止めて静かに一瞥したそうだ。目撃者によると、その男はしばらく呆然としていたが、その後頭から氷水をかけられたかのように、ぶつぶつと何かを呟きながらその場を去ったという。\\n……\\nオデットはむやみに感情を取り繕うことをせず、私生活を美化することもない。しかし彼女は、その足が踏みしめる凍土のように揺るぎなく、冷たく、たくましい。嘘偽りのない生き様こそが彼女の魅力であり、だからこそスネージナヤの人々の心に響き、共感を呼ぶのだ。\\nオデットは相変わらず冷淡だが、劇場でチケットを買い求める人々の列が絶えることはない。それはまるで、降り止まぬ雪のようでもあった。",override:null},content_after:null},{id:150202,title_before:{key:"142051582",text:"キャラクターストーリー2",override:null},title_after:null,content_before:{key:"1623543968",text:"コロレフスキー劇団の同僚でさえ、公演以外の場でオデットと気軽に話せる者はごくわずかだ。\\nその一人がヴォジャニーツァであることは疑いようがない。\\n二人の最初の接点は、舞台の段取りに関するわずかな業務上のやりとりに過ぎず、話す内容は演目の構成や衣装の準備状況、初めての舞台に緊張する演者を落ち着かせることについてなどだった。\\n「いつもの稽古通りにリズムをとり、ステップを覚えて、一歩ずつ着実に踊るのです。」——プリンシパルは冷静に、ほとんど表情を変えることなくそう諭した。新人たちにしてみれば普段かけられる言葉と何ら変わりなく、まるで本番も日々の稽古の延長に過ぎないと言われているかのようにも感じられた。しかし演者たちは互いに顔を見合わせ、疑問を飲み込むうちに平静を取り戻していく。プリンシパルの声はあまりにも穏やかで、雪原に刻まれた慌て者の足跡を、静かに覆い隠す雪のようだった。\\n「さあ、みんな！胸を叩いて、もっと心を弾ませるの。思いっきり舞台を楽しんでくるのよ！」——プリマドンナが朗々と、声を張り上げるようにそう告げると、少女たちは言われた通りに胸を叩き、興奮で顔を真っ赤に染めた。彼女の声は、海面で暴れる波濤のようだ。十分な勇気と知恵さえあれば、その奔流に乗ってどこまでも突き進んでいける。\\nそうして演者たちは舞台に上がり、二人のトップスターは舞台裏で腰を落ち着けた。彼女たちの演目はすでに滞りなく幕を閉じたので、あとは新人たちのフィナーレを見守るのみだ。\\n今回の公演のために、彼女たちはできる限りの最善を尽くした。やがて舞台から音楽が流れてくると、休憩室の静寂が静かに破られた。\\n一粒の蜂蜜キャンディが水の精のカップに落ちる。まるで真珠が絹の上を滑るかのような、かすかな「コトン」という音を立てた。\\n「…喉にいいですわよ。」\\nオデットはそれ以上何も言わず、真剣な面持ちでトゥシューズの紐を結び直し、その場から立ち去った。残されたヴォジャニーツァは、甘い香りのする白湯をぼんやりと見つめていた。\\nヴォジャニーツァが後になって知ったことだが、あの蜂蜜キャンディはオデットがハードな稽古の後に体力を回復するために用意していたものであり、あれが最後の一粒だった。オデットもまた後になって知ることになる。水の精であるヴォジャニーツァは歌唱において並外れた才能を持ち、その喉はほとんど疲れを感じないということを。\\n当時のヴォジャニーツァにとっては、他者からの純粋な善意がただただ嬉しかった。ましてや、その「他者」が、透き通る美しい氷のように清冽な存在であれば、なおさらだった。\\nなにしろ、スネージナヤの極寒の吹雪の中では人の善意は貴重なものだ。巡り合えたとして、素早く懐にしまい込まなければ、誰にも砕けないほどに固く凍りついてしまうだろう。\\n……\\n「キャンディはもうありません。」\\n「何を言っているの？今日、あなたのバッグに三箱も詰め込んだばかりなのよ。一粒くらい、くれてもいいじゃない。」\\n「喉を潤す必要はないでしょう？」\\n「スタミナを補給するの。」\\n「その必要もありませんわ。先ほどまで踊っていたのは私ですから。」\\n「あたしだってコーラスで歌っていたのだわ！ここは『ああ、親愛なるヴォジャニーツァ！なんて素晴らしい歌声ですの、何度聴いても飽きませんわ』くらい言って、キャンディを渡すべきでしょ！」\\n「…歌への評価は、公演が終わってからにします。」\\n「それに、今笑ったわよね！ちゃんと見たんだから…えっ？ちょっと…まだ踊るつもりなの？いい加減にして！ご飯を食べに行くわよ！」\\n水の精は見間違ってはいなかった。わずかではあるが、確かにそのバレリーナの口角は上がっていたのだ。\\nしかし、オデットはいつもこう返すだった。\\n「バレエに表情づくりは必要不可欠ですのよ。」",override:null},content_after:null},{id:150203,title_before:{key:"3437644198",text:"キャラクターストーリー3",override:null},title_after:null,content_before:{key:"39149688",text:"オデットが生まれた頃にはスペシーヴァ家の栄光はとうに色褪せており、古びた屋敷に残されていたのは、かつて舞台上で輝きを放った先祖たちの黄ばんだ壁掛けの肖像画だけだった。当時、母のヴィオレッタはバレエの舞台で重要な助演に選ばれたばかりだったが、彼女の目標はあくまで主役を演じることであり、その日が来たら自分の肖像画をここに加えるつもりでいた。小さなオデットは母の心の内を悟ったのか、まるで抗議でもするかのように産着の中で大きな泣き声を上げた。\\n「ごめんなさい、オデット。」母は優しく微笑み、娘の小さな鼻先をちょんとつついた。「もちろん、あなたも一緒よ。みんなが写った家族写真を撮りましょう。」\\n「コツ、コツ、コツ…」扉の向こうから、重く規則的な音が響く。それは軍靴が板張りの床を踏む音で、この一家だけに分かる「合図」だった。母は夫の習慣をよく理解しているので、彼がまだ戸口で雪を落としている間にも、笑顔で出迎えようとしていた。\\n古い屋敷は広すぎるうえ、暖炉の火もさほど勢いがなく、どこか肌寒い。しかし家族の抱擁は何よりも温かかった。\\nやがて少し成長したオデットは、父の顔を覚えるのと同じように軍靴のリズムを胸に刻んだ。「コツ、コツ、コツ…」その音が、夕食と、父が物語を聞かせてくれる時間、そして一晩の安らぎの訪れを意味した。\\n父は軍人で、芸術とは無縁の人だった。常に革と火薬の匂いを漂わせ、ほんの少しの氷雪の冷気をまとっていた。しかし彼は、家族の中で一番熱心な観客でもあった。母が稽古をしていると、父は部屋の隅まで引きずった椅子に腰を掛け、時折でたらめなリズムを足で刻んだ。母は父を「スネージナヤで一番リズム感のない男」と笑ったが、父は反論せず、口元を緩めてへらへらと笑いながら「だが、スネージナヤで一番拍手がうまい観客だ」と返した。\\nそれは事実だった。母が正式な舞曲を踊る時も、鼻歌まじりで即興で踊る時も、最後には必ず父が全力の拍手を送った。その音は情熱的で明るく、窓辺の鳥たちを驚かせてしまうので、幼いオデットはくすくすと笑った。\\nこの頃のオデットはまだ踊ることができなかった。ただ靴下を履いて床を滑るか、父の軍靴に足を乗せ、彼の指を握りながらよちよちと歩く程度だ。父が一歩進めば、娘も一歩進む。その様子はまるで、足取りのおぼつかない雛鳥のようだった。\\n「見てごらん。」父はいつも母にこう言った。「わが家の小さな雪鳥が踊っているぞ。」\\n「あれじゃ小さなアヒルの子よ。」母は笑いながら訂正する。「雪鳥なら、背筋を伸ばさなくちゃ。」\\nすると父は膝をつき、二本の指でオデットの背中に優しく触れた。「背筋を伸ばすんだ、小さな雪鳥さん。」\\nそしてある日、ついに母によるレッスンが始まった。ストレッチ、タンデュ、ジュテ——単調な基本動作を何百回と繰り返す。コーチとしての母は厳しく、足のポジションが一つ違えば問答無用でやり直しをさせられた。オデットは時に目に涙を浮かべながらも、固く口元を結び、忍耐強く稽古を続けた。\\n稽古が終わると、父は必ず時間通りに迎えに来た。\\n「今日は何を習った？見せてくれるかい？」\\nオデットは習ったばかりの動きをぎこちなく披露する。その出来栄えがどうあれ、父の反応はいつも同じだった。まず力強く仰々しいほどの拍手をし、それからしゃがみ込んで真剣な顔でこう言うのだ。\\n「大したものだ。俺の娘は、いつかきっとプリンシパルになる。」\\n母は父の肩にそっと頭を預け、先ほどまでの硬い表情がようやく優しくほころんだ。幼いオデットには、「プリンシパル」が何を意味するのかはまだ分からなかった。しかし、父がその言葉を口にする時の誇らしげな表情や、母が自分を見つめる時の期待に満ちたほほ笑みは、彼女の心にひっそりと一粒の種を蒔いていた。",override:null},content_after:null},{id:150204,title_before:{key:"304052382",text:"キャラクターストーリー4",override:null},title_after:null,content_before:{key:"3197523392",text:"そんな温かく穏やかな日々が、いつまでも続くものだと信じていた。\\nだがある時、父の足音が聞こえなくなった。一日、二日、三日…幼いオデットはひたすら待ち続けたが、ようやく耳に届いたのは、聞き覚えのない軍靴の音だった。\\n二人のファデュイの兵士は玄関に立ち、厳粛な面持ちで母に一通の手紙を差し出した。身体のあらゆる部位を精緻にコントロールできるはずの踊り子が、その時だけは指の震えを止めることができなかった。幼いオデットは慌ててつま先立ちになり、手紙に書かれた文字をなんとか読み取ろうとした。そうして目に飛び込んできたのは、簡潔な一文だった。彼女はそれを、見なかったことにしたかった。\\nその夜、屋敷の中はすべての音を奪われたかのように静まり返った。翌朝、母はいつもと同じように劇場の稽古場へと出かけた。それから三日、四日と過ぎていった。\\n公演の日、客席にいたオデットは、母が倒れる瞬間を目の当たりにした。それが母のミスではなく、稽古通りの動きであれば——あるいは、自分がまだ覚めない悪夢の中にいるのであればと、どれほど願ったことか。しかし、重々しい幕が慌ただしく下ろされ、混乱の中でかろうじて捉えたのは、かつての輝きを完全に失い、ひどく青ざめた母の顔だった。\\n治療を終えた医者は残念そうに告げた。たとえ傷が癒えたとしても、難易度の高いバレエの動きはもはや無理だろうと。\\n……\\nリビングで父がよく座っていた椅子は部屋の隅へと追いやられ、次第に雑多な荷物で埋もれていった。かつて父が手にしていた新聞も、端がめくれ上がって黄ばんでいくばかりで、もはや誰にも必要とされない。暖炉の薪は燃え尽き、部屋の中は外と変わらない寒さになってしまった。母と娘は毛布にくるまってソファの両端に座った。父の定位置だった真ん中には、二人とも座ろうとはしなかった。\\n母は相変わらずオデットにバレエを教えていたものの、正確な手本を見せることはできなくなっていた。大抵は車椅子に座ったまま、杖で床を叩き、「コツ、コツ、コツ…」とテンポを刻んだ。\\nバレエが表現する美は、そもそも苦痛の上に築かれたものだ。しかしオデットは泣き言一つ口にすることはなかった。つま先に血豆ができれば包帯を巻いた。それが何重にもなり、痛みがある臨界点を超えると、まるで身体が麻痺したかのように、かえって耐えられるようになるのだ。彼女は顔の汗をぬぐい、母を見た。母もまた彼女を見つめており、その瞳には同じ痛みが満ちていた。二人は同時に視線を逸らすと、再び稽古に専念した。ひとたび立ち止まれば、何かを思い出してしまう——彼女たちは同じ動作を繰り返すことで、どうにか時間を進めなければならなかったのだ。\\nその循環を断ち切ったのは、聞き慣れないハイヒールの音だった。\\n父の生前の上官であり、ファトゥス第八位の「淑女」。彼女は「隊長」に指示によって、遺族への弔問に訪れたのだった。\\n「淑女」は軽やかに踊るオデットの姿を見て口を開いた。\\n「スペシーヴァ夫人、あんたの傷に触れるつもりはないわ。けれど、一家の働き手を失った今、弔慰金だけで子供を養うのは難しいでしょう？いっそ、その子をファデュイに預けてみない？素質のある子なら喜んで育てるし、相応の手当も支給するわよ。」\\n母はその提案を即座に断った。ファデュイが危険なことは言うまでもない。そのうえ、彼女はその組織のせいで愛する夫を失ったのだ。娘まで失うかもしれないなどとは、想像したくもなかった。\\nしかし、二人の会話を聞いていたオデットが突然前に出て、幼くも揺るぎない声で「何でもします」と言った。自分の身は自分で守り、バレエの稽古とファデュイの訓練を両立させてみせるのだと。\\n「淑女」は目の前に立つ子供の、澄んだ青紫色の瞳を見つめた。それはまるで、氷を裂いて噴き出した炎のようだった。\\n「私にはできますわ。」返事がないので、オデットはもう一度主張した。力強く頑なで、代償など顧みない決意をたたえたその表情に、「淑女」は見覚えがあった。オデットは自らを奮い立たせ、結んだ唇で自分を強く見せようとしていた…\\n「淑女」は冷たく鼻を鳴らしたが、自ら持ちかけた誘いを撤回するのは、彼女のプライドが許さなかった。\\n「だったらついてきなさい。いつまでもつか、見せてもらおうじゃない。」",override:null},content_after:null},{id:150205,title_before:{key:"2166039574",text:"キャラクターストーリー5",override:null},title_after:null,content_before:{key:"1523519616",text:"任務を終えたとき、空は依然として冷たい漆黒を帯びていた。\\nオデットはナイフを収め、無表情のまま全身をチェックした。衣服に目立った汚れはなく、靴の表面は湿っているが行動に支障はない。目的はすでに達成された。相手は完全に肝を冷やし、もう二度と軽率な真似はしないはずだ。\\n夜のスネージナヤは静かだった。降り積もった雪があらゆる音を吸収し、その上を歩く彼女の足音は無音に近い。静寂は彼女の脳裏に余白を生むが、それはかえって余計なことを思い起こす余地でもある。\\nたとえば、先ほどの任務の最後の動作。あれは鮮やかな幕引きだった。手首を内側にひねりながら、素早く正確に元の位置へ戻す。だが彼女は、ナイフを引き戻すのが一瞬遅れたことに気づいていた。右腕を引く際、指先がわずかに外へ伸びていたのだ。誰が見ても気づかないような小さな動きだろうと、見て見ぬふりはできない。\\nそれが何を意味するか、彼女には分かっていた。バレエの公演を締めくくる時にする手の形だ。\\nファデュイの評価資料には、彼女の戦い方はバレエのようだと記されている。一方、母親からは彼女のバレエには感情がこもっていないと評されていた。\\n戦闘では無意識に踊りの動きが垣間見え、踊りでは戦闘訓練で培った力を役立てる。それはまるで身体の内側から自然と溢れ出る気のように、彼女の呼吸や鼓動に寄り添い、骨肉の記憶へと刻み込まれた何かのようだった。\\n剣の切っ先とシューズのつま先——彼女にとって、そこにはとうに境界などなくなっていた。\\nもしかしたら、彼女はもとから多くの顔を持っていなかったのかもしれない。始まりから終わりまで、一貫して変わらない。冬に凍てつかされた人間が、掴めるものすべてを握りしめているだけだ。\\n……\\nオデットは静かにコロレフスキー劇場の裏口へと歩み寄った。\\n稽古場の明かりをつけないまま、彼女はトウシューズに履き替えた。刃のような冷たい月の光が窓から差し込み、床を光と闇の二つに切り分けている。\\n明滅する冷たく白い光の中で、彼女は舞った。他には誰もいない、一人だけの貴重な時間だ。\\n音楽や母の杖の音もなければ、父の足音もない。あるのは自分の呼吸と、バレエシューズの先が床に触れるときのかすかな音だけだ。動きは即興で、振り付けもなく、誰のためでもない。\\nピルエットの速度が高まるにつれ、汗と涙が一つに溶け合っていった。彼女は抗い、渇望し、表現し、そして舞う。\\nもしも窓から雪が舞い込んで、この場面の観客となったなら、きっとこう思うだろう——\\nコロレフスキー劇団のプリンシパルは、噂で語られるほど冷たい人物ではないのかもしれない、と。",override:null},content_after:null},{id:150206,title_before:{key:"1358866910",text:"ぼやけた古い写真",override:null},title_after:null,content_before:{key:"556694752",text:"ヴィオレッタのバレエに対する情熱は他の何ものにも引けを取らなかった。オデットがバレエを習うと決心して以来、一般的なコーチよりもはるかに厳しく娘の指導にあたった。幼い頃のオデットにとって、母親から称賛を得ることは決して容易ではなかった。\\nオデットはあの日のことをずっと覚えている。初めてピルエットの一回転を成功させた日のことを。たどたどしく、完璧とは言えなかったが、確かに一回転しっかりと回り切ったのだ。母は珍しく姿勢をすぐに正そうとはせず、少し間を置いて、わずかに口元を上げた。\\n「いい調子よ。上達が早いわね。」\\n父は感激のあまり立ち上がっていた。\\n「もう一回！ああ、ちょっと待っててくれ——」彼は棚の上の古い写真機をあわてて探し出した。「動くな、動くなよ！よーし、そのまま！」\\n「オルゴールの人形じゃないのよ。どうやってそのままの姿勢でいろっていうの？」母親は呆れたように首を振った。\\n結局、その写真はぶれてしまった。\\nオデットはぼんやりとした笑みを浮かべ、母は笑いをこらえる口元を手で隠し、父は二人のそばへ駆け寄るのが間に合わず、慌ただしい後ろ姿だけを残していた。鮮明に写し出されていたのは、暖炉の炎だけだった。\\nそれでも父は、その写真を懐中時計の中へ大切にしまいこんだ。\\n父は真顔で「これはわが家で最も趣のある家族写真だ。小さなプリンシパルの成長の瞬間を記録したんだからな」と宣言した。「これからどんどん、こんな写真が増えていくぞ。」\\nオデットの幼少期は、そのような日々の断片から成り立っていた。母の厳しく熱心な指導、父の決して欠かさない拍手、暖炉でパチパチと燃える炎、休憩のたびに家族三人でベルベットのソファで肩を寄せ合い、一つの甘いメドヴィクを分け合うひととき。父はいつも一番大きなひと切れを彼女に渡し、母は欲張って両手を伸ばす彼女の鼻筋をつついた。\\n次にオデットがその霞んだ古い写真を目にしたとき、母は車椅子に座り、窓の外で降りしきる大雪をただ静かに眺めていた。風はまるで泣き叫ぶように、すべての冷たい雪を家の中へ吹き込ませんばかりに吹き荒れていた。バレエを踊る時のオデットの手の動きはいつも正確で軽やかだったが、その瞬間だけは両手が重く、持ち上げることさえできないように感じた。彼女は歯を食いしばり、全身の力を振り絞ってようやく、鉄錆と血の跡が残る古い懐中時計の蓋を開いた…\\nスネージナヤの冬は果てしなく長い。すべての希望を埋め尽くすかのように、春など永遠に訪れないかのように。",override:null},content_after:null},{id:150207,title_before:{key:"832102574",text:"星の楔",override:null},title_after:null,content_before:{key:"4265616504",text:"ファデュイの一員となってまもなく、オデットの表情から幼さは消え去った。\\n昼はバレエの基礎の稽古、夜はいつものファデュイの訓練。彼女は二つのスケジュールを忙しなくこなし、その間のわずかな時間でひと息をついた。\\n身体があげる悲鳴による抗議は、最初こそある程度の兆候があった。足首に走る鋭い痛み、跳躍するたびに膝から聞こえる微かな軋み、そして任務中に打ちつけた脇腹のいつまでも消えない痣。いくつもの苦痛が列を成し、順番に彼女に訴えかける。\\nそれでも彼女は意に介さず、包帯をきつく巻き直し、サポーターを厚く重ね、痛みを無理やり身体の奥深くへと押し込み、より激しい訓練でごまかそうとした。\\nその頃、母親は彼女の稽古の時間が急増していることに気づいており、まるで何かを必死に証明しようとしているかのように感じていた。だが母の忠告に対して、オデットの返事はいつも「大丈夫よ」の一言だった。\\n自傷行為と何ら変わりない必死の忍耐の中で、彼女の痛覚はどんどん鈍くなり、ついには——痛みを感じなくなった。\\nその夜、戦闘訓練が終わったのはずいぶん遅い時間だった。宿舎に戻り、疲れ果てたオデットはマントを脱いでふと視線を落とした時、脚に巻いた包帯が暗い色に滲んでいることに気づいた。いつもより血の量がずっと多い。また古傷が開いたようだ。\\n彼女はそれを数秒間、じっと見つめた。\\n何も感じない。まるで他人の傷を見ているようだ。\\n試しに力を込めて押してみた。筋肉がへこむほどの力で押しても、脚はぴくりとも動かない。\\n一切痛みを感じない。\\nオデットはしばらく黙り込み、包帯を巻き直して、暗闇の中で長い間じっと座り込んでいた。\\nこれからは、自分の感覚を麻痺させたり、感情を閉ざしたりする必要はない。どちらの訓練も、もっと長く続けられるはず。\\n彼女はむしろ、わずかな安堵さえ覚えた。この調子だと、コロレフスキー劇団のプリンシパルになるという願いも、きっとすぐに叶うはずだ。\\n疲れを知らずに踊り続ける——固く締め付けられた足先が、回転と跳躍の中であらゆる円舞の一幕や、愛で紡がれた幻想をかすめていく。\\n彼女は完璧な淑女であり、高貴なプリンセスだ。彼女は冬の朝霜のように優雅な水鳥であり、夏の強い日差しのように情熱的な舞姫だ。彼女は孔雀の如く美しきミレディであり、大盗賊レッド・ミラーのパートナーのアンリであり、コッペリアであり、オディールであった。\\nしかし、そのどれもが「オデット」ではなかった。\\n——なら、私はどんな一生を歩むの？\\n幕が下り、誰にも知られることのない声が心の中に響く。\\n——新世界はいずれ訪れると人は言うわ。もしその世界の人々が、私の一生を舞台の物語として綴るとしたら、それはどのような姿であってほしいの？\\n彼女には分からなかった。演目の幕開けはロマンティックで、少なくとも優美であるべきだ。温かな家族、笑い声に満ちた幼少期——今やそのすべてがあまりに遠い場所にある。舞台を照らす照明のまばゆい光よりも、なお遠い。彼女はその炎のように白い光を、両目が焼けんばかりにじっと見つめた。しかし、今の自分がもはやあの温もりを渇望していないこと、そして偽りの優しさも必要としていないことに気づく。\\n彼女にあるのは、苦痛だけだった。それは冷たく肌を刺し、吹き荒れる吹雪のように神聖で粛然とした苦痛だ。\\nそれこそが「オデット」を形作り、彼女を磨き上げ、最も長く付き添ってきた親友なのだ。\\n——そう。私は、死にゆく旧世界に、この不屈の意志を刻みつけたい。\\n——苦痛は私の羽根であり、翼。一番高い場所へ飛んで、雪鳥が見ることのなかった夢を見てみたい。それが、私の願い。\\nそう思いながら、彼女は細めた両目で、舞台の頭上に高く掲げられた照明を見上げた。\\nぼんやりと揺らめいて、手の届かない高さにありながら、触れられそうなほど近くに感じる光。\\nいつものように、全身を燃やし尽くすかのような渾身の舞いだった。\\n幕が下り、舞台裏へ戻ると、氷のような青色の結晶が冷たい光を放ちながら凝集し、形をなしていた。\\nオデットは無言でそれを拾い上げ、手のひらに乗せてじっと見つめた。星の楔——ファデュイの一員として、これの由来については何となく耳にしていた。しかし、実際に触れてみると想像とは違う感覚があった。とても冷たく軽く、まるで吹雪の中で結晶化した一粒の涙のようだった。\\n彼女は多くのことを信じないのと同じように、涙を信じない。失われた痛覚と同じく、それが憐れみなのか恩寵なのか、あるいは呪いなのかは知るよしもない。\\nしかしオデットは、それが何であろうと自分は喜んで受け入れることを理解していた。彼女の翼は彼女の「すべて」であり、激しく吹きつける雪でさえ、やがてその翼の一部となるのだから。\\nこれより先、痛みが剣を抜くことをためらわせることはなく、雪夜の寒さに動きを鈍らせることもない。\\nオデットは顔を上げ、窓の外の空を見つめる。氷のように冷たくなったと思っていた頬に、雪の花が舞い落ち、温かく溶けていった。",override:null},content_after:null}],voice_lines:[{id:150000,title:{key:"2081803735",text:"初めまして…",override:null},content:{key:"805980399",text:"…応援ありがとうございます。サインの横にはどんなイラストをご希望ですか？羽でいいかしら？…あら、ファンの方ではありませんでしたのね。それでは、改めて自己紹介を——私はオデット、スネージナヤコロレフスキー劇団のバレリーナです…応援、感謝いたします。",override:null}},{id:150001,title:{key:"3711639967",text:"世間話・多忙",override:null},content:{key:"4054495455",text:"他に用がなければ、バレエの稽古に行ってまいります。",override:null}},{id:150002,title:{key:"2431177023",text:"世間話・簡単",override:null},content:{key:"1563050255",text:"簡単に返せる質問に、長々と時間を割く必要はありませんわ。",override:null}},{id:150003,title:{key:"1645470991",text:"世間話・時間",override:null},content:{key:"2741474791",text:"時間が倍…いえ、三倍あればいいのに。",override:null}},{id:150004,title:{key:"2292355351",text:"雨の日…",override:null},content:{key:"974639151",text:"しとしとと降り注ぐ雨の音は、静かな気持ちにさせてくれます。こんな日は、一人でバレエの練習をするのに最適ですわ。",override:null}},{id:150005,title:{key:"3328557359",text:"雨上がり…",override:null},content:{key:"3217618023",text:"美しく平穏な時は、一瞬のうちに過ぎ去ってしまうものです。",override:null}},{id:150006,title:{key:"4223919351",text:"雪の日…",override:null},content:{key:"2797807031",text:"スネージナヤの雪は骨を刺すように冷たく、永遠に降りやむことがありません。",override:null}},{id:150007,title:{key:"2919639183",text:"暴風の日…",override:null},content:{key:"831757639",text:"髪が…後で整え直しましょう。",override:null}},{id:150008,title:{key:"867832007",text:"砂漠にいる時…",override:null},content:{key:"913304711",text:"…ファンとの交流会がこういう場所で開かれることがなくてよかったですわ。",override:null}},{id:150009,title:{key:"3291054239",text:"おはよう…",override:null},content:{key:"2194395207",text:"いつでも動けます。ウォーミングアップは終わっていますから。",override:null}},{id:150010,title:{key:"1825607167",text:"こんにちは…",override:null},content:{key:"2200984887",text:"お昼寝は結構ですわ。トレーニングに向かない午後は台本に目を通すようにしておりますの。この便箋ですか？ヴォジャニーツァが私に押し付けてきたファンレターです…しっかり最後まで読むようにと言われております。",override:null}},{id:150011,title:{key:"3919800423",text:"こんばんは…",override:null},content:{key:"67944847",text:"夕食の時間ですの？どうせすぐに開幕ですから、ゆで卵でも食べれば十分です。公演がすべて終わったら、適当に何かいただきますわ。",override:null}},{id:150012,title:{key:"3376704527",text:"おやすみ…",override:null},content:{key:"3470016975",text:"…任務完了。トレーニングのノルマは達成したし、新しいバレエの練習も終わったけど…まだ表情のコントロールが不十分だわ。もう少し鏡の前で調整しなければ…あら、もうこんな時間でしたの？先に休んでいてください。まだやるべきことがありますので。",override:null}},{id:150013,title:{key:"3371019623",text:"オデット自身について・ロコット",override:null},content:{key:"2973935103",text:"厳冬計画が始まってからというもの、劇場まで足を運んでくださる観客は少しずつ減り…困窮する人々から搾取しようとする輩まで現れています。もう、黙って見過ごすことなどできませんわ。私の力だけではどうにもできないことは百も承知ですけれど、できることをしてみたいのです。",override:null}},{id:150014,title:{key:"687132951",text:"オデット自身について・記憶力",override:null},content:{key:"3422465527",text:"昔の記憶は、烙印のようにこの胸に刻まれています。そして皆が寝静まった夜、映影のように繰り返し再生されるのです…記憶力が良すぎるのも、考えものですね。",override:null}},{id:150015,title:{key:"2912194791",text:"希望を託すについて…",override:null},content:{key:"218221863",text:"他人の庇護など、張ったばかりの薄氷のように脆いものです。私は他人に希望を託したりなどいたしません。",override:null}},{id:150016,title:{key:"3697936391",text:"かさぶたについて…",override:null},content:{key:"3023406215",text:"私は痛覚にとても鈍感で、怪我に気づいた頃には、すでにかさぶたになっておりますの。おかげでバレエの練習にしても、ファデュイの訓練にしても、体のことでスケジュールに支障をきたさずすみます。",override:null}},{id:150017,title:{key:"934893823",text:"「星の楔」について…",override:null},content:{key:"2448069015",text:"以前、とある訓練で足に凍傷を負い、感覚すら失った時——「星の楔」が放つ光の中で意識を取り戻しました。けれど、「星の楔」が人を呼び起こせるなどという話は、聞いたことがありません。あの時目覚めたのは…私が本能的に生きたいと願ったから…？",override:null}},{id:150018,title:{key:"3148290463",text:"シェアしたいこと…",override:null},content:{key:"1837885599",text:"リハーサルとは、本番の公演と同じように真剣に臨むものです。",override:null}},{id:150019,title:{key:"318949727",text:"興味のあること…",override:null},content:{key:"272533951",text:"甘みの少ないアイススグリには、塩を少し振ると美味しくなりますのよ。塩気で甘みが際立つとか。とあるファンの方が教えてくれましたの。",override:null}},{id:150020,title:{key:"1640454175",text:"ロザリンについて・かつて",override:null},content:{key:"2891473175",text:"ロザリン様には恩もありますが…憎んだこともあります。ロザリン様はとても厳しくて、訓練を受けていた時期は、凍えたり、過労で倒れたり、怪我や体調不良に見舞われたりは日常茶飯事でした。かつての私は無邪気にも、一人で舞台に立ち、バレエで母を養えるようになった暁には、ファデュイを抜けてロザリン様を見返してやろうだなんて思っておりましたけれど。",override:null}},{id:150021,title:{key:"3681575295",text:"ロザリン・燃珀について",override:null},content:{key:"215710983",text:"伝える対象がいなくなれば、多くの言葉は行き場を失います。燃珀はあっけなく割れました…皮肉なものですね。かつてはあれだけ傷つき、誤解し合っていたというのに…いまさら、あの人のことが理解できるなんて。",override:null}},{id:150022,title:{key:"2257705279",text:"「女皇」陛下について…",override:null},content:{key:"3515417983",text:"「女皇」陛下はスネージナヤの信仰そのもの。ご多忙のため、めったにお姿を見せられず、私もお目にかかれた回数はごくわずかですが…とても威厳のある方で、その眼差しは万年雪のように冷たく、揺るぎありません。",override:null}},{id:150023,title:{key:"1419115975",text:"「少女」様について…",override:null},content:{key:"4270492719",text:"彼女の歩く姿は、まるで羽がふわりと舞い踊るかのようですわ。その軽やかさは、全バレリーナの憧れです。そのうえ、透き通るような歌声もお持ちとは——いつだったか、ヴォジャニーツァが高く評価していましたわ。しかし、そうして私たちが羨んでいるのは、すべて彼女の表の姿。彼女が人知れず苦しみを抱えていないとは言い切れません。",override:null}},{id:150024,title:{key:"2576817391",text:"「召使」様について…",override:null},content:{key:"3181727815",text:"壁炉の家の子供たちは皆、「召使」様を「お父様」と見なしています。父親に守られる子供たちは、成長の道のりで氷雪や風雨に晒されることがいくらか少なくなるものです。",override:null}},{id:150025,title:{key:"1355002231",text:"「傀儡」様について…",override:null},content:{key:"254477791",text:"「傀儡」様のお茶会があった日は、ロザリン様の機嫌が良かったものです——厳しさは相変わらずでも、誰が見ても明らかなほど、口調が優しくなるのです。",override:null}},{id:150026,title:{key:"2871550343",text:"ヴォジャニーツァについて・笑顔",override:null},content:{key:"3360191831",text:"初めて「女皇」陛下にコロレフスキー劇団の公演をご覧いただけることになった際、私はヴォジャニーツァからその報せを受けました。私は「わかりました」と答えましたわ。すると彼女は人差し指で私の口角を無理やりつり上げて笑顔を作らせ、一緒に「やったー！」と喜ぶよう求めてきました。\\n私は今でも、「女皇」陛下があのような笑顔を気に入るとは思えませんわ。",override:null}},{id:150027,title:{key:"3436333471",text:"ヴォジャニーツァについて・診察",override:null},content:{key:"2223250655",text:"ヴォジャニーツァは体調不良の時、いつも私にまとわりついて、一緒にいてほしいとせがむんですの…万が一注射をされたり、苦い薬を飲むことになったりしたら怖いので、私の腕をぎゅっと掴んでいたいそうですわ。私は痛覚が鈍いので、もちろん彼女を振り払ったりはいたしませんけれど。",override:null}},{id:150028,title:{key:"2091401399",text:"アリョーシャについて…",override:null},content:{key:"3707176991",text:"生計を立てるだけなら、ハンターとしての収入で十分なはずなのに、彼は苦しんでいる人々を助けるため、頻繁に劇場でアルバイトをしていました…彼がロコットの一員というのも、納得です。",override:null}},{id:150029,title:{key:"3489565119",text:"ミティヤについて…",override:null},content:{key:"2216124831",text:"その「ファン」の方は…よく劇場へ私とヴォジャニーツァの舞台を観に来てくださいますわ。しかし毎回いざ舞台が始まると、うつむいて何かを書き始めるのです。他の観客は皆、舞台を見つめているものですから余計に目立ちますのよ。もしかすると、彼よりも彼のマフラーのほうが、公演の楽しみ方を分かっているかもしれませんわね。",override:null}},{id:150030,title:{key:"884268431",text:"バレリーについて…",override:null},content:{key:"1075178687",text:"バレリー少将は時間に厳しいファデュイの将校だとか。常に冷静かつ恐ろしい態度で皆に仕事を割り振るのだそうです。ですが、私は所属が違うので接点はほとんどありませんし…そもそも私は何をすべきかなど、人に指図されずとも結構ですわ。",override:null}},{id:150031,title:{key:"2214192615",text:"ヴェスナについて…",override:null},content:{key:"2166353303",text:"羽根があるからと言って、彼女を美しく無害な蝶だと思ってはいけません。皆に愛されていても、彼女が冬契軍の総司令であり、吹雪のハンターであることに変わりはないのです。人当たりのいい笑みに騙されませんよう。",override:null}},{id:150032,title:{key:"3138689431",text:"オデットを知る・1",override:null},content:{key:"1382148447",text:"スケジュールに余裕がなく…この後も訓練ですの。申し訳ないけれど、お話なら、手短にお願いしたいわ。",override:null}},{id:150033,title:{key:"2206869943",text:"オデットを知る・2",override:null},content:{key:"2337983719",text:"私の母はバレエの名家の出身で、父はファデュイに所属しておりました。二人はとある公演をきっかけに結ばれたのですが…それがまた、聞く人すべてを笑顔にするような、ロマンチックな話ですのよ。幼い頃、母は私と軽やかに踊ってくれて、父は私に新品の可愛らしいチュチュを買ってくれました。唯一の悩みは、毎日キャンディ瓶からどのキャンディを選ぶかということだけでしたわ。",override:null}},{id:150034,title:{key:"3622652975",text:"オデットを知る・3",override:null},content:{key:"3827987735",text:"父が殉職したという報せが届き…母は悲しみのあまり、公演中に足を骨折してしまいました。キャンディはすべてこぼれ落ちて…空っぽの瓶は、私を閉じ込める檻となりました。",override:null}},{id:150035,title:{key:"3448820879",text:"オデットを知る・4",override:null},content:{key:"1143248303",text:"その後のことは、あなたも知っての通りですわ。何度も繰り返し振り返ってきましたから、いまさら傷つくことはありません。そうした運命に抗ってきたからこそ、私なりの力を得たのです。このことは、決して忘れません。",override:null}},{id:150036,title:{key:"1397525911",text:"オデットを知る・5",override:null},content:{key:"546463767",text:"どれも、ファンには言えないことばかり…あなたがファンでなくてよかったですわ。私には多くの「顔」があり、そのすべてに純粋に身を投じ続けなくてはならない…これからも、私の思う「完璧」に向かって舞い続けるのみです。",override:null}},{id:150037,title:{key:"2175924583",text:"オデットの趣味…",override:null},content:{key:"2480887287",text:"生まれてから今まで、バレエよりも好きなことはありません。舞台上で私の出せる最高のパフォーマンスを観客の皆さまに届けられるよう、全力を尽くしますわ。",override:null}},{id:150038,title:{key:"1495464447",text:"オデットの悩み…",override:null},content:{key:"3048172767",text:"正直なところ、私はあまり動物に好かれていないと思います。劇場の近くにはよく子猫が出るので、ヴォジャニーツァに引っ張られて餌をやりに行くことがあるのですが、私が近づくと子猫が爪を研ぎ始めるのです…えっ？あれは歓迎しているという意味でしたの？",override:null}},{id:150039,title:{key:"1096525951",text:"好きな食べ物…",override:null},content:{key:"1904722199",text:"レストランの閉店間際になると、サラダが半額になるのでよく食べていましたわ。時間が経ったサラダの味はもちろん新鮮なものには敵いませんけれど、馴染み深い食感に、かえって安心しますの。",override:null}},{id:150040,title:{key:"1681701095",text:"嫌いな食べ物…",override:null},content:{key:"552389903",text:"個人的な好みの話であれば、どうしても食べられないような食べ物はありませんわ。しかし、バレリーナとしては食事を制限する必要がありますから、日々の食事計画にない非推奨の食べ物は食べないようにしています。",override:null}},{id:150041,title:{key:"2043931087",text:"贈り物を受け取る・1",override:null},content:{key:"1411326391",text:"ここ数日は公演が多いから、もっと…いえ、なんでもありません。すごく、美味しいです。",override:null}},{id:150042,title:{key:"1689739375",text:"贈り物を受け取る・2",override:null},content:{key:"2055273591",text:"一品というより…一日分の量ですわね。",override:null}},{id:150043,title:{key:"1297075535",text:"贈り物を受け取る・3",override:null},content:{key:"2882898199",text:"申し訳ありませんが、体重管理をしていますの。",override:null}},{id:150044,title:{key:"1234488615",text:"誕生日…",override:null},content:{key:"3280699519",text:"誕生日おめでとう。誕生日プレゼントは何がいいですか？私はいつも花やダンスシューズ、オルゴールばかりいただきますけれど、あなたはもっと別のものがいいですわよね。この際、願いを教えてください。私が実現できる願いなら、叶えて差し上げますわ。",override:null}},{id:150045,title:{key:"600181871",text:"突破した感想・起",override:null},content:{key:"2308088279",text:"何か足りない…もう少し練習量を増やさないと。",override:null}},{id:150046,title:{key:"2482379143",text:"突破した感想・承",override:null},content:{key:"958508375",text:"動作がさらに正確になった実感があります…この練習量のままいきましょう。",override:null}},{id:150047,title:{key:"154959007",text:"突破した感想・転",override:null},content:{key:"920828111",text:"今ならフェッテを完璧にこなせそうです。それでも、稽古時間を減らすわけにはいきません。",override:null}},{id:150048,title:{key:"3574677615",text:"突破した感想・結",override:null},content:{key:"1764471119",text:"「感情もバレエには欠かせない要素の一つ」——今なら、この言葉の意味がわかります。いつもそばで応援してくださり、ありがとうございます。今日の公演のチケットを差し上げますわ。",override:null}},{id:150049,title:{key:"1907923423",text:"元素スキル・1",override:null},content:{key:"2468770199",text:"行きますわよ。",override:null}},{id:150050,title:{key:"205225391",text:"元素スキル・2",override:null},content:{key:"3186368759",text:"氷に映るは雪の影。",override:null}},{id:150051,title:{key:"1879264479",text:"元素スキル・3",override:null},content:{key:"2669273183",text:"さん、はい——",override:null}},{id:150052,title:{key:"2929023335",text:"元素スキル・4",override:null},content:{key:"851162287",text:"踊りましょう。",override:null}},{id:150053,title:{key:"3829987623",text:"元素スキル・5",override:null},content:{key:"3843273151",text:"ピルエット。",override:null}},{id:150054,title:{key:"811678999",text:"元素スキル・6",override:null},content:{key:"3814270415",text:"ふっ…",override:null}},{id:150055,title:{key:"2453619031",text:"元素爆発・1",override:null},content:{key:"2725695903",text:"凍てつく旋律を。",override:null}},{id:150056,title:{key:"3439036695",text:"元素爆発・2",override:null},content:{key:"1496236263",text:"氷上に舞い描く——",override:null}},{id:150057,title:{key:"404108623",text:"元素爆発・3",override:null},content:{key:"3278453079",text:"雪鳥の礼賛をご覧なさい。",override:null}},{id:150058,title:{key:"3071585679",text:"宝箱を開ける・1",override:null},content:{key:"720754959",text:"持って行ってください。私は結構ですので。",override:null}},{id:150059,title:{key:"3391011135",text:"宝箱を開ける・2",override:null},content:{key:"2090896751",text:"旅も修練…一歩一歩に意味があるのですわ。",override:null}},{id:150060,title:{key:"2457309335",text:"宝箱を開ける・3",override:null},content:{key:"311271703",text:"努力の成果ですね。",override:null}},{id:150061,title:{key:"776711287",text:"HP低下・1",override:null},content:{key:"2843726967",text:"気にすることはないわ。",override:null}},{id:150062,title:{key:"1924742223",text:"HP低下・2",override:null},content:{key:"2260383119",text:"かすり傷よ。",override:null}},{id:150063,title:{key:"839553063",text:"HP低下・3",override:null},content:{key:"2556983591",text:"まだいける。",override:null}},{id:150064,title:{key:"3750423679",text:"仲間HP低下・1",override:null},content:{key:"1350864319",text:"大丈夫かしら？",override:null}},{id:150065,title:{key:"2386244871",text:"仲間HP低下・2",override:null},content:{key:"4063214599",text:"代わりましょう。",override:null}},{id:150066,title:{key:"3088386519",text:"戦闘不能・1",override:null},content:{key:"2138913031",text:"努力が…足りなかった…",override:null}},{id:150067,title:{key:"248433727",text:"戦闘不能・2",override:null},content:{key:"233068887",text:"いけない、立ち上がらないと…",override:null}},{id:150068,title:{key:"2436122871",text:"戦闘不能・3",override:null},content:{key:"4260732263",text:"まだ…痛みを感じられるのね…",override:null}},{id:150069,title:{key:"3077490879",text:"ダメージを受ける・1",override:null},content:{key:"2635165847",text:"へえ。",override:null}},{id:150070,title:{key:"2204462583",text:"ダメージを受ける・2",override:null},content:{key:"2383124911",text:"それで？",override:null}},{id:150071,title:{key:"513401983",text:"重ダメージを受ける・1",override:null},content:{key:"2082145647",text:"それで終わり？",override:null}},{id:150072,title:{key:"3349927359",text:"重ダメージを受ける・2",override:null},content:{key:"3110080759",text:"きかないわ。",override:null}},{id:150073,title:{key:"4165909847",text:"チーム加入・1",override:null},content:{key:"3710658647",text:"準備できましたわ。",override:null}},{id:150074,title:{key:"400485583",text:"チーム加入・2",override:null},content:{key:"261741639",text:"特別公演ですの？",override:null}},{id:150075,title:{key:"2105221415",text:"チーム加入・3",override:null},content:{key:"1230926207",text:"今回はどちらへ？",override:null}}]}},refs:{assets:{"10613035475164543785":{id:"10613035475164543785",url:"https://cdn.gachabase.net/gi/assets/6ead9454891939ae5bd696e53d986916.png",file_size:9327,width:128,height:128},"11016985440208467066":{id:"11016985440208467066",url:"https://cdn.gachabase.net/gi/assets/c7dc10c1650ba0d168f389212803ca4e.png",file_size:1755680,width:2048,height:1024},"11269780026371967385":{id:"11269780026371967385",url:"https://cdn.gachabase.net/gi/assets/c073425c31543779f8db8a61185538b6.png",file_size:72871,width:256,height:256},"11528883048139936686":{id:"11528883048139936686",url:"https://cdn.gachabase.net/gi/assets/1fcb7b09b82b0fd3eb99b690dd5fea05.png",file_size:10001,width:128,height:128},"12064371681326627947":{id:"12064371681326627947",url:"https://cdn.gachabase.net/gi/assets/d315ce40a4d2918fba96ad4dab1456ab.png",file_size:51743,width:256,height:256},"12088921804868560726":{id:"12088921804868560726",url:"https://cdn.gachabase.net/gi/assets/da396fe27883de894c4a4a7ec8bba2a3.png",file_size:6172,width:100,height:100},"12742494260449313961":{id:"12742494260449313961",url:"https://cdn.gachabase.net/gi/assets/de62ea27ebe5a2c0848aae5c6ea8fab8.png",file_size:52628,width:256,height:256},"12846472216925348440":{id:"12846472216925348440",url:"https://cdn.gachabase.net/gi/assets/2643b825e8148220ba22ab90019719c0.png",file_size:5040,width:65,height:64},"12905622642702554841":{id:"12905622642702554841",url:"https://cdn.gachabase.net/gi/assets/8fd9fcfeaa88804476180fbb887f3b27.png",file_size:30171,width:256,height:256},"12929499050509717953":{id:"12929499050509717953",url:"https://cdn.gachabase.net/gi/assets/8c597021140d7303825f3659f8ee1c75.png",file_size:5659,width:100,height:100},"13433933038932466161":{id:"13433933038932466161",url:"https://cdn.gachabase.net/gi/assets/50ff2e009c1ef521aa347bed72e5e9aa.png",file_size:37267,width:512,height:512},"13464862790376013535":{id:"13464862790376013535",url:"https://cdn.gachabase.net/gi/assets/6f6912c96a5f1b61ee1a12e481e9695b.png",file_size:610588,width:320,height:1024},"1387479322476826027":{id:"1387479322476826027",url:"https://cdn.gachabase.net/gi/assets/53f6f9270706c42d2de5256d5059c78e.png",file_size:8270,width:100,height:100},"13998602462318431899":{id:"13998602462318431899",url:"https://cdn.gachabase.net/gi/assets/f810d9c815a23c9eaf32bd17f5577f1b.png",file_size:33085,width:256,height:256},"1404789693290859748":{id:"1404789693290859748",url:"https://cdn.gachabase.net/gi/assets/96ea3f8e902321839661fb5a5156f9fe.png",file_size:39471,width:256,height:256},"15664253407751301348":{id:"15664253407751301348",url:"https://cdn.gachabase.net/gi/assets/1fcb7b09b82b0fd3eb99b690dd5fea05.png",file_size:10001,width:128,height:128},"16478715774902447096":{id:"16478715774902447096",url:"https://cdn.gachabase.net/gi/assets/71c32de19d9c526a267a59832b5b6c6d.png",file_size:19005,width:256,height:256},"16602146070833358488":{id:"16602146070833358488",url:"https://cdn.gachabase.net/gi/assets/41954b72a03c3e5793a8dc6bafe0ab24.png",file_size:15359,width:128,height:128},"17448328805685852160":{id:"17448328805685852160",url:"https://cdn.gachabase.net/gi/assets/c35e9730ab2bc81038fb1bbc4292f861.png",file_size:54619,width:256,height:256},"17695981262840418851":{id:"17695981262840418851",url:"https://cdn.gachabase.net/gi/assets/30e62fc8ced7b74b252691febac9cfff.png",file_size:57700,width:256,height:256},"17755734626094028860":{id:"17755734626094028860",url:"https://cdn.gachabase.net/gi/assets/e0ed0016a95032bf75822ca7eb351d80.png",file_size:64351,width:256,height:256},"17846557813871886887":{id:"17846557813871886887",url:"https://cdn.gachabase.net/gi/assets/7443522f73a3eccababf12b24eed5b28.png",file_size:5417,width:128,height:128},"17846632495462411121":{id:"17846632495462411121",url:"https://cdn.gachabase.net/gi/assets/626e664ca4575984e75a3cadac8cb871.png",file_size:500891,width:840,height:400},"17988216312721515086":{id:"17988216312721515086",url:"https://cdn.gachabase.net/gi/assets/ca99d35242e7d6fd40fefe88442251e2.png",file_size:6690,width:100,height:100},"18276017949956885197":{id:"18276017949956885197",url:"https://cdn.gachabase.net/gi/assets/709dfab1e9ec18441122a232761bbc58.png",file_size:15693,width:256,height:256},"1865362235170915160":{id:"1865362235170915160",url:"https://cdn.gachabase.net/gi/assets/c793ed3808d1fa827bb18ef1b4a50881.png",file_size:48613,width:256,height:256},"1941205315277563924":{id:"1941205315277563924",url:"https://cdn.gachabase.net/gi/assets/d65824cfc2bf0dfd41a1e5e4ca1b44ab.png",file_size:58925,width:256,height:256},"2018603008986192444":{id:"2018603008986192444",url:"https://cdn.gachabase.net/gi/assets/d3e22203e042d