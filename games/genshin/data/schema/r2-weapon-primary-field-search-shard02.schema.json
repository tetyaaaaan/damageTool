{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "r2-weapon-primary-field-search-shard02.schema.json",
  "title": "Genshin r2 weapon primary-field candidate-scoped search shard 02",
  "description": "A draft-only, candidate-scoped finite provider search record for numeric observations ranked 101-200. It records an external-evidence hold; it cannot issue an eligibility certificate, select semantic mappings, change the authoritative queue, or promote canonical data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "generatedAt",
    "status",
    "lane",
    "transition",
    "policy",
    "scope",
    "inputEvidence",
    "frontier",
    "providers",
    "candidates",
    "summary",
    "gate",
    "fieldDigestAlgorithm",
    "fieldDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "genshinR2WeaponPrimaryFieldSearchShard" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "const": "draft" },
    "lane": { "const": "weaponPrimaryNumericCandidateScopedFrontier" },
    "transition": { "$ref": "#/$defs/transition" },
    "policy": { "type": "object", "additionalProperties": true },
    "scope": { "$ref": "#/$defs/scope" },
    "inputEvidence": { "$ref": "#/$defs/inputEvidence" },
    "frontier": { "$ref": "#/$defs/frontier" },
    "providers": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": true } },
    "candidates": {
      "type": "object",
      "minProperties": 100,
      "maxProperties": 100,
      "additionalProperties": { "$ref": "#/$defs/candidate" }
    },
    "summary": { "type": "object", "additionalProperties": true },
    "gate": { "$ref": "#/$defs/gate" },
    "fieldDigestAlgorithm": { "const": "sha256-stable-json-v1" },
    "fieldDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/digest" },
        "fieldDigest": { "type": ["string", "null"] }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": true,
      "required": ["gameVersion", "revision"],
      "properties": {
        "gameVersion": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": true,
      "required": ["transitionId", "fromGameVersion", "targetGameVersion", "primaryProvider", "primarySourceFamily"],
      "properties": {
        "transitionId": { "const": "6.7-to-7.0" },
        "fromGameVersion": { "const": "6.7" },
        "targetGameVersion": { "const": "7.0" },
        "primaryProvider": { "const": "genshin-db" },
        "primarySourceFamily": { "const": "GenshinData-derived" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": true,
      "required": ["shardId", "candidateCount", "expectedCandidateCount", "sourceNumericCandidateCount", "candidateIdDigest", "candidateIds"],
      "properties": {
        "shardId": { "const": "weapons-primary-numeric-shard02" },
        "candidateCount": { "const": 100 },
        "expectedCandidateCount": { "const": 100 },
        "sourceNumericCandidateCount": { "const": 310 },
        "consumerFreeNumericCandidateCount": { "const": 309 },
        "candidateIdDigest": { "$ref": "#/$defs/digest" },
        "candidateIds": {
          "type": "array",
          "minItems": 100,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "inputEvidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["files", "queueObservation", "officialHoYoWiki", "finiteWeaponLedger"],
      "properties": {
        "files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/fileRef" }
        },
        "queueObservation": { "type": "object", "additionalProperties": true },
        "officialHoYoWiki": { "type": "object", "additionalProperties": true },
        "finiteWeaponLedger": { "type": ["object", "null"], "additionalProperties": true }
      }
    },
    "frontier": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "policyId", "status", "exhausted", "scopeMatched", "candidateScoped", "candidateCount", "candidateIdDigest", "candidateIds", "searchScope", "lastSearchedAt", "providersExamined", "negativeResult", "reopenTrigger", "g06HoldEligible", "queueIntegration", "evidenceRefs"],
      "properties": {
        "id": { "const": "weapons-primary-numeric-shard02-independent-field-frontier-7.0" },
        "policyId": { "const": "genshin-7.0-weapon-primary-numeric-shard-independent-field-frontier" },
        "status": { "const": "searchExhausted" },
        "exhausted": { "const": true },
        "scopeMatched": { "const": true },
        "candidateScoped": { "const": true },
        "candidateCount": { "const": 100 },
        "candidateIdDigest": { "$ref": "#/$defs/digest" },
        "candidateIds": { "type": "array", "minItems": 100, "maxItems": 100, "uniqueItems": true, "items": { "type": "string" } },
        "searchScope": { "type": "string", "minLength": 1 },
        "lastSearchedAt": { "type": "string", "format": "date" },
        "providersExamined": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "negativeResult": { "type": "string", "minLength": 1 },
        "reopenTrigger": { "type": "string", "minLength": 1 },
        "g06HoldEligible": { "const": true },
        "queueIntegration": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/fileRef" } }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": true,
      "required": ["candidateId", "entityId", "primaryComparison", "primaryRawObservation", "local", "currentQueue", "providerResults", "officialRawClaims", "claims", "frontier", "disposition", "gate"],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "entityId": { "type": ["string", "null"] },
        "primaryComparison": { "type": "object", "additionalProperties": true },
        "primaryRawObservation": { "type": "object", "additionalProperties": true },
        "local": { "type": "object", "additionalProperties": true },
        "currentQueue": { "type": ["object", "null"], "additionalProperties": true },
        "providerResults": { "type": "object", "additionalProperties": true },
        "officialRawClaims": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "claims": { "type": "object", "additionalProperties": { "$ref": "#/$defs/claim" } },
        "frontier": { "type": "object", "additionalProperties": true },
        "disposition": { "type": "object", "additionalProperties": true },
        "gate": { "$ref": "#/$defs/gate" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": true,
      "required": ["claimId", "field", "primaryProvider", "officialIndependentProvider", "frontier", "disposition"],
      "properties": {
        "claimId": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "primaryProvider": { "type": "object", "additionalProperties": true },
        "officialIndependentProvider": { "type": "object", "additionalProperties": true },
        "frontier": { "type": "object", "additionalProperties": true },
        "disposition": { "type": "object", "additionalProperties": true }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": true,
      "required": ["strictVerified", "certificateEligible", "canonicalPromotionEligible", "semanticMappingSelected"],
      "properties": {
        "strictVerified": { "const": false },
        "certificateEligible": { "const": false },
        "canonicalPromotionEligible": { "const": false },
        "semanticMappingSelected": { "const": false }
      }
    }
  }
}
