<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>アクセス確認中 - WIKIWIKI</title>

  <style>
    :root{
      --brand:#9acd32; --bg:#f9f9f9; --fg:#333; --muted:#555;
    }
    *{ box-sizing:border-box }
    body{
      margin:0; background:var(--bg); color:var(--fg);
      font-family:"Helvetica Neue","Hiragino Kaku Gothic ProN",Meiryo,sans-serif;
      line-height:1.7; text-align:center; min-height:100vh;
      display:flex; flex-direction:column;
    }
    header{ background:var(--brand); padding:12px 20px; text-align:left; }
    .logo{ color:#fff; font-weight:700; font-size:28px; text-decoration:none; }

    main{ flex:1; padding:40px 20px; max-width:760px; margin:0 auto; }
    h1{ font-size:26px; margin:.4em 0 .6em; color:#444; }
    .lead{ color:var(--muted); margin:10px auto 0; font-size:15px; }
    @supports (text-wrap:balance){ .lead{ text-wrap:balance; } }
    @media (min-width:720px){ .lead{ max-width:52ch; } }

    .icon-wrap{ max-width:72px; margin:8px auto 16px; opacity:.95; }
    .icon-wrap svg{ display:block; width:100%; height:auto; fill:var(--brand); }

    .spinner{
      width:44px; height:44px; margin:18px auto;
      border:4px solid rgba(0,0,0,.08);
      border-top-color:var(--brand);
      border-radius:50%;
      animation:spin 1s linear infinite;
    }
    @keyframes spin{ to{ transform:rotate(360deg) } }

    .support{ margin-top:14px; font-size:14px; color:#444; }

    @media (max-width:480px){
      header{ padding:10px 16px; } .logo{ font-size:24px; }
      main{ padding:30px 16px; } h1{ font-size:22px; }
    }
  </style>
<meta http-equiv="refresh" content="360"></head>
