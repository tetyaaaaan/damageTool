{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "genshin-version-transition-behavior-entity-snapshot.schema.json",
  "title": "Genshin version transition behavior entity snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generatedAt", "claim", "summary", "gateEligibility", "fieldDigestAlgorithm", "fieldDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "genshinVersionTransitionBehaviorEntitySnapshot" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "claim": { "$ref": "#/$defs/claim" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolvedEntities", "ambiguousEntities", "travelerVariants", "resolvedRecords", "changedRecords", "changedFields", "sourceFamilyCount", "certificateEligibleClaims"],
      "properties": {
        "resolvedEntities": { "type": "integer", "minimum": 0 },
        "ambiguousEntities": { "type": "integer", "minimum": 0 },
        "travelerVariants": { "type": "integer", "minimum": 0 },
        "resolvedRecords": { "type": "integer", "minimum": 0 },
        "changedRecords": { "type": "integer", "minimum": 0 },
        "changedFields": { "type": "integer", "minimum": 0 },
        "sourceFamilyCount": { "type": "integer", "minimum": 1 },
        "certificateEligibleClaims": { "const": 0 }
      }
    },
    "gateEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sourceFamilyCount", "canIssueEligibilityCertificate", "canPromoteCanonical", "reasons"],
      "properties": {
        "status": { "const": "singleCorrelatedFamilyFailClosed" },
        "sourceFamilyCount": { "const": 1 },
        "canIssueEligibilityCertificate": { "const": false },
        "canPromoteCanonical": { "const": false },
        "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "fieldDigestAlgorithm": { "const": "sha256-stable-json-v1" },
    "fieldDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "gitBlob": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameVersion", "revision", "packageVersion", "path", "url", "gitBlob", "rawArtifactBytes", "rawArtifactSha256"],
      "properties": {
        "status": { "const": "sourcePathMissing" },
        "gameVersion": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/revision" },
        "packageVersion": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "gitBlob": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
        "rawArtifactBytes": { "type": ["integer", "null"], "minimum": 0 },
        "rawArtifactSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameVersion", "revision", "packageVersion", "path", "url", "gitBlob", "rawArtifactBytes", "rawArtifactSha256", "name", "description"],
      "properties": {
        "gameVersion": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/revision" },
        "packageVersion": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "gitBlob": { "$ref": "#/$defs/gitBlob" },
        "rawArtifactBytes": { "type": "integer", "minimum": 1 },
        "rawArtifactSha256": { "$ref": "#/$defs/sha256" },
        "name": { "const": "genshin-db" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "changedFieldCount", "fieldDiffs"],
      "properties": {
        "status": { "enum": ["rawRecordMatch", "rawRecordChanged", "sourcePathMissing"] },
        "changedFieldCount": { "type": ["integer", "null"], "minimum": 0 },
        "fieldDiffs": { "type": "array" },
        "comparisonEligible": { "const": false }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordKind", "before", "after", "comparison"],
      "properties": {
        "recordKind": { "enum": ["talents", "constellations"] },
        "before": { "$ref": "#/$defs/artifact" },
        "after": { "$ref": "#/$defs/artifact" },
        "comparison": { "$ref": "#/$defs/comparison" }
      }
    },
    "resolvedEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entityId", "name", "nameJa", "providerSlug", "resolutionStatus", "treeResolution", "records"],
      "properties": {
        "entityId": { "type": "string", "pattern": "^100000[0-9]{2}$" },
        "name": { "type": "string", "minLength": 1 },
        "nameJa": { "type": "string", "minLength": 1 },
        "providerSlug": { "type": "string", "minLength": 1 },
        "resolutionStatus": { "const": "resolvedUnambiguous" },
        "treeResolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "directoryPaths", "pathResolution"],
          "properties": {
            "method": { "const": "nonRecursiveGitTreePath" },
            "directoryPaths": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
            "pathResolution": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["recordKind", "path"], "properties": { "recordKind": { "enum": ["talents", "constellations"] }, "path": { "type": "string", "minLength": 1 } } } }
          }
        },
        "records": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/record" } }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant", "providerSlug", "records", "comparisonPolicy", "crossVariantComparison"],
      "properties": {
        "variant": { "enum": ["anemo", "geo", "electro", "dendro", "hydro", "pyro", "cryo"] },
        "providerSlug": { "type": "string", "minLength": 1 },
        "records": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/record" } },
        "comparisonPolicy": { "const": "sameVariantPathOnly" },
        "crossVariantComparison": { "const": "forbidden" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transitionId", "fromGameVersion", "toGameVersion", "provider", "sourceFamily", "repository", "treeResolution", "versionBindings", "resolvedEntities", "travelerVariantEvidence", "variantAmbiguities", "coverage"],
      "properties": {
        "transitionId": { "const": "genshin:6.7->7.0" },
        "fromGameVersion": { "const": "6.7" },
        "toGameVersion": { "const": "7.0" },
        "provider": { "const": "genshin-db" },
        "sourceFamily": { "const": "GenshinData-derived" },
        "repository": { "const": "theBowja/genshin-db" },
        "treeResolution": { "type": "object", "additionalProperties": false, "required": ["method", "note"], "properties": { "method": { "const": "nonRecursiveGitTreePath" }, "note": { "type": "string", "minLength": 1 } } },
        "versionBindings": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["gameVersion", "revision", "packageVersion", "status", "package"], "properties": { "gameVersion": { "enum": ["6.7", "7.0"] }, "revision": { "$ref": "#/$defs/revision" }, "packageVersion": { "type": "string", "minLength": 1 }, "status": { "const": "strictlyBound" }, "package": { "$ref": "#/$defs/package" } } } },
        "resolvedEntities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/resolvedEntity" } },
        "travelerVariantEvidence": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/variant" } },
        "variantAmbiguities": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["entityId", "name", "nameJa", "resolutionStatus", "reason", "candidateVariantCount", "candidateVariants", "variantEvidenceRef", "canonicalMapping", "canonicalPromotion"], "properties": { "entityId": { "enum": ["10000005", "10000007"] }, "name": { "const": "Traveler" }, "nameJa": { "const": "旅人" }, "resolutionStatus": { "const": "unresolvedVariantAmbiguity" }, "reason": { "type": "string", "minLength": 1 }, "candidateVariantCount": { "const": 7 }, "candidateVariants": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "enum": ["anemo", "geo", "electro", "dendro", "hydro", "pyro", "cryo"] } }, "variantEvidenceRef": { "const": "claim.travelerVariantEvidence" }, "canonicalMapping": { "type": "null" }, "canonicalPromotion": { "const": "forbiddenUntilVariantIdentityIsResolved" } } } },
        "coverage": { "type": "object", "additionalProperties": false, "required": ["resolvedEntityIds", "ambiguousEntityIds", "recordKinds", "resolvedEntityRecordCoverage", "travelerVariantRecordCoverage", "repositoryCandidateCoverage", "crossVariantComparisons", "canIssueEligibilityCertificate", "canPromoteCanonical"], "properties": { "resolvedEntityIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "ambiguousEntityIds": { "type": "array", "minItems": 2, "items": { "type": "string" } }, "recordKinds": { "type": "array", "minItems": 2, "items": { "enum": ["talents", "constellations"] } }, "resolvedEntityRecordCoverage": { "const": "complete" }, "travelerVariantRecordCoverage": { "const": "complete" }, "repositoryCandidateCoverage": { "enum": ["partial", "complete"] }, "crossVariantComparisons": { "const": 0 }, "canIssueEligibilityCertificate": { "const": false }, "canPromoteCanonical": { "const": false } } }
      }
    }
  }
}
