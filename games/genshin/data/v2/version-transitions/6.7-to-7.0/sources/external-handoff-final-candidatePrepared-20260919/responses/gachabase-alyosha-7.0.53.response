i/assets/0d8e1e33d734dad50625d3f191b96308.png" data-preview-thumbnail="https://i.gachabase.net/n4AYixglf-MtYc0W6VNm4G0lGH7KW1ZT8ry3qxv84vE/q:50/f:webp/plain/gi/assets/0d8e1e33d734dad50625d3f191b96308.png" onload="this.__e=event" onerror="this.__e=event"/> <!--[-1--><!--]--> <!--[-1--><!--]--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----><!----></div> <section class="flex flex-col gap-2.5 w-full bg-glass bg-border scroll-m-4"><!--[0--><div class="flex items-stretch "><!--[-1--><!--]--> <h3 class="flex px-2.5 gap-2.5 bg-section-header grow min-w-0 items-stretch min-h-12 py-1 max-w-full"><div class="flex min-w-0 basis-0 grow self-stretch gap-2.5 items-center max-sm:w-full max-w-full"><!--[-1--><!--]--> <!--[0--><!--[1--><a href="/inventory/210288/210288/beta/7.0.53/47931186" class="group flex min-w-0 max-w-full items-center gap-1 self-center text-current no-underline"><!--[0--><span class="relative min-w-0 max-w-full text-left"><span class="min-w-0 block"><!--[0--><!--[0--><span class="gb-wrap-text font-semibold text-sm leading-3.5 uppercase tracking-widest"><!---->アリョーシャ・お座り<!----></span><!--]--><!--]--><!----></span></span><!--]--> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 shrink-0 not-group-hover:opacity-0 opacity-100 transition-opacity duration-100 pointer-events-none select-none"><path d="M21 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6"></path><path d="m21 3-9 9"></path><path d="M15 3h6v6"></path></svg><!----></a><!--]--><!--]--></div> <!--[-1--><!--]--></h3></div><!--]--> <!--[0--><div class="p-2.5 pt-0 flex flex-col gap-5"><!--[0--><span class="gb-wrap-text text-sm"><!--[0--><!---->名刺の飾り紋。<br/>「伏せ」と「お座り」は、トゥガリンにとってまったく違う命令だ。塵歌壺で洞天宝銭百枚で飼える犬に、同じことができるだろうか？<!----><!--]--></span> <!--[-1--><!--]--><!--]--><!----></div><!--]--></section><!----></div><!--]--> <!--[0--><div class="flex flex-col sidebar:lg:flex-row not-sidebar:sm:flex-row gap-2.5 sidebar:max-lg:items-center not-sidebar:max-sm:items-center"><div class="max-w-64 max-h-64 w-full h-full aspect-square flex flex-col items-center justify-center relative bg-section-header rounded-[10px]"><!----><!--[0--><!--[0--><img class="max-w-64 cursor-pointer hover:opacity-90 transition-opacity svelte-sapi7u" loading="lazy" decoding="async" src="https://i.gachabase.net/R-txKpoDtExz_Wfli5wxsiiFxYhlWhNRk6ZbBLkeqec/q:50/f:webp/plain/gi/assets/f828ede8aaff77181f5f80bac000b070.png" style="aspect-ratio: 256/256; aspect-ratio: 256/256;" data-preview-src="https://cdn.gachabase.net/gi/assets/f828ede8aaff77181f5f80bac000b070.png" data-preview-alt="Image" data-preview-download="https://cdn.gachabase.net/gi/assets/f828ede8aaff77181f5f80bac000b070.png" data-preview-thumbnail="https://i.gachabase.net/R-txKpoDtExz_Wfli5wxsiiFxYhlWhNRk6ZbBLkeqec/q:50/f:webp/plain/gi/assets/f828ede8aaff77181f5f80bac000b070.png" onload="this.__e=event" onerror="this.__e=event"/> <!--[0--><div class="absolute  z-5 gb-lazy-spinner svelte-sapi7u"></div><!--]--> <!--[-1--><!--]--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----><!----></div> <section class="flex flex-col gap-2.5 w-full bg-glass bg-border scroll-m-4"><!--[0--><div class="flex items-stretch "><!--[-1--><!--]--> <h3 class="flex px-2.5 gap-2.5 bg-section-header grow min-w-0 items-stretch min-h-12 py-1 max-w-full"><div class="flex min-w-0 basis-0 grow self-stretch gap-2.5 items-center max-sm:w-full max-w-full"><!--[-1--><!--]--> <!--[0--><!--[1--><a href="/inventory/132016/132016/beta/7.0.53/47931186" class="group flex min-w-0 max-w-full items-center gap-1 self-center text-current no-underline"><!--[0--><span class="relative min-w-0 max-w-full text-left"><span class="min-w-0 block"><!--[0--><!--[0--><span class="gb-wrap-text font-semibold text-sm leading-3.5 uppercase tracking-widest"><!---->「寸分違わず」<!----></span><!--]--><!--]--><!----></span></span><!--]--> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 shrink-0 not-group-hover:opacity-0 opacity-100 transition-opacity duration-100 pointer-events-none select-none"><path d="M21 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6"></path><path d="m21 3-9 9"></path><path d="M15 3h6v6"></path></svg><!----></a><!--]--><!--]--></div> <!--[-1--><!--]--></h3></div><!--]--> <!--[0--><div class="p-2.5 pt-0 flex flex-col gap-5"><!--[0--><span class="gb-wrap-text text-sm"><!--[0--><!---->アリョーシャのオリジナル料理。トゥガリンが興奮して吠える中、彼は大きな肉串を差し出してくれた。脂はまだジュージューと音を立てており、肉は一般的な串焼きよりも分厚く切られている。一口かじると、ジビエの野性味が炭火によってすっかり手懐けられているのが分かる…どうやら弾丸であれ火加減であれ、彼のコントロールは非常に正確なようだ！<!----><!--]--></span> <!--[-1--><!--]--><!--]--><!----> <div class="flex flex-col gap-2.5"><h4 class="text-sm font-semibold text-gi-electro uppercase">Effects</h4> <!--[0--><ul class="flex flex-col gap-2.5"><!--[--><li class="leading-4"><!--[0--><span class="gb-wrap-text text-sm"><!--[0--><!---->チーム全員が登りとダッシュに消費するスタミナ<span style="color: #3399CC;">-15%~-25%</span>、継続時間900秒。<!----><!--]--></span> <!--[-1--><!--]--><!--]--><!----></li><li class="leading-4"><!--[0--><span class="gb-wrap-text text-sm"><!--[0--><!---->マルチプレイ中、自分のキャラクターにのみ有効。<!----><!--]--></span> <!--[-1--><!--]--><!--]--><!----></li><!--]--></ul><!--]--></div> <div class="flex flex-col gap-2.5"><h4 class="text-sm font-semibold text-gi-electro uppercase">Ingredients</h4> <!--[0--><div class="grid grid-cols-1 lg:grid-cols-2 gap-2.5"><!--[--><div class="bg-border rounded-[10px] svelte-76hoi7"><!--[0--><a class="border-rank-0 ingredient-entry shadow-splash-primary need-outline rounded-[10px] pl-3.75 p-2.5 flex justify-between items-center gap-2.5 text-sm leading-4 font-semibold border-l-[5px] bg-[#0d0d0d] text-left no-underline transition-shadow duration-300" href="/inventory/100061/100061/beta/7.0.53/47931186?lang=ja"><span class="flex gap-2.5 items-center min-w-0 s