download="https://cdn.gachabase.net/gi/assets/8c3294c7d502f5a7a0366480a1338dac.png" data-preview-thumbnail="https://i.gachabase.net/8Y6Se7YGZgp9CocQm6pbKhczMJCOEOIfdITNZDUyWpo/q:50/f:webp/plain/gi/assets/8c3294c7d502f5a7a0366480a1338dac.png" onload="this.__e=event" onerror="this.__e=event"/> <!--[-1--><!--]--> <!--[0--><div class="absolute top-1/2 left-1/2 -translate-1/2 z-5 gb-lazy-spinner gb-lazy-spinner-small svelte-sapi7u"></div><!--]--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----><!----></div><!--]--><!--]--> <!--[0--><!--[0--><div class="group flex min-w-0 max-w-full items-center gap-1 self-center"><div role="button" tabindex="0" class="relative min-w-0 max-w-full text-left cursor-pointer"><!--[0--><span class="min-w-0 block"><!--[0--><!--[0--><span class="gb-wrap-text font-semibold text-sm leading-3.5 uppercase tracking-widest"><!---->「荒れ狂う風を追い ひとり高みへ昇る」<!----></span><!--]--><!--]--><!----></span><!--]--> <!--[-1--><!--]--><!----></div> <button type="button" class="inline-flex shrink-0 self-center cursor-pointer border-0 bg-transparent p-0 text-current" aria-label="Copy Link" title="Copy Link"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 not-group-hover:opacity-0 opacity-100 transition-opacity duration-100 pointer-events-none select-none"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg><!----></button></div><!--]--><!--]--></div> <!--[-1--><!--]--></h3></div><!--]--> <!--[0--><div class="p-2.5 pt-0 flex flex-col gap-2.5"><!--[0--><span class="gb-wrap-text text-sm min-w-0 wrap-break-word"><!--[0--><!---->元素スキル<span style="color: #FFD780;"><a href="#talent-11502" data-link-token="S11502" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity">柔きファントムの夜の舞</a></span>のスキルLv.+3。<br/>最大Lv.15まで。<!----><!--]--></span> <!--[-1--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----> <!--[-1--><!--]--><!----><!----></div><!--]--></section><!--]--></div> <!--[0--><div class="pointer-events-none invisible absolute left-0 top-0 w-full" aria-hidden="true"><div class="grid min-w-0 grid-cols-1 gap-2.5"><!--[--><div><section class="flex flex-col gap-2.5 h-full min-w-0 bg-glass bg-border scroll-m-4"><!--[0--><div class="flex items-stretch "><!--[0--><h3 class="w-12 min-w-12 min-h-12 self-stretch bg-gi-cryo text-section-body text-2xl leading-6 italic font-extrabold items-center justify-center flex font-header"><span>01</span></h3><!--]--> <h3 class="flex px-2.5 gap-2.5 bg-section-header grow min-w-0 items-stretch min-h-12 py-1 max-w-[calc(100%-3rem)]"><div class="flex min-w-0 basis-0 grow self-stretch gap-2.5 items-center max-sm:w-full max-w-full"><!--[0--><!--[0--><div class="relative shrink-0 flex items-center justify-center h-10 min-w-10" style="aspect-ratio: 100/100"><!----><!--[0--><!--[0--><img alt="" class="w-auto h-10  svelte-sapi7u" loading="lazy" decoding="async" src="https://i.gachabase.net/sZnVXj8muCzK-ycakUaY3nUXEtPlKc0sokOATOe-8vc/q:50/f:webp/plain/gi/assets/53f6f9270706c42d2de5256d5059c78e.png" style="aspect-ratio: 100/100; aspect-ratio: 100/100;" onload="this.__e=event" onerror="this.__e=event"/> <!--[-1--><!--]--> <!--[0--><div class="absolute top-1/2 left-1/2 -translate-1/2 z-5 gb-lazy-spinner gb-lazy-spinner-small svelte-sapi7u"></div><!--]--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----><!----></div><!--]--><!--]--> <!--[0--><!--[2--><span class="min-w-0 block"><!--[0--><!--[0--><span class="gb-wrap-text font-semibold text-sm leading-3.5 uppercase tracking-widest"><!---->「踊らぬ朝に彼女は 己の影を見つめる」<!----></span><!--]--><!--]--><!----></span><!--]--><!--]--></div> <!--[-1--><!--]--></h3></div><!--]--> <!--[0--><div class="p-2.5 pt-0 flex flex-col gap-2.5"><!--[0--><span class="gb-wrap-text text-sm min-w-0 wrap-break-word"><!--[0--><!---->特殊な元素スキル<a href="#talent-11502-tooltip-11500002" data-link-token="N11500002" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity"><span style="color: #FFD780;">柔き払暁のコーダ</span></a>の発動後、踊りが終わると、オデットは周囲の敵に<span style="color: #99FFFF;">氷元素範囲ダメージ</span>を追加で1回与える。このダメージは下記の通りとなる。<br/>・<span style="color: #FFD780;">輝映・星電導</span>とみなされる場合、または輝映状態にない場合、オデットの攻撃力の300%に相当する星電導反応ダメージとなる。<br/>・<span style="color: #FFD780;">輝映・星拡散</span>とみなされる場合、オデットの攻撃力の450%に相当する星拡散反応ダメージとなる。<br/><br/>さらに、固有天賦「選ばれし者の祝祭」が強化される。<a href="#talent-11502-tooltip-11500001" data-link-token="N11500001" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity"><span style="color: #FFD780;">独舞者のシルエット</span></a>を生成する時、オデットは<a href="#passive-1502101-tooltip-11500003" data-link-token="N11500003" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity"><span style="color: #FFD780;">春の華</span></a>を追加で2層獲得し、オデットが待機中の場合、<span style="color: #FFD780;">春の華</span>をクリアする速度が毎秒2層に上昇する。<!----><!--]--></span> <!--[-1--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----> <!--[0--><div><summary class="text-sm font-semibold cursor-pointer select-none flex gap-2.5 items-center px-1.5 py-1.5 outline-none"><!--[-1--><svg width="25" height="26" viewBox="0 0 25 26" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-gi-cryo size-6"><path d="M21.875 10.7354H14.8438V3.70416C14.8438 2.84137 14.144 2.14166 13.2812 2.14166H11.7188C10.856 2.14166 10.1562 2.84137 10.1562 3.70416V10.7354H3.125C2.26221 10.7354 1.5625 11.4351 1.5625 12.2979V13.8604C1.5625 14.7232 2.26221 15.4229 3.125 15.4229H10.1562V22.4542C10.1562 23.317 10.856 24.0167 11.7188 24.0167H13.2812C14.144 24.0167 14.8438 23.317 14.8438 22.4542V15.4229H21.875C22.7378 15.4229 23.4375 14.7232 23.4375 13.8604V12.2979C23.4375 11.4351 22.7378 10.7354 21.875 10.7354Z" fill="currentColor"></path></svg><!--]--> <span class="uppercase grow">Raw Params</span> <!--[-1--><!--]--></summary> <!--[-1--><!--]--></div><!--]--><!----><!----></div><!--]--></section><!----></div><div><section class="flex flex-col gap-2.5 h-full min-w-0 bg-glass bg-border scroll-m-4"><!--[0--><div class="flex items-stretch "><!--[0--><h3 class="w-12 min-w-12 min-h-12 self-stretch bg-gi-cryo text-section-body text-2xl leading-6 italic font-extrabold items-center justify-center flex font-header"><span>02</span></h3><!--]--> <h3 class="flex px-2.5 gap-2.5 bg-section-header grow min-w-0 items-stretch min-h-12 py-1 max-w-[calc(100%-3rem)]"><div class="flex min-w-0 basis-0 grow self-stretch gap-2.5 items-center max-sm:w-full max-w-full"><!--[0--><!--[0--><div class="relative shrink-0 flex items-center justify-center h-10 min-w-10" style="aspect-ratio: 100/100"><!----><!--[0--><!--[0--><img alt="" class="w-auto h-10  svelte-sapi7u" loading="lazy" decoding="async" src="https://i.gachabase.net/5aoZ8M9pbNM7k7vty4PNVso9XxsfrLefo-7pSfiL7bE/q:50/f:webp/plain/gi/assets/ca99d35242e7d6fd40fefe88442251e2.png" style="aspect-ratio: 100/100; aspect-ratio: 100/100;" onload="this.__e=event" onerror="this.__e=event"/> <!--[-1--><!--]--> <!--[0--><div class="absolute top-1/2 left-1/2 -translate-1/2 z-5 gb-lazy-spinner gb-lazy-spinner-small svelte-sapi7u"></div><!--]--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----><!----></div><!--]--><!--]--> <!--[0--><!--[2--><span class="min-w-0 block"><!--[0--><!--[0--><span class="gb-wrap-text font-semibold text-sm leading-3.5 uppercase tracking-widest"><!---->「雪鳥の見ぬ夢を只 見届けたいだけで」<!----></span><!--]--><!--]--><!----></span><!--]--><!--]--></div> <!--[-1--><!--]--></h3></div><!--]--> <!--[0--><div class="p-2.5 pt-0 flex flex-col gap-2.5"><!--[0--><span class="gb-wrap-text text-sm min-w-0 wrap-break-word"><!--[0--><!---->固有天賦「選ばれし者の祝祭」が強化される。<a href="#passive-1502101-tooltip-11500003" data-link-token="N11500003" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity"><span style="color: #FFD780;">春の華</span></a>1層につき、さらにキャラクターの攻撃力が7%アップする。<br/>また、<a href="#talent-11502-tooltip-11500001" data-link-token="N11500001" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity"><span style="color: #FFD780;">独舞者のシルエット</span></a>が存在する時、オデットが<a href="#talent-11502-tooltip-11500004" data-link-token="N11500004" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity"><span style="color: #FFD780;">輝映・星閃</span></a>状態の場合、<span style="color: #FFD780;">独舞者のシルエット</span>付近の敵の対応する元素耐性がさらに20%ダウンする。<br/>・<span style="color: #FFD780;">輝映・星電導</span>：<span style="color: #99FFFF;">氷元素</span>、<span style="color: #FFACFF;">雷元素</span>。<br/>・<span style="color: #FFD780;">輝映・星拡散</span>：<span style="color: #99FFFF;">氷元素</span>、<span style="color: #80FFD7;">風元素</span>。<!----><!--]--></span> <!--[-1--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----> <!--[0--><div><summary class="text-sm font-semibold cursor-pointer select-none flex gap-2.5 items-center px-1.5 py-1.5 outline-none"><!--[-1--><svg width="25" height="26" viewBox="0 0 25 26" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-gi-cryo size-6"><path d="M21.875 10.7354H14.8438V3.70416C14.8438 2.84137 14.144 2.14166 13.2812 2.14166H11.7188C10.856 2.14166 10.1562 2.84137 10.1562 3.70416V10.7354H3.125C2.26221 10.7354 1.5625 11.4351 1.5625 12.2979V13.8604C1.5625 14.7232 2.26221 15.4229 3.125 15.4229H10.1562V22.4542C10.1562 23.317 10.856 24.0167 11.7188 24.0167H13.2812C14.144 24.0167 14.8438 23.317 14.8438 22.4542V15.4229H21.875C22.7378 15.4229 23.4375 14.7232 23.4375 13.8604V12.2979C23.4375 11.4351 22.7378 10.7354 21.875 10.7354Z" fill="currentColor"></path></svg><!--]--> <span class="uppercase grow">Raw Params</span> <!--[-1--><!--]--></summary> <!--[-1--><!--]--></div><!--]--><!----><!----></div><!--]--></section><!----></div><div><section class="flex flex-col gap-2.5 h-full min-w-0 bg-glass bg-border scroll-m-4"><!--[0--><div class="flex items-stretch "><!--[0--><h3 class="w-12 min-w-12 min-h-12 self-stretch bg-gi-cryo text-section-body text-2xl leading-6 italic font-extrabold items-center justify-center flex font-header"><span>03</span></h3><!--]--> <h3 class="flex px-2.5 gap-2.5 bg-section-header grow min-w-0 items-stretch min-h-12 py-1 max-w-[calc(100%-3rem)]"><div class="flex min-w-0 basis-0 grow self-stretch gap-2.5 items-center max-sm:w-full max-w-full"><!--[0--><!--[0--><div class="relative shrink-0 flex items-center justify-center h-10 min-w-10" style="aspect-ratio: 101/101"><!----><!--[0--><!--[0--><img alt="" class="w-auto h-10  svelte-sapi7u" loading="lazy" decoding="async" src="https://i.gachabase.net/8Y6Se7YGZgp9CocQm6pbKhczMJCOEOIfdITNZDUyWpo/q:50/f:webp/plain/gi/assets/8c3294c7d502f5a7a0366480a1338dac.png" style="aspect-ratio: 101/101; aspect-ratio: 101/101;" onload="this.__e=event" onerror="this.__e=event"/> <!--[-1--><!--]--> <!--[0--><div class="absolute top-1/2 left-1/2 -translate-1/2 z-5 gb-lazy-spinner gb-lazy-spinner-small svelte-sapi7u"></div><!--]--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----><!----></div><!--]--><!--]--> <!--[0--><!--[2--><span class="min-w-0 block"><!--[0--><!--[0--><span class="gb-wrap-text font-semibold text-sm leading-3.5 uppercase tracking-widest"><!---->「荒れ狂う風を追い ひとり高みへ昇る」<!----></span><!--]--><!--]--><!----></span><!--]--><!--]--></div> <!--[-1--><!--]--></h3></div><!--]--> <!--[0--><div class="p-2.5 pt-0 flex flex-col gap-2.5"><!--[0--><span class="gb-wrap-text text-sm min-w-0 wrap-break-word"><!--[0--><!---->元素スキル<span style="color: #FFD780;"><a href="#talent-11502" data-link-token="S11502" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity">柔きファントムの夜の舞</a></span>のスキルLv.+3。<br/>最大Lv.15まで。<!----><!--]--></span> <!--[-1--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----> <!--[-1--><!--]--><!----><!----></div><!--]--></section><!----></div><!--]--></div></div><!--]--></div></div> <!--[0--><div class="grid min-w-0 grid-cols-1 gap-2.5"><!--[--><section class="flex flex-col gap-2.5 h-full min-w-0 bg-glass bg-border scroll-m-4" id="constellation-4"><!--[0--><div class="flex items-stretch "><!--[0--><h3 class="w-12 min-w-12 min-h-12 self-stretch bg-gi-cryo text-section-body text-2xl leading-6 italic font-extrabold items-center justify-center flex font-header"><span>04</span></h3><!--]--> <h3 class="flex px-2.5 gap-2.5 bg-section-header grow min-w-0 items-stretch min-h-12 py-1 max-w-[calc(100%-3rem)]"><div class="flex min-w-0 basis-0 grow self-stretch gap-2.5 items-center max-sm:w-full max-w-full"><!--[0--><!--[0--><div class="relative shrink-0 flex items-center justify-center h-10 min-w-10" style="aspect-ratio: 100/100"><!----><!--[0--><!--[0--><img alt="" class="w-auto h-10 cursor-pointer hover:opacity-90 transition-opacity svelte-sapi7u" loading="lazy" decoding="async" src="https://i.gachabase.net/cnCMfUTrXHwzAJPWfjxbZA4djG0lyC6CQ9yByEzKuVs/q:50/f:webp/plain/gi/assets/9255a1993e711d4c58cdde786b47245e.png" style="aspect-ratio: 100/100; aspect-ratio: 100/100;" data-preview-group="character-constellations-10000150" data-preview-src="https://cdn.gachabase.net/gi/assets/9255a1993e711d4c58cdde786b47245e.png" data-preview-alt="Image" data-preview-download="https://cdn.gachabase.net/gi/assets/9255a1993e711d4c58cdde786b47245e.png" data-preview-thumbnail="https://i.gachabase.net/cnCMfUTrXHwzAJPWfjxbZA4djG0lyC6CQ9yByEzKuVs/q:50/f:webp/plain/gi/assets/9255a1993e711d4c58cdde786b47245e.png" onload="this.__e=event" onerror="this.__e=event"/> <!--[-1--><!--]--> <!--[0--><div class="absolute top-1/2 left-1/2 -translate-1/2 z-5 gb-lazy-spinner gb-lazy-spinner-small svelte-sapi7u"></div><!--]--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----><!----></div><!--]--><!--]--> <!--[0--><!--[0--><div class="group flex min-w-0 max-w-full items-center gap-1 self-center"><div role="button" tabindex="0" class="relative min-w-0 max-w-full text-left cursor-pointer"><!--[0--><span class="min-w-0 block"><!--[0--><!--[0--><span class="gb-wrap-text font-semibold text-sm leading-3.5 uppercase tracking-widest"><!---->「燃ゆる青空の中へ 恍惚と堕ちていく」<!----></span><!--]--><!--]--><!----></span><!--]--> <!--[-1--><!--]--><!----></div> <button type="button" class="inline-flex shrink-0 self-center cursor-pointer border-0 bg-transparent p-0 text-current" aria-label="Copy Link" title="Copy Link"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 not-group-hover:opacity-0 opacity-100 transition-opacity duration-100 pointer-events-none select-none"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg><!----></button></div><!--]--><!--]--></div> <!--[-1--><!--]--></h3></div><!--]--> <!--[0--><div class="p-2.5 pt-0 flex flex-col gap-2.5"><!--[0--><span class="gb-wrap-text text-sm min-w-0 wrap-break-word"><!--[0--><!---->元素爆発<span style="color: #FFD780;">疾きブルーバードの夢</span>が強化される。オデットが<span style="color: #FFD780;">雪鳥の夢</span>を獲得した時、付近にいるチーム内の他のキャラクターが与える星反応ダメージがさらにアップする。ダメージアップ量は<span style="color: #FFD780;">雪鳥の夢</span>の効果の50%分に相当する。<br/><br/>また、チーム内のキャラクターが敵に星反応ダメージを与えた時、オデットは敵に対して追加攻撃を1回行い、<span style="color: #99FFFF;">氷元素範囲ダメージ</span>を1回与える。3.5秒毎に1回のみ発動可能。詳細はそれぞれ、以下の通り。<br/>・ダメージが<span style="color: #FFD780;">輝映・星電導</span>とみなされる場合、または輝映状態でない場合、オデットの攻撃力の66%分の星電導反応ダメージを与える。<br/>・ダメージが<span style="color: #FFD780;">輝映・星拡散</span>とみなされる場合、オデットの攻撃力の99%分の星拡散反応ダメージを与える。<!----><!--]--></span> <!--[-1--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----> <!--[0--><div><summary class="text-sm font-semibold cursor-pointer select-none flex gap-2.5 items-center px-1.5 py-1.5 outline-none"><!--[-1--><svg width="25" height="26" viewBox="0 0 25 26" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-gi-cryo size-6"><path d="M21.875 10.7354H14.8438V3.70416C14.8438 2.84137 14.144 2.14166 13.2812 2.14166H11.7188C10.856 2.14166 10.1562 2.84137 10.1562 3.70416V10.7354H3.125C2.26221 10.7354 1.5625 11.4351 1.5625 12.2979V13.8604C1.5625 14.7232 2.26221 15.4229 3.125 15.4229H10.1562V22.4542C10.1562 23.317 10.856 24.0167 11.7188 24.0167H13.2812C14.144 24.0167 14.8438 23.317 14.8438 22.4542V15.4229H21.875C22.7378 15.4229 23.4375 14.7232 23.4375 13.8604V12.2979C23.4375 11.4351 22.7378 10.7354 21.875 10.7354Z" fill="currentColor"></path></svg><!--]--> <span class="uppercase grow">Raw Params</span> <!--[-1--><!--]--></summary> <!--[-1--><!--]--></div><!--]--><!----><!----></div><!--]--></section><section class="flex flex-col gap-2.5 h-full min-w-0 bg-glass bg-border scroll-m-4" id="constellation-5"><!--[0--><div class="flex items-stretch "><!--[0--><h3 class="w-12 min-w-12 min-h-12 self-stretch bg-gi-cryo text-section-body text-2xl leading-6 italic font-extrabold items-center justify-center flex font-header"><span>05</span></h3><!--]--> <h3 class="flex px-2.5 gap-2.5 bg-section-header grow min-w-0 items-stretch min-h-12 py-1 max-w-[calc(100%-3rem)]"><div class="flex min-w-0 basis-0 grow self-stretch gap-2.5 items-center max-sm:w-full max-w-full"><!--[0--><!--[0--><div class="relative shrink-0 flex items-center justify-center h-10 min-w-10" style="aspect-ratio: 100/100"><!----><!--[0--><!--[0--><img alt="" class="w-auto h-10 cursor-pointer hover:opacity-90 transition-opacity svelte-sapi7u" loading="lazy" decoding="async" src="https://i.gachabase.net/um1kTDn3qBmTHR4k5GMl-6k8z7ZPUy60tdLl8TPi33A/q:50/f:webp/plain/gi/assets/12e83bbcb71b5bec034a5c1fcc301f69.png" style="aspect-ratio: 100/100; aspect-ratio: 100/100;" data-preview-group="character-constellations-10000150" data-preview-src="https://cdn.gachabase.net/gi/assets/12e83bbcb71b5bec034a5c1fcc301f69.png" data-preview-alt="Image" data-preview-download="https://cdn.gachabase.net/gi/assets/12e83bbcb71b5bec034a5c1fcc301f69.png" data-preview-thumbnail="https://i.gachabase.net/um1kTDn3qBmTHR4k5GMl-6k8z7ZPUy60tdLl8TPi33A/q:50/f:webp/plain/gi/assets/12e83bbcb71b5bec034a5c1fcc301f69.png" onload="this.__e=event" onerror="this.__e=event"/> <!--[-1--><!--]--> <!--[0--><div class="absolute top-1/2 left-1/2 -translate-1/2 z-5 gb-lazy-spinner gb-lazy-spinner-small svelte-sapi7u"></div><!--]--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----><!----></div><!--]--><!--]--> <!--[0--><!--[0--><div class="group flex min-w-0 max-w-full items-center gap-1 self-center"><div role="button" tabindex="0" class="relative min-w-0 max-w-full text-left cursor-pointer"><!--[0--><span class="min-w-0 block"><!--[0--><!--[0--><span class="gb-wrap-text font-semibold text-sm leading-3.5 uppercase tracking-widest"><!---->「見よ——塵と土の 痛みと別れる時を」<!----></span><!--]--><!--]--><!----></span><!--]--> <!--[-1--><!--]--><!----></div> <button type="button" class="inline-flex shrink-0 self-center cursor-pointer border-0 bg-transparent p-0 text-current" aria-label="Copy Link" title="Copy Link"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 not-group-hover:opacity-0 opacity-100 transition-opacity duration-100 pointer-events-none select-none"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg><!----></button></div><!--]--><!--]--></div> <!--[-1--><!--]--></h3></div><!--]--> <!--[0--><div class="p-2.5 pt-0 flex flex-col gap-2.5"><!--[0--><span class="gb-wrap-text text-sm min-w-0 wrap-break-word"><!--[0--><!---->元素爆発<span style="color: #FFD780;"><a href="#talent-11505" data-link-token="S11505" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity">疾きブルーバードの夢</a></span>のスキルLv.+3。<br/>最大Lv.15まで。<!----><!--]--></span> <!--[-1--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----> <!--[-1--><!--]--><!----><!----></div><!--]--></section><section class="flex flex-col gap-2.5 h-full min-w-0 bg-glass bg-border scroll-m-4" id="constellation-6"><!--[0--><div class="flex items-stretch "><!--[0--><h3 class="w-12 min-w-12 min-h-12 self-stretch bg-gi-cryo text-section-body text-2xl leading-6 italic font-extrabold items-center justify-center flex font-header"><span>06</span></h3><!--]--> <h3 class="flex px-2.5 gap-2.5 bg-section-header grow min-w-0 items-stretch min-h-12 py-1 max-w-[calc(100%-3rem)]"><div class="flex min-w-0 basis-0 grow self-stretch gap-2.5 items-center max-sm:w-full max-w-full"><!--[0--><!--[0--><div class="relative shrink-0 flex items-center justify-center h-10 min-w-10" style="aspect-ratio: 100/101"><!----><!--[0--><!--[0--><img alt="" class="w-auto h-10 cursor-pointer hover:opacity-90 transition-opacity svelte-sapi7u" loading="lazy" decoding="async" src="https://i.gachabase.net/oWbwxgZSG5ZMX3u7qt177nBI6zLOVXbi5QCh6Q4sSYg/q:50/f:webp/plain/gi/assets/480de671c0c0640a04285c43c41ec441.png" style="aspect-ratio: 100/101; aspect-ratio: 100/101;" data-preview-group="character-constellations-10000150" data-preview-src="https://cdn.gachabase.net/gi/assets/480de671c0c0640a04285c43c41ec441.png" data-preview-alt="Image" data-preview-download="https://cdn.gachabase.net/gi/assets/480de671c0c0640a04285c43c41ec441.png" data-preview-thumbnail="https://i.gachabase.net/oWbwxgZSG5ZMX3u7qt177nBI6zLOVXbi5QCh6Q4sSYg/q:50/f:webp/plain/gi/assets/480de671c0c0640a04285c43c41ec441.png" onload="this.__e=event" onerror="this.__e=event"/> <!--[-1--><!--]--> <!--[0--><div class="absolute top-1/2 left-1/2 -translate-1/2 z-5 gb-lazy-spinner gb-lazy-spinner-small svelte-sapi7u"></div><!--]--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----><!----></div><!--]--><!--]--> <!--[0--><!--[0--><div class="group flex min-w-0 max-w-full items-center gap-1 self-center"><div role="button" tabindex="0" class="relative min-w-0 max-w-full text-left cursor-pointer"><!--[0--><span class="min-w-0 block"><!--[0--><!--[0--><span class="gb-wrap-text font-semibold text-sm leading-3.5 uppercase tracking-widest"><!---->「さあ手を伸ばして 永遠の空に触れて」<!----></span><!--]--><!--]--><!----></span><!--]--> <!--[-1--><!--]--><!----></div> <button type="button" class="inline-flex shrink-0 self-center cursor-pointer border-0 bg-transparent p-0 text-current" aria-label="Copy Link" title="Copy Link"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 not-group-hover:opacity-0 opacity-100 transition-opacity duration-100 pointer-events-none select-none"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg><!----></button></div><!--]--><!--]--></div> <!--[-1--><!--]--></h3></div><!--]--> <!--[0--><div class="p-2.5 pt-0 flex flex-col gap-2.5"><!--[0--><span class="gb-wrap-text text-sm min-w-0 wrap-break-word"><!--[0--><!---->固有天賦「選ばれし者の祝祭」が強化される。オデットが周囲のチーム全員に<a href="#passive-1502101-tooltip-11500003" data-link-token="N11500003" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity"><span style="color: #FFD780;">春の華</span></a>を付与する時、自身の春の華は減少しなくなる。<br/>また、<span style="color: #FFD780;">春の華</span>の影響下にあるキャラクターは、敵に与える星反応ダメージが25%<a href="#constellation-1506-tooltip-11190007" data-link-token="N11190007" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity"><span style="color: #FFD780;">向上</span></a>し、オデットが敵に与える星反応ダメージが追加で20%向上する。<!----><!--]--></span> <!--[-1--><!--]--><!--]--><!----> <!--[0--><!--[0--><div class="scroll-m-20 md:scroll-m-4" id="constellation-1506-tooltips"><div><summary class="text-sm font-semibold cursor-pointer select-none flex gap-2.5 items-center px-1.5 py-1.5 outline-none"><!--[-1--><svg width="25" height="26" viewBox="0 0 25 26" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-gi-cryo size-6"><p