{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "r2-behavior-spec-materialization-audit.schema.json",
  "title": "Genshin r2 behaviorSpec candidate/claim materialization audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "generatedAt",
    "generator",
    "scope",
    "policy",
    "generatedFrom",
    "claim",
    "summary",
    "gate",
    "errors",
    "fieldDigestAlgorithm",
    "fieldDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "genshinR2BehaviorSpecMaterializationAudit" },
    "status": { "enum": ["passed", "failed"] },
    "generatedAt": { "const": "2026-08-29T00:00:00.000Z" },
    "generator": { "type": "object", "required": ["name", "version"], "additionalProperties": true },
    "scope": { "$ref": "#/$defs/scope" },
    "policy": { "$ref": "#/$defs/policy" },
    "generatedFrom": { "$ref": "#/$defs/generatedFrom" },
    "claim": { "$ref": "#/$defs/claim" },
    "summary": { "$ref": "#/$defs/summary" },
    "gate": { "$ref": "#/$defs/gate" },
    "errors": { "type": "array", "items": { "type": "string" } },
    "fieldDigestAlgorithm": { "const": "sha256-stable-json-v1" },
    "fieldDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scope": {
      "type": "object",
      "required": ["transitionId", "targetGameVersion", "clusterId", "layer", "selection", "candidateCount", "candidateIds", "candidateIdDigest"],
      "properties": {
        "transitionId": { "const": "genshin:6.7->7.0" },
        "targetGameVersion": { "const": "7.0" },
        "clusterId": { "const": "behavior:behaviorSpec:semanticDecisionRequired:ready-searchRequired:all" },
        "layer": { "const": "behaviorSpec" },
        "selection": { "type": "string", "minLength": 1 },
        "candidateCount": { "const": 1533 },
        "candidateIds": { "type": "array", "minItems": 1533, "maxItems": 1533, "items": { "type": "string" } },
        "candidateIdDigest": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "required": ["noNetworkFetch", "reuseExistingRawOnly", "proseInference", "tokenMatching", "entityRawRecordIsClaimProof", "providerIndependenceRequired", "g06DeferralRequiresFiniteCandidateFrontier", "searchRequiredIsNotSearchExhausted", "metadataBooleansNotProof", "internalRuntimeMetadataSeparateFromExternalClaims", "certificateIssuance", "canonicalPromotion", "queueMutation"],
      "properties": {
        "noNetworkFetch": { "const": true },
        "reuseExistingRawOnly": { "const": true },
        "proseInference": { "const": "forbidden" },
        "tokenMatching": { "const": "forbidden" },
        "entityRawRecordIsClaimProof": { "const": false },
        "providerIndependenceRequired": { "const": true },
        "g06DeferralRequiresFiniteCandidateFrontier": { "const": true },
        "searchRequiredIsNotSearchExhausted": { "const": true },
        "metadataBooleansNotProof": { "const": true },
        "internalRuntimeMetadataSeparateFromExternalClaims": { "const": true },
        "certificateIssuance": { "const": "forbidden" },
        "canonicalPromotion": { "const": "forbidden" },
        "queueMutation": { "const": "none" }
      },
      "additionalProperties": true
    },
    "fileEvidence": {
      "type": "object",
      "required": ["path", "role", "exists", "rawSha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "exists": { "type": "boolean" },
        "rawSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      },
      "additionalProperties": true
    },
    "generatedFrom": {
      "type": "object",
      "required": ["authoritativeQueue", "candidateSourceCoverageFrontier", "files"],
      "properties": {
        "authoritativeQueue": { "type": "object", "required": ["path", "rawSha256", "selectedTaskProjectionDigest"], "additionalProperties": true },
        "candidateSourceCoverageFrontier": { "type": "object", "additionalProperties": true },
        "files": { "type": "array", "items": { "$ref": "#/$defs/fileEvidence" } }
      },
      "additionalProperties": true
    },
    "versionBinding": {
      "type": "object",
      "required": ["gameVersion", "revision", "packageVersion", "status", "manifest"],
      "properties": {
        "gameVersion": { "enum": ["6.7", "7.0"] },
        "revision": { "type": "string", "minLength": 1 },
        "packageVersion": { "type": "string", "minLength": 1 },
        "status": { "const": "strictlyBound" },
        "manifest": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "claim": {
      "type": "object",
      "required": ["transitionId", "fromGameVersion", "toGameVersion", "provider", "sourceFamily", "providerIndependenceStatus", "versionBindings", "candidateCount", "claimCount", "externalClaimCount", "internalClaimCount", "candidates"],
      "properties": {
        "transitionId": { "const": "genshin:6.7->7.0" },
        "fromGameVersion": { "const": "6.7" },
        "toGameVersion": { "const": "7.0" },
        "provider": { "const": "genshin-db" },
        "sourceFamily": { "const": "GenshinData-derived" },
        "providerIndependenceStatus": { "const": "correlatedOnly" },
        "versionBindings": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/versionBinding" } },
        "candidateCount": { "const": 1533 },
        "claimCount": { "const": 10731 },
        "externalClaimCount": { "const": 9198 },
        "internalClaimCount": { "const": 1533 },
        "candidates": { "type": "array", "minItems": 1533, "maxItems": 1533, "items": { "$ref": "#/$defs/candidate" } }
      },
      "additionalProperties": true
    },
    "candidate": {
      "type": "object",
      "required": ["candidateId", "dataset", "layer", "entityId", "component", "sourceSpec", "queue", "transitionRaw", "finiteG06Frontier", "candidateClaims", "claimCount", "externalClaimCount", "internalClaimCount", "disposition"],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "dataset": { "type": "string", "minLength": 1 },
        "layer": { "const": "behaviorSpec" },
        "entityId": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "sourceSpec": { "type": "object", "additionalProperties": true },
        "queue": { "type": "object", "additionalProperties": true },
        "transitionRaw": { "type": "object", "additionalProperties": true },
        "finiteG06Frontier": { "type": "object", "additionalProperties": true },
        "candidateClaims": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/candidateClaim" } },
        "claimCount": { "const": 7 },
        "externalClaimCount": { "const": 6 },
        "internalClaimCount": { "const": 1 },
        "disposition": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "candidateClaim": {
      "type": "object",
      "required": ["claimId", "candidateId", "field", "claimKind", "local", "providerObservation", "rawEvidence", "disposition"],
      "properties": {
        "claimId": { "type": "string", "minLength": 1 },
        "candidateId": { "type": "string", "minLength": 1 },
        "field": { "enum": ["sourceText", "timing", "execution", "lifecycle", "energy", "snapshot", "runtime"] },
        "claimKind": { "enum": ["externalFactual", "internalRuntimeRoute"] },
        "local": { "type": "object", "additionalProperties": true },
        "providerObservation": { "type": "object", "additionalProperties": true },
        "rawEvidence": { "type": "object", "additionalProperties": true },
        "disposition": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["candidateCount", "claimCount", "externalClaimCount", "internalClaimCount", "inputClaimSchemaCompleteCandidateCount", "inputClaimSchemaMissingCandidateCount", "rawIntegrityVerifiedCandidateCount", "rawIntegrityGapCandidateCount", "candidateFieldMaterializedCount", "candidateFieldSearchRequiredCount", "finiteG06FrontierProvenCandidateCount", "evidenceDeferredCandidateCount", "strictVerifiedCandidateCount", "certificateEligibleClaimCount", "canonicalPromotionEligibleCandidateCount", "sourceFamilyCount"],
      "properties": {
        "candidateCount": { "const": 1533 },
        "claimCount": { "const": 10731 },
        "externalClaimCount": { "const": 9198 },
        "internalClaimCount": { "const": 1533 },
        "inputClaimSchemaCompleteCandidateCount": { "const": 1484 },
        "inputClaimSchemaMissingCandidateCount": { "const": 49 },
        "rawIntegrityVerifiedCandidateCount": { "const": 1521 },
        "rawIntegrityGapCandidateCount": { "const": 12 },
        "candidateFieldMaterializedCount": { "const": 0 },
        "candidateFieldSearchRequiredCount": { "const": 9198 },
        "finiteG06FrontierProvenCandidateCount": { "const": 0 },
        "evidenceDeferredCandidateCount": { "const": 0 },
        "strictVerifiedCandidateCount": { "const": 0 },
        "certificateEligibleClaimCount": { "const": 0 },
        "canonicalPromotionEligibleCandidateCount": { "const": 0 },
        "sourceFamilyCount": { "const": 1 }
      },
      "additionalProperties": true
    },
    "gate": {
      "type": "object",
      "required": ["sourceFamilyCount", "finiteG06FrontierProvenCandidateCount", "candidateFieldMaterializedCount", "strictVerifiedCandidateCount", "certificateEligibleClaimCount", "canonicalPromotionEligibleCandidateCount", "canIssueEligibilityCertificate", "canPromoteCanonical", "reasons"],
      "properties": {
        "sourceFamilyCount": { "const": 1 },
        "finiteG06FrontierProvenCandidateCount": { "const": 0 },
        "candidateFieldMaterializedCount": { "const": 0 },
        "strictVerifiedCandidateCount": { "const": 0 },
        "certificateEligibleClaimCount": { "const": 0 },
        "canonicalPromotionEligibleCandidateCount": { "const": 0 },
        "canIssueEligibilityCertificate": { "const": false },
        "canPromoteCanonical": { "const": false },
        "reasons": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  }
}
