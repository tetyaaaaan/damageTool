{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tetinet.com/schemas/hsr-attack-contract-v1.json",
  "title": "tetinet Honkai: Star Rail attack contract",
  "type": "object",
  "required": ["id", "characterId", "name", "element", "type", "target", "scalingStat", "multipliers", "sourceSkillId"],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9]+$" },
    "variant": { "enum": ["previous", "enhanced"] },
    "characterId": { "type": "string", "pattern": "^[0-9]+$" },
    "name": { "type": "string", "minLength": 1 },
    "element": { "enum": ["Physical", "Fire", "Ice", "Thunder", "Wind", "Quantum", "Imaginary"] },
    "type": { "enum": ["normal", "enhancedNormal", "skill", "enhancedSkill", "ultimate", "talent", "followUp", "additional", "dot", "memospriteSkill", "memospriteTalent", "elation", "assist"] },
    "target": { "enum": ["single", "blast", "aoe", "bounce", "adjacent"] },
    "scalingStat": { "enum": ["hp", "atk", "def", "dotBaseDamage", "elation"] },
    "multipliers": { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 0 } },
    "hitCount": { "type": "integer", "minimum": 0 },
    "hitCountReference": { "enum": ["enemy.debuffCount"] },
    "hitCountMaximum": { "type": "integer", "minimum": 1 },
    "sourceSkillId": { "type": "string", "pattern": "^[0-9]+$" },
    "requiredEidolon": { "type": "integer", "minimum": 1, "maximum": 6 },
    "hpPercentMaximum": { "type": "number", "minimum": 0, "maximum": 100 },
    "enemyHpPercentMaximum": { "type": "number", "minimum": 0, "maximum": 100 },
    "enemyCountExact": { "type": "integer", "minimum": 1, "maximum": 5 },
    "enemyCountMinimum": { "type": "integer", "minimum": 1, "maximum": 5 },
    "conditionText": { "type": "string" },
    "hidden": { "type": "boolean" },
    "support": { "$ref": "#/$defs/support" }
  },
  "$defs": {
    "support": {
      "type": "object",
      "required": ["status", "verified", "reason"],
      "properties": {
        "status": { "enum": ["calculable", "displayOnly", "review"] },
        "verified": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
