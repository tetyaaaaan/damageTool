)]"><div class="flex min-w-0 basis-0 grow self-stretch gap-2.5 items-center max-sm:w-full max-w-full"><!--[0--><!--[0--><div class="relative shrink-0 flex items-center justify-center h-10 min-w-10" style="aspect-ratio: 100/100"><!----><!--[0--><!--[0--><img alt="" class="w-auto h-10 cursor-pointer hover:opacity-90 transition-opacity svelte-sapi7u" loading="lazy" decoding="async" src="https://i.gachabase.net/_mqmtufMnI_DZup7UGkANes13f09AA-2Xm0VLBbyo0k/q:50/f:webp/plain/gi/assets/2369481c97d7fcd649c824df2664e16e.png" style="aspect-ratio: 100/100; aspect-ratio: 100/100;" data-preview-group="character-constellations-10000148" data-preview-src="https://cdn.gachabase.net/gi/assets/2369481c97d7fcd649c824df2664e16e.png" data-preview-alt="Image" data-preview-download="https://cdn.gachabase.net/gi/assets/2369481c97d7fcd649c824df2664e16e.png" data-preview-thumbnail="https://i.gachabase.net/_mqmtufMnI_DZup7UGkANes13f09AA-2Xm0VLBbyo0k/q:50/f:webp/plain/gi/assets/2369481c97d7fcd649c824df2664e16e.png" onload="this.__e=event" onerror="this.__e=event"/> <!--[-1--><!--]--> <!--[0--><div class="absolute top-1/2 left-1/2 -translate-1/2 z-5 gb-lazy-spinner gb-lazy-spinner-small svelte-sapi7u"></div><!--]--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----><!----></div><!--]--><!--]--> <!--[0--><!--[0--><div class="group flex min-w-0 max-w-full items-center gap-1 self-center"><div role="button" tabindex="0" class="relative min-w-0 max-w-full text-left cursor-pointer"><!--[0--><span class="min-w-0 block"><!--[0--><!--[0--><span class="gb-wrap-text font-semibold text-sm leading-3.5 uppercase tracking-widest"><!---->遠吠えの合図<!----></span><!--]--><!--]--><!----></span><!--]--> <!--[-1--><!--]--><!----></div> <button type="button" class="inline-flex shrink-0 self-center cursor-pointer border-0 bg-transparent p-0 text-current" aria-label="Copy Link" title="Copy Link"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="