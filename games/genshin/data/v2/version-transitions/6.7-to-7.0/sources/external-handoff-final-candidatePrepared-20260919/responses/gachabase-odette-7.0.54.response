-><!--[-1--><span class="inline-block inline-flex cursor-pointer"><!---->212.3%<!----></span><!--]--><!--]--><!--]--><!--]--><!--]--><!--]--><!--]--><!--]--></td></tr><tr class="bg-section-body"><td class="text-left font-extrabold p-2.5 align-top min-w-44">重撃スタミナ消費</td><td class="p-2.5 text-right whitespace-nowrap"><!--[0--><!--[-1--><!--[--><!--[-1--><!--[--><!--[0--><!--[-1--><!--[-1--><!--]--><!--[-1--><span class="inline-block inline-flex cursor-pointer"><!---->20.0<!----></span><!--]--><!--]--><!--]--><!--]--><!--]--><!--]--><!--]--><!--]--></td></tr><tr class="bg-section-header"><td class="text-left font-extrabold p-2.5 align-top min-w-44">落下期間のダメージ</td><td class="p-2.5 text-right whitespace-nowrap"><!--[0--><!--[-1--><!--[--><!--[-1--><!--[--><!--[0--><!--[-1--><!--[-1--><!--]--><!--[-1--><span class="inline-block inline-flex cursor-pointer"><!---->126.4%<!----></span><!--]--><!--]--><!--]--><!--]--><!--]--><!--]--><!--]--><!--]--></td></tr><tr class="bg-section-body"><td class="text-left font-extrabold p-2.5 align-top min-w-44">低空/高空落下攻撃ダメージ</td><td class="p-2.5 text-right whitespace-nowrap"><!--[0--><!--[-1--><!--[--><!--[-1--><!--[--><!--[0--><!--[-1--><!--[-1--><!--]--><!--[-1--><span class="inline-block inline-flex cursor-pointer"><!---->253%<!----></span><!--]--><!--]--><!--]--><!--]--><!--]--><!--[0--><!---->/<!----><!--]--><!--[-1--><!--[--><!--[0--><!--[-1--><!--[-1--><!--]--><!--[-1--><span class="inline-block inline-flex cursor-pointer"><!---->316%<!----></span><!--]--><!--]--><!--]--><!--]--><!--]--><!--]--><!--]--><!--]--></td></tr><!--]--></tbody></table></div><!--]--></div><!----></div></div><!--]--></div> <!--[-1--><!--]--><!----><!----></div><!--]--></section><section class="flex flex-col gap-2.5  bg-glass bg-border scroll-m-4" id="talent-11502"><!--[0--><div class="flex items-stretch "><!--[-1--><!--]--> <h3 class="flex px-2.5 gap-2.5 bg-section-header grow min-w-0 max-sm:flex-col items-stretch max-sm:py-2.5 min-h-12 py-1 justify-between max-w-full"><div class="flex min-w-0 basis-0 grow self-stretch gap-2.5 items-center max-sm:w-full max-w-full"><!--[0--><!--[0--><div class="relative shrink-0 flex items-center justify-center h-10 min-w-10" style="aspect-ratio: 101/101"><!----><!--[0--><!--[0--><img alt="" class="w-auto h-10 cursor-pointer hover:opacity-90 transition-opacity svelte-sapi7u" loading="lazy" decoding="async" src="https://i.gachabase.net/8Y6Se7YGZgp9CocQm6pbKhczMJCOEOIfdITNZDUyWpo/q:50/f:webp/plain/gi/assets/8c3294c7d502f5a7a0366480a1338dac.png" style="aspect-ratio: 101/101; aspect-ratio: 101/101;" data-preview-group="character-talents-10000150" data-preview-src="https://cdn.gachabase.net/gi/assets/8c3294c7d502f5a7a0366480a1338dac.png" data-preview-alt="Image" data-preview-download="https://cdn.gachabase.net/gi/assets/8c3294c7d502f5a7a0366480a1338dac.png" data-preview-thumbnail="https://i.gachabase.net/8Y6Se7YGZgp9CocQm6pbKhczMJCOEOIfdITNZDUyWpo/q:50/f:webp/plain/gi/assets/8c3294c7d502f5a7a0366480a1338dac.png" onload="this.__e=event" onerror="this.__e=event"/> <!--[-1--><!--]--> <!--[0--><div class="absolute top-1/2 left-1/2 -translate-1/2 z-5 gb-lazy-spinner gb-lazy-spinner-small svelte-sapi7u"></div><!--]--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----><!----></div><!--]--><!--]--> <!--[0--><!--[0--><div class="group flex min-w-0 max-w-full items-center gap-1 self-center"><div role="button" tabindex="0" class="relative min-w-0 max-w-full text-left cursor-pointer"><!--[0--><span class="min-w-0 block"><!--[0--><!--[0--><span class="gb-wrap-text font-semibold text-sm leading-3.5 uppercase tracking-widest"><!---->柔きファントムの夜の舞<!----></span><!--]--><!--]--><!----></span><!--]--> <!--[-1--><!--]--><!----></div> <button type="button" class="inline-flex shrink-0 self-center cursor-pointer border-0 bg-transparent p-0 text-current" aria-label="Copy Link" title="Copy Link"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 not-group-hover:opacity-0 opacity-100 transition-opacity duration-100 pointer-events-none select-none"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg><!----></button></div><!--]--><!--]--></div> <!--[0--><div class="grow min-w-0 self-stretch flex items-center max-sm:w-full sm:justify-end"><div class="items-center flex gap-2.5 text-base font-semibold sm:max-w-90 grow w-full"><span class="inline-block whitespace-nowrap text-base leading-4">Lv.
    10</span><!----> <!--[--><!--$s3--><!--[-1--><!----><div data-scope="slider" data-part="root" data-orientation="horizontal" id="slider:s3" dir="ltr" style="--slider-thumb-offset-0:calc(64.28571428571429% - 0px);--slider-thumb-transform:translateX(-50%);--slider-range-start:0%;--slider-range-end:35.71428571428571%;" class="relative flex w-full touch-none select-none items-center overflow-hidden h-8"><!--[--><!--[-1--><!----><div data-scope="slider" data-part="control" dir="ltr" id="slider:s3:control" data-orientation="horizontal" style="touch-action:none;user-select:none;webkit-user-select:none;position:relative;" class="w-full relative flex items-center"><!--[--><!--[-1--><!----><div data-scope="slider" data-part="track" dir="ltr" id="slider:s3:track" data-orientation="horizontal" style="position:relative;" class="bg-white relative h-1 w-full grow cursor-pointer rounded-full"><!--[--><!--[-1--><!----><div id="slider:s3:range" data-scope="slider" data-part="range" dir="ltr" data-orientation="horizontal" style="position:absolute;left:var(--slider-range-start);right:var(--slider-range-end);" class="bg-gi-cryo text-section-body absolute h-full rounded-full"><!----><!----></div><!----><!--]--><!--]--><!----><!----></div><!----><!--]--><!--]--> <!--[--><!--[-1--><!----><div data-scope="slider" data-part="thumb" dir="ltr" data-index="0" id="slider:s3:thumb:0" data-orientation="horizontal" draggable="false" aria-labelledby="slider:s3:label" aria-orientation="horizontal" aria-valuemax="15" aria-valuemin="1" aria-valuenow="10" role="slider" tabindex="0" style="visibility:hidden;position:absolute;transform:var(--slider-thumb-transform);inset-inline-start:var(--slider-thumb-offset-0);" class="bg-white size-5 border-3 sm:size-3.5 rounded-full sm:border-2 border-gi-cryo outline-none ring-0 cursor-pointer"><!--[--><!--[2--><!----><input type="text" hidden="" value="10" id="slider:s3:input:0"><!----><!--]--><!--]--><!----><!----></div><!----><!--]--><!----><!--]--><!----><!----></div><!----><!--]--><!--]--><!----><!----></div><!----><!--]--><!--]--></div><!----></div><!--]--></h3></div><!--]--> <!--[0--><div class="p-2.5 pt-0 flex flex-col gap-5"><div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_minmax(22rem,0.95fr)] gap-2.5 items-stretch min-w-0"><div class="flex flex-col gap-4 text-sm leading-4 min-w-0"><div class="text-sm"><p class="leading-6"><!--[0--><span class="gb-wrap-text text-sm leading-6 min-w-0 wrap-break-word"><!--[0--><!---->緩やかなステップで<span style="color: #99FFFF;">氷元素範囲ダメージ</span>を与え、自身の<a href="#talent-11502-tooltip-11500001" data-link-token="N11500001" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity"><span style="color: #FFD780;">独舞者（ソリスト）のシルエット</span></a>を召喚する。<br/>フィールド上にオデット自身が召喚した<span style="color: #FFD780;">独舞者のシルエット</span>がすでに存在する場合は再召喚となり、継続時間がリセットされる。<br/><br/><span style="color: #FFD780;">独舞者のシルエット</span><br/><span style="color: #FFD780;">プルーム</span>と<span style="color: #FFD780;">ウィング</span>の2種類のステップを交互に踏み、優雅で軽やかな舞いによって一定時間ごとに付近の敵を攻撃し、<span style="color: #99FFFF;">氷元素範囲ダメージ</span>を与える。<br/>また、元素スキル<span style="color: #FFD780;">柔きファントムの夜の舞</span>を発動した後の6秒間、オデットの元素スキル<span style="color: #FFD780;">柔きファントムの夜の舞</span>は特殊な元素スキル<a href="#talent-11502-tooltip-11500002" data-link-token="N11500002" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity"><span style="color: #FFD780;">柔き払暁のコーダ</span></a><a href="#talent-11502-tooltip-11500004" data-link-token="N11500004" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity"></a>に変化し、共に踊って付近の敵に継続的に<span style="color: #99FFFF;">氷元素範囲ダメージ</span>を与える。さらに、踊りの終了時に、星電導または星拡散反応ダメージと見なされる<span style="color: #99FFFF;">氷元素範囲ダメージ</span>を1回与える。<!----><!--]--></span> <!--[-1--><!--]--><!--]--><!----></p></div></div> <!--[0--><div class="flex min-w-0 flex-col gap-2.5"><div class="min-w-0 overflow-x-auto"><div class="flex h-full flex-col gap-2.5 p-2.5 border border-white m