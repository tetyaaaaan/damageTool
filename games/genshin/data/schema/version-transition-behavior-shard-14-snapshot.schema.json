{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "genshin-version-transition-behavior-shard-14-snapshot.schema.json",
  "title": "Genshin version transition behavior shard 14 snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generatedAt", "claim", "summary", "gateEligibility", "fieldDigestAlgorithm", "fieldDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "genshinVersionTransitionBehaviorShardSnapshot" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "claim": { "$ref": "#/$defs/claim" },
    "summary": { "$ref": "#/$defs/summary" },
    "gateEligibility": { "$ref": "#/$defs/gateEligibility" },
    "fieldDigestAlgorithm": { "const": "sha256-stable-json-v1" },
    "fieldDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitBlob": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["gameVersion", "revision", "packageVersion", "path", "url", "gitBlob", "rawArtifactBytes", "rawArtifactSha256", "embeddedIdPath", "embeddedId", "embeddedName"],
      "properties": {
        "gameVersion": { "enum": ["6.7", "7.0"] }, "revision": { "$ref": "#/$defs/revision" }, "packageVersion": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 }, "url": { "type": "string", "format": "uri" }, "gitBlob": { "$ref": "#/$defs/gitBlob" }, "rawArtifactBytes": { "type": "integer", "minimum": 1 }, "rawArtifactSha256": { "$ref": "#/$defs/sha256" }, "embeddedIdPath": { "const": "$.id" }, "embeddedId": { "type": "integer", "minimum": 1 }, "embeddedName": { "type": "string", "minLength": 1 }
      }
    },
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["gameVersion", "revision", "packageVersion", "path", "url", "gitBlob", "rawArtifactBytes", "rawArtifactSha256", "name", "description"],
      "properties": {
        "gameVersion": { "enum": ["6.7", "7.0"] }, "revision": { "$ref": "#/$defs/revision" }, "packageVersion": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 }, "url": { "type": "string", "format": "uri" }, "gitBlob": { "$ref": "#/$defs/gitBlob" }, "rawArtifactBytes": { "type": "integer", "minimum": 1 }, "rawArtifactSha256": { "$ref": "#/$defs/sha256" }, "name": { "const": "genshin-db" }, "description": { "type": "string", "minLength": 1 }
      }
    },
    "fieldDiff": {
      "type": "object", "additionalProperties": false,
      "required": ["jsonPointer", "beforeValue", "afterValue", "beforeFieldDigest", "afterFieldDigest"],
      "properties": { "jsonPointer": { "type": "string", "minLength": 1 }, "beforeValue": {}, "afterValue": {}, "beforeFieldDigest": { "$ref": "#/$defs/sha256" }, "afterFieldDigest": { "$ref": "#/$defs/sha256" } }
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "changedFieldCount", "fieldDiffs", "comparisonEligible", "beforeFieldDigest", "afterFieldDigest", "beforeArtifactSha256", "afterArtifactSha256"],
      "properties": { "status": { "enum": ["rawRecordMatch", "rawRecordChanged"] }, "changedFieldCount": { "type": "integer", "minimum": 0 }, "fieldDiffs": { "type": "array", "items": { "$ref": "#/$defs/fieldDiff" } }, "comparisonEligible": { "const": true }, "beforeFieldDigest": { "$ref": "#/$defs/sha256" }, "afterFieldDigest": { "$ref": "#/$defs/sha256" }, "beforeArtifactSha256": { "$ref": "#/$defs/sha256" }, "afterArtifactSha256": { "$ref": "#/$defs/sha256" } }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["recordKind", "before", "after", "comparison"],
      "properties": { "recordKind": { "enum": ["talents", "constellations"] }, "before": { "$ref": "#/$defs/artifact" }, "after": { "$ref": "#/$defs/artifact" }, "comparison": { "$ref": "#/$defs/comparison" } }
    },
    "identityResolution": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "localIdentityEvidenceDigest", "providerNameMatches", "providerEmbeddedIdMatches"],
      "properties": { "status": { "const": "resolvedByLocalCatalogAndProviderName" }, "localIdentityEvidenceDigest": { "$ref": "#/$defs/sha256" }, "providerNameMatches": { "const": true }, "providerEmbeddedIdMatches": { "const": true } }
    },
    "entity": {
      "type": "object", "additionalProperties": false,
      "required": ["entityId", "name", "nameJa", "providerSlug", "providerId", "resolutionStatus", "identityResolution", "treeResolution", "records"],
      "properties": {
        "entityId": { "enum": ["10000116", "10000119", "10000120", "10000121", "10000122", "10000123"] }, "name": { "type": "string", "minLength": 1 }, "nameJa": { "type": "string", "minLength": 1 }, "providerSlug": { "type": "string", "minLength": 1 }, "providerId": { "type": "integer", "minimum": 1 }, "resolutionStatus": { "const": "resolvedUnambiguous" }, "identityResolution": { "$ref": "#/$defs/identityResolution" }, "treeResolution": { "type": "object", "required": ["method", "resolutionEvidence", "directoryPaths", "pathResolution"], "properties": { "method": { "const": "nonRecursiveGitTreePath" }, "resolutionEvidence": { "const": "immutableRawPathWithEmbeddedId" }, "directoryPaths": { "const": ["src/data/English/talents", "src/data/English/constellations"] }, "pathResolution": { "type": "array", "minItems": 2, "maxItems": 2 } } }, "records": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/record" } }
      }
    },
    "fileDigest": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "rawArtifactBytes", "gitBlob"],
      "properties": { "sha256": { "$ref": "#/$defs/sha256" }, "rawArtifactBytes": { "type": "integer", "minimum": 1 }, "gitBlob": { "$ref": "#/$defs/gitBlob" } }
    },
    "localIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "paths", "fileDigests", "entities", "consumerMapper", "identityMismatches", "status"],
      "properties": {
        "authority": { "const": "data-v2-manifest:characters-catalog-and-source-text" }, "paths": { "type": "object", "required": ["catalog", "talents", "constellations", "consumerMapper"] }, "fileDigests": { "type": "object", "required": ["catalog", "talents", "constellations", "consumerMapper"], "properties": { "catalog": { "$ref": "#/$defs/fileDigest" }, "talents": { "$ref": "#/$defs/fileDigest" }, "constellations": { "$ref": "#/$defs/fileDigest" }, "consumerMapper": { "$ref": "#/$defs/fileDigest" } } }, "entities": { "type": "array", "minItems": 8, "maxItems": 8 }, "consumerMapper": { "type": "object", "required": ["path", "sha256", "rawArtifactBytes", "gitBlob", "status", "entries", "missingEntityIds", "identityMismatches", "policy"] }, "identityMismatches": { "const": [] }, "status": { "const": "localCatalogProviderIdentityResolved" }
      }
    },
    "overlapEvidence": { "type": "object", "required": ["entityId", "previousShardId", "previousSnapshotPath", "previousSnapshotFieldDigest", "previousEntityFieldDigest", "previousRecordCount", "previousRecordEvidence", "acquisitionPolicy"], "properties": { "entityId": { "const": "10000115" }, "previousShardId": { "const": "behavior:behaviorSpec:semanticDecisionRequired:standard:13" }, "previousSnapshotPath": { "type": "string" }, "previousSnapshotFieldDigest": { "$ref": "#/$defs/sha256" }, "previousEntityFieldDigest": { "$ref": "#/$defs/sha256" }, "previousRecordCount": { "const": 2 }, "previousRecordEvidence": { "type": "array", "minItems": 2, "maxItems": 2 }, "acquisitionPolicy": { "const": "notReacquired" } } },
    "unresolved": { "type": "object", "additionalProperties": false, "required": ["entityId", "nameJa", "resolutionStatus", "providerSlug", "providerId", "candidateSlugs", "providerEvidence", "reason", "canonicalMapping", "canonicalPromotion"], "properties": { "entityId": { "const": "10000124" }, "nameJa": { "const": "ヤフォダ" }, "resolutionStatus": { "const": "unresolvedProviderRecord" }, "providerSlug": { "type": "null" }, "providerId": { "type": "null" }, "candidateSlugs": { "const": ["yafoda"] }, "providerEvidence": { "type": "array", "minItems": 4, "maxItems": 4 }, "reason": { "type": "string", "minLength": 1 }, "canonicalMapping": { "type": "null" }, "canonicalPromotion": { "const": "forbiddenUntilProviderIdentityIsResolved" } } },
    "shard": {
      "type": "object", "additionalProperties": false,
      "required": ["shardId", "queuePath", "authoritativeCandidateCount", "authoritativeCandidateIds", "authoritativeCandidateIdsDigest", "authoritativeEntityCount", "authoritativeEntityIds", "authoritativeEntityIdsDigest", "capturedNewEntityIds", "skippedOverlapEntityIds", "overlapPolicy", "overlapEvidence"],
      "properties": { "shardId": { "const": "behavior:behaviorSpec:semanticDecisionRequired:standard:14" }, "queuePath": { "type": "string", "minLength": 1 }, "authoritativeCandidateCount": { "const": 100 }, "authoritativeCandidateIds": { "type": "array", "minItems": 100, "maxItems": 100, "uniqueItems": true, "items": { "type": "string" } }, "authoritativeCandidateIdsDigest": { "$ref": "#/$defs/sha256" }, "authoritativeEntityCount": { "const": 8 }, "authoritativeEntityIds": { "const": ["10000115", "10000116", "10000119", "10000120", "10000121", "10000122", "10000123", "10000124"] }, "authoritativeEntityIdsDigest": { "$ref": "#/$defs/sha256" }, "capturedNewEntityIds": { "const": ["10000116", "10000119", "10000120", "10000121", "10000122", "10000123"] }, "skippedOverlapEntityIds": { "const": ["10000115"] }, "overlapPolicy": { "const": "alreadyCapturedByBehaviorShard13" }, "overlapEvidence": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/overlapEvidence" } } }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["transitionId", "fromGameVersion", "toGameVersion", "provider", "sourceFamily", "sourceNamespace", "repository", "treeResolution", "identityResolution", "shard", "versionBindings", "resolvedEntities", "unresolvedEntities", "travelerVariantEvidence", "variantAmbiguities", "travelerVariantPolicy", "coverage"],
      "properties": { "transitionId": { "const": "genshin:6.7->7.0" }, "fromGameVersion": { "const": "6.7" }, "toGameVersion": { "const": "7.0" }, "provider": { "const": "genshin-db" }, "sourceFamily": { "const": "GenshinData-derived" }, "sourceNamespace": { "const": "genshin-db-behavior-shard14" }, "repository": { "const": "theBowja/genshin-db" }, "treeResolution": { "type": "object", "required": ["method", "resolutionEvidence", "note"] }, "identityResolution": { "$ref": "#/$defs/localIdentity" }, "shard": { "$ref": "#/$defs/shard" }, "versionBindings": { "type": "array", "minItems": 2, "maxItems": 2 }, "resolvedEntities": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/entity" } }, "unresolvedEntities": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/unresolved" } }, "travelerVariantEvidence": { "const": [] }, "variantAmbiguities": { "const": [] }, "travelerVariantPolicy": { "type": "object", "required": ["status", "failClosedOnEncounter", "entityIds", "note"], "properties": { "status": { "const": "notApplicable" }, "failClosedOnEncounter": { "const": true }, "entityIds": { "const": ["10000005", "10000007"] } } }, "coverage": { "type": "object", "required": ["resolvedEntityIds", "ambiguousEntityIds", "recordKinds", "authoritativeCandidateCoverage", "resolvedEntityRecordCoverage", "travelerVariantRecordCoverage", "repositoryCandidateCoverage", "authoritativeCandidateCount", "authoritativeEntityCount", "resolvedEntityCount", "ambiguousEntityCount", "resolvedRecordCount", "changedRecordCount", "changedFieldCount", "overlapEntityCount", "crossVariantComparisons", "canIssueEligibilityCertificate", "canPromoteCanonical"] } }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["shardId", "authoritativeCandidates", "authoritativeEntities", "resolvedEntities", "overlapSkippedEntities", "ambiguousEntities", "resolvedRecords", "changedRecords", "changedFields", "sourceFamilyCount", "certificateEligibleClaims"],
      "properties": { "shardId": { "const": "behavior:behaviorSpec:semanticDecisionRequired:standard:14" }, "authoritativeCandidates": { "const": 100 }, "authoritativeEntities": { "const": 8 }, "resolvedEntities": { "const": 6 }, "overlapSkippedEntities": { "const": 1 }, "ambiguousEntities": { "const": 1 }, "resolvedRecords": { "const": 12 }, "changedRecords": { "type": "integer", "minimum": 0 }, "changedFields": { "type": "integer", "minimum": 0 }, "sourceFamilyCount": { "const": 1 }, "certificateEligibleClaims": { "const": 0 } }
    },
    "gateEligibility": { "type": "object", "additionalProperties": false, "required": ["status", "sourceFamilyCount", "canIssueEligibilityCertificate", "canPromoteCanonical", "reasons"], "properties": { "status": { "const": "singleCorrelatedFamilyFailClosed" }, "sourceFamilyCount": { "const": 1 }, "canIssueEligibilityCertificate": { "const": false }, "canPromoteCanonical": { "const": false }, "reasons": { "type": "array", "minItems": 1 } } }
  }
}
