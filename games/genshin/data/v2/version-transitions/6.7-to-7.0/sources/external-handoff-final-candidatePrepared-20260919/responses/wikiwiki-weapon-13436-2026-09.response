<head prefix="og: https://ogp.me/ns# fb: https://ogp.me/ns/fb# article: https://ogp.me/ns/article#">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,minimum-scale=1,initial-scale=1">
    <script>
    (function () {
        // スマホブラウザの「PCサイトを見る」で送られてくる「明らかにスマホっぽくない UA」のときは
        // ビューポートを固定幅とし、CSS メディアクエリでレスポンシブなレイアウトになるのを避けるトリック。
        // モバイル OS でない場合も同様に固定され、ウィンドウ幅を狭めてもレイアウトが変わらない。
        var m = /(Android|iPhone|iPad)/.exec(navigator.userAgent)
        if (m && m[1] !== 'iPhone') return
        var meta = document.querySelector('meta[name="viewport"]')
        if (!meta) return
        // SEE https://github.com/kotoken/wikiwiki/issues/2102
        // Webkit の仕様により iOS ではブラウザ幅がモバイルサイズの時、フォントサイズが 16px 未満のフォーム入力欄に
        // フォーカスすると強制的にズームしてしまう。
        // これを避けるためには viewport に user-scalable=no を指定する必要があるのだが、
        // そうすると Android では ユーザー操作によるピンチズームができなくなってしまう（iOSでは、ピンチズームに関しては
        // user-scalable=no の指定を無視する）ので、iPhone だけ user-scalable=no を指定するようにする
        meta.setAttribute('content', m
            ? 'width=device-width,minimum-scale=1,initial-scale=1,user-scalable=no'
            : 'width=980')
    })()
</script>

