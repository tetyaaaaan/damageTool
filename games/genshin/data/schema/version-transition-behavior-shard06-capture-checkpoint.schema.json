{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "genshin-version-transition-behavior-shard06-capture-checkpoint.schema.json",
  "title": "Genshin version transition behavior shard 06 capture checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generatedAt", "transitionId", "status", "requestedEntityCount", "requestedEntityIds", "overlapEntityIds", "queueShard", "revisions", "nextTask", "blocker", "materializedSnapshot", "gateEligibility", "claim", "fieldDigestAlgorithm", "fieldDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "genshinVersionTransitionBehaviorShard06CaptureCheckpoint" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "transitionId": { "const": "genshin:6.7->7.0" },
    "status": { "enum": ["complete", "inProgress", "incompleteCheckpoint"] },
    "requestedEntityCount": { "const": 8 },
    "requestedEntityIds": { "type": "array", "const": ["10000054", "10000055", "10000056", "10000057", "10000059", "10000060", "10000062", "10000063"] },
    "overlapEntityIds": { "const": [] },
    "queueShard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shardId", "candidateCount", "candidateIdsDigest", "observedPrimaryBlockReason"],
      "properties": {
        "shardId": { "const": "behavior:behaviorSpec:semanticDecisionRequired:standard:06" },
        "candidateCount": { "const": 100 },
        "candidateIdsDigest": { "$ref": "#/$defs/sha256" },
        "observedPrimaryBlockReason": { "const": "semanticDecisionRequired" }
      }
    },
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": { "$ref": "#/$defs/progressBefore" },
        "after": { "$ref": "#/$defs/progressAfter" }
      }
    },
    "nextTask": { "type": "string", "minLength": 1 },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasons"],
      "properties": {
        "status": { "const": "sourceCapturedSingleCorrelatedFamily" },
        "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "materializedSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fieldDigest", "entityCount", "recordCount", "normalizedRecordsChanged"],
      "properties": {
        "path": { "const": "games/genshin/data/v2/version-transitions/6.7-to-7.0/behavior-shard-06-snapshot.json" },
        "fieldDigest": { "$ref": "#/$defs/sha256" },
        "entityCount": { "const": 8 },
        "recordCount": { "const": 16 },
        "normalizedRecordsChanged": { "type": "integer", "minimum": 0 }
      }
    },
    "gateEligibility": { "$ref": "#/$defs/gate" },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queueShardId", "queuePath", "requestedPrimaryBlockReason", "observedPrimaryBlockReason", "requestedEntityIds", "overlapEntityIds", "materializedSnapshotPath", "materializedSnapshotFieldDigest", "sourceFamilyCount", "canIssueEligibilityCertificate", "canPromoteCanonical"],
      "properties": {
        "queueShardId": { "const": "behavior:behaviorSpec:semanticDecisionRequired:standard:06" },
        "queuePath": { "const": "reports/genshin-evidence-task-queue.json" },
        "requestedPrimaryBlockReason": { "const": "sourceMissing" },
        "observedPrimaryBlockReason": { "const": "semanticDecisionRequired" },
        "requestedEntityIds": { "type": "array", "const": ["10000054", "10000055", "10000056", "10000057", "10000059", "10000060", "10000062", "10000063"] },
        "overlapEntityIds": { "const": [] },
        "materializedSnapshotPath": { "const": "games/genshin/data/v2/version-transitions/6.7-to-7.0/behavior-shard-06-snapshot.json" },
        "materializedSnapshotFieldDigest": { "$ref": "#/$defs/sha256" },
        "sourceFamilyCount": { "const": 1 },
        "canIssueEligibilityCertificate": { "const": false },
        "canPromoteCanonical": { "const": false }
      }
    },
    "fieldDigestAlgorithm": { "const": "sha256-stable-json-v1" },
    "fieldDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameVersion", "revision", "status", "completedEntityIds", "completedArtifactCount"],
      "properties": {
        "gameVersion": { "enum": ["6.7", "7.0"] },
        "revision": { "$ref": "#/$defs/revision" },
        "status": { "const": "complete" },
        "completedEntityIds": { "type": "array", "const": ["10000054", "10000055", "10000056", "10000057", "10000059", "10000060", "10000062", "10000063"] },
        "completedArtifactCount": { "const": 16 }
      }
    },
    "progressBefore": {
      "allOf": [
        { "$ref": "#/$defs/progress" },
        { "properties": { "gameVersion": { "const": "6.7" }, "revision": { "const": "1bab2cdba4d218fd5caa46b5f54e7884ee8359a2" } } }
      ]
    },
    "progressAfter": {
      "allOf": [
        { "$ref": "#/$defs/progress" },
        { "properties": { "gameVersion": { "const": "7.0" }, "revision": { "const": "8b15995fa220c88a4d0d7ffe1e21b041d0b32588" } } }
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFamilyCount", "canIssueEligibilityCertificate", "canPromoteCanonical"],
      "properties": {
        "sourceFamilyCount": { "const": 1 },
        "canIssueEligibilityCertificate": { "const": false },
        "canPromoteCanonical": { "const": false }
      }
    }
  }
}
