items-center justify-center overflow-hidden p-4 cursor-pointer pointer-events-auto" aria-label="オデット Constellations"><img src="https://cdn.gachabase.net/gi/assets/50ff2e009c1ef521aa347bed72e5e9aa.png" alt="オデット Constellations" class="block max-h-full max-w-full object-contain object-center select-none" style="filter: url(#character-constellation-art-filter-10000150);" draggable="false"/></button> <!--[--><!--$s5--><!--[-1--><!--]--> <!--[-1--><!--]--><!----><!----><!--]--><!----><!--]--></div></div> <div class="relative min-w-0"><div class="grid min-w-0 grid-cols-1 gap-2.5"><!--[--><section class="flex flex-col gap-2.5 h-full min-w-0 bg-glass bg-border scroll-m-4" id="constellation-1"><!--[0--><div class="flex items-stretch "><!--[0--><h3 class="w-12 min-w-12 min-h-12 self-stretch bg-gi-cryo text-section-body text-2xl leading-6 italic font-extrabold items-center justify-center flex font-header"><span>01</span></h3><!--]--> <h3 class="flex px-2.5 gap-2.5 bg-section-header grow min-w-0 items-stretch min-h-12 py-1 max-w-[calc(100%-3rem)]"><div class="flex min-w-0 basis-0 grow self-stretch gap-2.5 items-center max-sm:w-full max-w-full"><!--[0--><!--[0--><div class="relative shrink-0 flex items-center justify-center h-10 min-w-10" style="aspect-ratio: 100/100"><!----><!--[0--><!--[0--><img alt="" class="w-auto h-10 cursor-pointer hover:opacity-90 transition-opacity svelte-sapi7u" loading="lazy" decoding="async" src="https://i.gachabase.net/sZnVXj8muCzK-ycakUaY3nUXEtPlKc0sokOATOe-8vc/q:50/f:webp/plain/gi/assets/53f6f9270706c42d2de5256d5059c78e.png" style="aspect-ratio: 100/100; aspect-ratio: 100/100;" data-preview-group="character-constellations-10000150" data-preview-src="https://cdn.gachabase.net/gi/assets/53f6f9270706c42d2de5256d5059c78e.png" data-preview-alt="Image" data-preview-download="https://cdn.gachabase.net/gi/assets/53f6f9270706c42d2de5256d5059c78e.png" data-preview-thumbnail="https://i.gachabase.net/sZnVXj8muCzK-ycakUaY3nUXEtPlKc0sokOATOe-8vc/q:50/f:webp/plain/gi/assets/53f6f9270706c42d2de5256d5059c78e.png" onload="this.__e=event" onerror="this.__e=event"/> <!--[-1--><!--]--> <!--[0--><div class="absolute top-1/2 left-1/2 -translate-1/2 z-5 gb-lazy-spinner gb-lazy-spinner-small svelte-sapi7u"></div><!--]--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----><!----></div><!--]--><!--]--> <!--[0--><!--[0--><div class="group flex min-w-0 max-w-full items-center gap-1 self-center"><div role="button" tabindex="0" class="relative min-w-0 max-w-full text-left cursor-pointer"><!--[0--><span class="min-w-0 block"><!--[0--><!--[0--><span class="gb-wrap-text font-semibold text-sm leading-3.5 uppercase tracking-widest"><!---->「踊らぬ朝に彼女は 己の影を見つめる」<!----></span><!--]--><!--]--><!----></span><!--]--> <!--[-1--><!--]--><!----></div> <button type="button" class="inline-flex shrink-0 self-center cursor-pointer border-0 bg-transparent p-0 text-current" aria-label="Copy Link" title="Copy Link"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 not-group-hover:opacity-0 opacity-100 transition-opacity duration-100 pointer-events-none select-none"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg><!----></button></div><!--]--><!--]--></div> <!--[-1--><!--]--></h3></div><!--]--> <!--[0--><div class="p-2.5 pt-0 flex flex-col gap-2.5"><!--[0--><span class="gb-wrap-text text-sm min-w-0 wrap-break-word"><!--[0--><!---->特殊な元素スキル<a href="#talent-11502-tooltip-11500002" data-link-token="N11500002" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity"><span style="color: #FFD780;">柔き払暁のコーダ</span></a>の発動後、踊りが終わると、オデットは周囲の敵に<span style="color: #99FFFF;">氷元素範囲ダメージ</span>を追加で1回与える。このダメージは下記の通りとなる。<br/>・<span style="color: #FFD780;">輝映・星電導</span>とみなされる場合、または輝映状態にない場合、オデットの攻撃力の300%に相当する星電導反応ダメージとなる。<br/>・<span style="color: #FFD780;">輝映・星拡散</span>とみなされる場合、オデットの攻撃力の450%に相当する星拡散反応ダメージとなる。<br/><br/>さらに、固有天賦「選ばれし者の祝祭」が強化される。<a href="#talent-11502-tooltip-11500001" data-link-token="N11500001" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity"><span style="color: #FFD780;">独舞者のシルエット</span></a>を生成する時、オデットは<a href="#passive-1502101-tooltip-11500003" data-link-token="N11500003" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity"><span style="color: #FFD780;">春の華</span></a>を追加で2層獲得し、オデットが待機中の場合、<span style="color: #FFD780;">春の華</span>をクリアする速度が毎秒2層に上昇する。<!----><!--]--></span> <!--[-1--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----> <!--[0--><div><summary class="text-sm font-semibold cursor-pointer select-none flex gap-2.5 items-center px-1.5 py-1.5 outline-none"><!--[-1--><svg width="25" height="26" viewBox="0 0 25 26" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-gi-cryo size-6"><path d="M21.875 10.7354H14.8438V3.70416C14.8438 2.84137 14.144 2.14166 13.2812 2.14166H11.7188C10.856 2.14166 10.1562 2.84137 10.1562 3.70416V10.7354H3.125C2.26221 10.7354 1.5625 11.4351 1.5625 12.2979V13.8604C1.5625 14.7232 2.26221 15.4229 3.125 15.4229H10.1562V22.4542C10.1562 23.317 10.856 24.0167 11.7188 24.0167H13.2812C14.144 24.0167 14.8438 23.317 14.8438 22.4542V15.4229H21.875C22.7378 15.4229 23.4375 14.7232 23.4375 13.8604V12.2979C23.4375 11.4351 22.7378 10.7354 21.875 10.7354Z" fill="currentColor"></path></svg><!--]--> <span class="uppercase grow">Raw Params</span> <!--[-1--><!--]--></summary> <!--[-1--><!--]--></div><!--]--><!----><!----></div><!--]--></section><section class="flex flex-col gap-2.5 h-full min-w-0 bg-glass bg-border scroll-m-4" id="constellation-2"><!--[0--><div class="flex items-stretch "><!--[0--><h3 class="w-12 min-w-12 min-h-12 self-stretch bg-gi-cryo text-section-body text-2xl leading-6 italic font-extrabold items-center justify-center flex font-header"><span>02</span></h3><!--]--> <h3 class="flex px-2.5 gap-2.5 bg-section-header grow min-w-0 items-stretch min-h-12 py-1 max-w-[calc(100%-3rem)]"><div class="flex min-w-0 basis-0 grow self-stretch gap-2.5 items-center max-sm:w-full max-w-full"><!--[0--><!--[0--><div class="relative shrink-0 flex items-center justify-center h-10 min-w-10" style="aspect-ratio: 100/100"><!----><!--[0--><!--[0--><img alt="" class="w-auto h-10 cursor-pointer hover:opacity-90 transition-opacity svelte-sapi7u" loading="lazy" decoding="async" src="https://i.gachabase.net/5aoZ8M9pbNM7k7vty4PNVso9XxsfrLefo-7pSfiL7bE/q:50/f:webp/plain/gi/assets/ca99d35242e7d6fd40fefe88442251e2.png" style="aspect-ratio: 100/100; aspect-ratio: 100/100;" data-preview-group="character-constellations-10000150" data-preview-src="https://cdn.gachabase.net/gi/assets/ca99d35242e7d6fd40fefe88442251e2.png" data-preview-alt="Image" data-preview-download="https://cdn.gachabase.net/gi/assets/ca99d35242e7d6fd40fefe88442251e2.png" data-preview-thumbnail="https://i.gachabase.net/5aoZ8M9pbNM7k7vty4PNVso9XxsfrLefo-7pSfiL7bE/q:50/f:webp/plain/gi/assets/ca99d35242e7d6fd40fefe88442251e2.png" onload="this.__e=event" onerror="this.__e=event"/> <!--[-1--><!--]--> <!--[0--><div class="absolute top-1/2 left-1/2 -translate-1/2 z-5 gb-lazy-spinner gb-lazy-spinner-small svelte-sapi7u"></div><!--]--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----><!----></div><!--]--><!--]--> <!--[0--><!--[0--><div class="group flex min-w-0 max-w-full items-center gap-1 self-center"><div role="button" tabindex="0" class="relative min-w-0 max-w-full text-left cursor-pointer"><!--[0--><span class="min-w-0 block"><!--[0--><!--[0--><span class="gb-wrap-text font-semibold text-sm leading-3.5 uppercase tracking-widest"><!---->「雪鳥の見ぬ夢を只 見届けたいだけで」<!----></span><!--]--><!--]--><!----></span><!--]--> <!--[-1--><!--]--><!----></div> <button type="button" class="inline-flex shrink-0 self-center cursor-pointer border-0 bg-transparent p-0 text-current" aria-label="Copy Link" title="Copy Link"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 not-group-hover:opacity-0 opacity-100 transition-opacity duration-100 pointer-events-none select-none"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg><!----></button></div><!--]--><!--]--></div> <!--[-1--><!--]--></h3></div><!--]--> <!--[0--><div class="p-2.5 pt-0 flex flex-col gap-2.5"><!--[0--><span class="gb-wrap-text text-sm min-w-0 wrap-break-word"><!--[0--><!---->固有天賦「選ばれし者の祝祭」が強化される。<a href="#passive-1502101-tooltip-11500003" data-link-token="N11500003" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity"><span style="color: #FFD780;">春の華</span></a>1層につき、さらにキャラクターの攻撃力が7%アップする。<br/>また、<a href="#talent-11502-tooltip-11500001" data-link-token="N11500001" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity"><span style="color: #FFD780;">独舞者のシルエット</span></a>が存在する時、オデットが<a href="#talent-11502-tooltip-11500004" data-link-token="N11500004" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity"><span style="color: #FFD780;">輝映・星閃</span></a>状態の場合、<span style="color: #FFD780;">独舞者のシルエット</span>付近の敵の対応する元素耐性がさらに20%ダウンする。<br/>・<span style="color: #FFD780;">輝映・星電導</span>：<span style="color: #99FFFF;">氷元素</span>、<span style="color: #FFACFF;">雷元素</span>。<br/>・<span style="color: #FFD780;">輝映・星拡散</span>：<span style="color: #99FFFF;">氷元素</span>、<span style="color: #80FFD7;">風元素</span>。<!----><!--]--></span> <!--[-1--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----> <!--[0--><div><summary class="text-sm font-semibold cursor-pointer select-none flex gap-2.5 items-center px-1.5 py-1.5 outline-none"><!--[-1--><svg width="25" height