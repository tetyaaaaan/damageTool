    if (lshared.showHiddenItems === 'true') c.add('pref-show-hidden-items');

    var u = new URL(location.href), changed = false;
    if (site.gameLanguage && site.gameLanguage !== 'en' && !u.searchParams.has('lang')) {
        u.searchParams.set('lang', site.gameLanguage);
        changed = true;
    }
    var pathHasBranch = /(^|[/])(gb_|hyb_)?(release|beta|creator)([/]|$)/.test(u.pathname);
    if (site.branch && site.branch !== 'beta' && !u.searchParams.has('branch') && !pathHasBranch) {
