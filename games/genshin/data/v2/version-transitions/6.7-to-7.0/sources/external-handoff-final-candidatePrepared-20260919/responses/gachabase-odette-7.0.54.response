    var host = location.host, hash = 0;
    for (var i = 0; i < host.length; i++) hash = ((hash << 5) - hash + host.charCodeAt(i)) | 0;
    var site = read('prefs_' + (hash >>> 0));
    var shared = read('prefs');
    var lshared = read('l_prefs');
    var c = document.documentElement.classList;

    if (shared.sidebarOpen === true) c.add('sidebar-open');
    if (shared.realRubyText === 'false') c.add('pref-ruby');
    if (site.skillDescriptionDisplay === 'simple') c.add('pref-desc-simple');
