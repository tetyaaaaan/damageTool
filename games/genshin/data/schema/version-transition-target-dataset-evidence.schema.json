{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "genshin-version-transition-target-dataset-evidence.schema.json",
  "title": "Genshin target-version dataset evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generatedAt", "status", "claim", "fieldDigestAlgorithm", "fieldDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "genshinVersionTransitionTargetDatasetEvidence" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["partialProviderSnapshot", "completeProviderSnapshot"] },
    "claim": {
      "type": "object",
      "required": ["transitionId", "gameVersion", "provider", "sourceFamily", "revision", "versionBinding", "lineage", "materializedArtifacts", "candidateClaims", "coverage"],
      "properties": {
        "gameVersion": { "type": "string" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "versionBinding": { "type": "object" },
        "lineage": { "type": "object" },
        "materializedArtifacts": { "type": "object", "minProperties": 1 },
        "candidateClaims": { "type": "array", "minItems": 1 },
        "coverage": {
          "type": "object",
          "required": ["repositoryCandidateCoverage", "canSatisfyStrictTargetDataset", "canSatisfyCompleteEntityDiff"],
          "properties": {
            "repositoryCandidateCoverage": { "enum": ["partial", "complete"] },
            "canSatisfyStrictTargetDataset": { "type": "boolean" },
            "canSatisfyCompleteEntityDiff": { "type": "boolean" }
          }
        }
      }
    },
    "fieldDigestAlgorithm": { "const": "sha256-stable-json-v1" },
    "fieldDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
