r"><span>81.5%<wbr></span></td><td colspan="1" align="center"><span>88.0%<wbr></span></td><td colspan="1" align="center"><span>94.6%<wbr></span></td><td colspan="1" align="center"><span>101.8%<wbr></span></td><td colspan="1" align="center"><span>109.0%<wbr></span></td></tr><tr><td style="min-width:140px">3-Hit DMG</td><td colspan="1" align="center"><span>32.6%<wbr></span><span>+<wbr></span><span>38.3%<wbr></span></td><td colspan="1" align="center"><span>35.3%<wbr></span><span>+<wbr></span><span>41.4%<wbr></span></td><td colspan="1" align="center"><span>37.9%<wbr></span><span>+<wbr></span><span>44.5%<wbr></span></td><td colspan="1" align="center"><span>41.7%<wbr></span><span>+<wbr></span><span>49.0%<wbr></span></td><td colspan="1" align="center"><span>44.4%<wbr></span><span>+<wbr></span><span>52.1%<wbr></span></td><td colspan="1" align="center"><span>47.4%<wbr></span><span>+<wbr></span><span>55.6%<wbr></span></td><td colspan="1" align="center"><span>51.6%<wbr></span><span>+<wbr></span><span>60.5%<wbr></span></td><td colspan="1" align="center"><span>55.7%<wbr></span><span>+<wbr></span><span>65.4%<wbr></span></td><td colspan="1" align="center"><span>59.9%<wbr></span><span>+<wbr></span><span>70.3%<wbr></span></td><td colspan="1" align="center"><span>64.5%<wbr></span><span>+<wbr></span><span>75.7%<wbr></span></td><td colspan="1" align="center"><span>69.0%<wbr></span><span>+<wbr></span><span>81.0%<wbr></span></td></tr><tr><td style="min-width:140px">4-Hit DMG</td><td colspan="1" align="center"><span>74.6%<wbr></span></td><td colspan="1" align="center"><span>80.6%<wbr></span></td><td colspan="1" align="center"><span>86.7%<wbr></span></td><td colspan="1" align="center"><span>95.4%<wbr></span></td><td colspan="1" align="center"><span>101.5%<wbr></span></td><td colspan="1" align="center"><span>108.4%<wbr></span></td><td colspan="1" align="center"><span>117.9%<wbr></span></td><td colspan="1" align="center"><span>127.5%<wbr></span></td><td colspan="1" align="center"><span>137.0