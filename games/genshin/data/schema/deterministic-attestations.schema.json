{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tetinet.example/schemas/genshin/deterministic-attestations.schema.json",
  "title": "Genshin deterministic-consensus attestation registry",
  "type": "object",
  "required": ["schemaVersion", "kind", "generatedBy", "authority", "policy", "attestations", "summary"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "genshinDeterministicConsensusAttestationRegistry" },
    "generatedBy": {
      "type": "object",
      "required": ["name", "version"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } },
      "additionalProperties": true
    },
    "authority": {
      "type": "object",
      "required": ["eligibilityCertificates", "certificateGenerator"],
      "properties": {
        "eligibilityCertificates": { "type": "string", "minLength": 1 },
        "certificateGenerator": { "type": ["object", "null"] }
      },
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "required": ["humanReviewerMetadataForbidden", "eligibleCertificateRequired", "exactMatchOnly"],
      "properties": {
        "humanReviewerMetadataForbidden": { "const": true },
        "eligibleCertificateRequired": { "const": true },
        "exactMatchOnly": { "const": true }
      },
      "additionalProperties": true
    },
    "attestations": { "type": "array", "items": { "$ref": "#/$defs/attestation" } },
    "summary": {
      "type": "object",
      "required": ["eligibleCertificates", "attestations"],
      "properties": { "eligibleCertificates": { "type": "integer", "minimum": 0 }, "attestations": { "type": "integer", "minimum": 0 } },
      "additionalProperties": true
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source": {
      "type": "object",
      "required": ["sourceRef", "provider", "independenceGroup", "revision", "fileDigest", "fieldDigest", "gameVersion"],
      "properties": {
        "sourceRef": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "independenceGroup": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "fileDigest": { "$ref": "#/$defs/sha256" },
        "fieldDigest": { "$ref": "#/$defs/sha256" },
        "gameVersion": { "type": "string", "minLength": 1 },
        "strictGameVersionBinding": { "const": true }
      },
      "additionalProperties": true
    },
    "attestation": {
      "type": "object",
      "required": ["schemaVersion", "kind", "attestationId", "verificationMode", "type", "subjectId", "claimId", "claimField", "attestedAt", "actor", "engine", "policy", "eligibilityCertificateId", "versionSnapshotId", "sourceBundleDigest", "sourceBundle", "requiredFields", "requiredFieldSetDigest", "normalization", "exactRevisions", "gameVersion", "comparison", "semanticStatus", "scopeStatus"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "genshinDeterministicConsensusAttestation" },
        "attestationId": { "type": "string", "minLength": 1 },
        "verificationMode": { "const": "deterministicConsensus" },
        "type": { "const": "deterministicConsensus" },
        "subjectId": { "type": "string", "minLength": 1 },
        "candidateId": { "type": "string", "minLength": 1 },
        "claimId": { "type": "string", "minLength": 1 },
        "claimField": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "attestedAt": { "type": "string", "format": "date-time" },
        "actor": {
          "type": "object",
          "required": ["kind", "id"],
          "properties": { "kind": { "const": "machine" }, "id": { "type": "string", "minLength": 1 } },
          "additionalProperties": true
        },
        "engine": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": true
        },
        "policy": {
          "type": "object",
          "required": ["id", "version", "digest"],
          "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/sha256" } },
          "additionalProperties": true
        },
        "eligibilityCertificateId": { "type": "string", "minLength": 1 },
        "versionSnapshotId": { "type": "string", "minLength": 1 },
        "eligibilityCertificateDigest": { "$ref": "#/$defs/sha256" },
        "sourceBundleDigest": { "$ref": "#/$defs/sha256" },
        "sourceBundle": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/source" } },
        "requiredFields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "requiredFieldSetDigest": { "$ref": "#/$defs/sha256" },
        "normalization": {
          "type": "object",
          "required": ["id", "version", "digest"],
          "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/sha256" } },
          "additionalProperties": true
        },
        "exactRevisions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["sourceRef", "revision", "fileDigest"],
            "properties": { "sourceRef": { "type": "string", "minLength": 1 }, "revision": { "type": "string", "minLength": 1 }, "fileDigest": { "$ref": "#/$defs/sha256" } },
            "additionalProperties": true
          }
        },
        "gameVersion": {
          "type": "object",
          "required": ["value", "sourceRefs"],
          "properties": { "value": { "type": "string", "minLength": 1 }, "sourceRefs": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } } },
          "additionalProperties": true
        },
        "comparison": {
          "type": "object",
          "required": ["status", "digests"],
          "properties": { "status": { "const": "match" }, "digests": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/sha256" } } },
          "additionalProperties": true
        },
        "semanticStatus": { "const": "match" },
        "scopeStatus": { "const": "match" },
        "decision": { "const": "approve" }
      },
      "not": { "anyOf": [{ "required": ["reviewedBy"] }, { "required": ["reviewedAt"] }] },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
