88 24.0167H13.2812C14.144 24.0167 14.8438 23.317 14.8438 22.4542V15.4229H21.875C22.7378 15.4229 23.4375 14.7232 23.4375 13.8604V12.2979C23.4375 11.4351 22.7378 10.7354 21.875 10.7354Z" fill="currentColor"></path></svg><!--]--> <span class="uppercase grow">Raw Params</span> <!--[-1--><!--]--></summary> <!--[-1--><!--]--></div><!--]--><!----><!----></div><!--]--></section><!----></div><div><section class="flex flex-col gap-2.5 h-full min-w-0 bg-glass bg-border scroll-m-4"><!--[0--><div class="flex items-stretch "><!--[0--><h3 class="w-12 min-w-12 min-h-12 self-stretch bg-gi-electro text-section-body text-2xl leading-6 italic font-extrabold items-center justify-center flex font-header"><span>02</span></h3><!--]--> <h3 class="flex px-2.5 gap-2.5 bg-section-header grow min-w-0 items-stretch min-h-12 py-1 max-w-[calc(100%-3rem)]"><div class="flex min-w-0 basis-0 grow self-stretch gap-2.5 items-center max-sm:w-full max-w-full"><!--[0--><!--[0--><div class="relative shrink-0 flex items-center justify-center h-10 min-w-10" style="aspect-ratio: 100/100"><!----><!--[0--><!--[0--><img alt="" class="w-auto h-10  svelte-sapi7u" loading="lazy" decoding="async" src="https://i.gachabase.net/_mqmtufMnI_DZup7UGkANes13f09AA-2Xm0VLBbyo0k/q:50/f:webp/plain/gi/assets/2369481c97d7fcd649c824df2664e16e.png" style="aspect-ratio: 100/100; aspect-ratio: 100/100;" onload="this.__e=event" onerror="this.__e=event"/> <!--[-1--><!--]--> <!--[0--><div class="absolute top-1/2 left-1/2 -translate-1/2 z-5 gb-lazy-spinner gb-lazy-spinner-small svelte-sapi7u"></div><!--]--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----><!----></div><!--]--><!--]--> <!--[0--><!--[2--><span class="min-w-0 block"><!--[0--><!--[0--><span class="gb-wrap-text font-semibold text-sm leading-3.5 uppercase tracking-widest"><!---->遠吠えの合図<!----></span><!--]--><!--]--><!----></span><!--]--><!--]--></div> <!--[-1--><!--]--></h3></div><!--]--> <!--[0--><div class="p-2.5 pt-0 flex flex-col gap-2.5"><!--[0--><span class="gb-wrap-text text-sm min-w-0 wrap-break-word"><!--[0--><!---->元素爆発<span style="color: #FFD780;">攻守の猟犬</span>の継続時間が6秒延長される。<br/>また、<a href="#passive-1482101-tooltip-11480002" data-link-token="N11480002" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity"><span style="color: #FFD780;">トゥガリン</span></a>が敵を攻撃する前に毎回、さらに1体のターゲットに追加で<a href="#talent-11481-tooltip-11480001" data-link-token="N11480001" class="underline decoration-dotted underline-offset-2 hover:opacity-80 transition-opacity"><span style="color: #FFD780;">狩猟の印</span></a>を付与するようになる。この効果はすでに存在する<span style="color: #FFD780;">狩猟の印</span>を発動させることはない。<!----><!--]--></span> <!--[-1--><!--]--><!--]--><!----> <!--[-1--><!--]--><!----> <!--[0--><div><summary class="text-sm font-semibold cursor-pointer select-none flex gap-2.5 items-center px-1.5 py-1.5 outline-none"><!--[-1--><svg width="25" height="26" viewBox="0 0 25 26" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-gi-electro size-6"><path d="M21.875 10.7354H14.8438V3.70416C14.8438 2.84137 14.144 2.14166 13.2812 2.14166H11.7188C10.856 2.14166 10.1562 2.84137 10.1562 3.70416V10.7354H3.125C2.26221 10.7354 1.5625 11.4351 1.5625 12.2979V13.8604C1.5625 14.7232 2.26221 15.4229 3.125 15.4229H10.1562V22.4542C10.1562 23.317 10.856 24.0167 11.7188 24.0167H13.2812C14.144 24.0167 14.8438 23.317 14.8438 22.4542V15.4229H21.875C22.7378 15.4229 23.4375 14.7232 23.4375 13.8604V12.2979C23.4375 11.4351 22.7378 10.7354 21.875 10.7354Z" fill="currentColor"></path></svg><!--]--> <span class="uppercase grow">Raw Params</span> <!--[-1--><!--]--></summary> <!--[-1--><!--]--></div><!--]--><!----><!----></div><!--]--></section><!----></div><div><section class="flex flex-col gap-2.5 h-full min-w-0 bg-glass bg-border scroll-m-4"><!--[0--><div class="flex items-stretch "><!--[0--><h3 class="w-12 min-w-12 min-h-12 self-stretch bg-gi-electro text-section-body text-2xl leading-6 italic font-extrabold items-center justify-center flex font-header"><span>03</span></