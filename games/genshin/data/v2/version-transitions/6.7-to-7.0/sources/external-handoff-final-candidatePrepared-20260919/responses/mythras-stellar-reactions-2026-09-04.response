grid-cols-3 gap-5\",\"children\":[[\"$\",\"$L18\",\"genshin-damage-formula-guide\",{\"href\":\"/blog/genshin-impact/genshin-damage-formula-guide\",\"className\":\"group block glass-panel rounded-xl overflow-hidden border border-[#D4A853]/10 hover:border-[#D4A853]/40 transition-all hover:-translate-y-0.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"aspect-video bg-[#0c0c18] overflow-hidden border-b border-[#D4A853]/10\",\"children\":[\"$\",\"img\",null,{\"src\":\"/images/blog/genshin-impact/genshin-damage-formula-guide/hero-mona.webp\",\"alt\":\"Mona in her purple and black astrologer outfit against a starfield backdrop, the Hydro catalyst user whose Stellaris Phantasm burst is used in the official wiki walkthrough of the damage formula.\",\"loading\":\"lazy\",\"className\":\"w-full h-full object-contain group-hover:scale-[1.03] transition-transform duration-300\"}]}],[\"$\",\"div\",null,{\"className\":\"p-5 md:p-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-3 text-xs text-[#9999aa]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1 px-2 py-1 rounded-md bg-[#D4A853]/10 text-[#F0C850] font-semibold tracking-wider uppercase text-[10px]\",\"children\":[[\"$\",\"span\",null,{\"children\":\"🧠\"}],[\"$\",\"span\",null,{\"children\":\"Advanced Strategy\"}]]}],[\"$\",\"span\",null,{\"children\":\"Jul 29, 2026\"}],[\"$\",\"span\",null,{\"className\":\"text-[#55556a]\",\"children\":\"·\"}],[\"$\",\"span\",null,{\"children\":[11,\" min read\"]}]]}],[\"$\",\"h3\",null,{\"className\":\"text-lg md:text-xl font-bold text-white group-hover:text-[#F0C850] transition-colors leading-snug mb-2\",\"style\":{\"fontFamily\":\"var(--font-display)\",\"letterSpacing\":\"0.01em\"},\"children\":\"Genshin Damage Formula Guide — Which Multiplier Your Build Is Missing\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-[#9999aa] leading-relaxed line-clamp-3\",\"children\":\"A level 90 character hitting a level 90 enemy loses exactly half its damage before resistance, before crits, before anything you can see. That 0.5 is not difficulty tuning — it falls straight out of one line of arithmetic, and it is the reason your next upgrade probably is not another CRIT DMG roll.\"}],[\"$\",\"div\",null,{\"className\":\"mt-4 inline-flex items-center gap-1 text-xs font-semibold text-[#D4A853] group-hover:gap-2 transition-all\",\"children\":[\"Read article\",[\"$\",\"span\",null,{\"aria-hidden\":true,\"children\":\"→\"}]]}]]}]]}],[\"$\",\"$L18\",\"genshin-energy-recharge-guide\",{\"href\":\"/blog/genshin-impact/genshin-energy-recharge-guide\",\"className\":\"group block glass-panel rounded-xl overflow-hidden border border-[#D4A853]/10 hover:border-[#D4A853]/40 transition-all hover:-translate-y-0.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"aspect-video bg-[#0c0c18] overflow-hidden border-b border-[#D4A853]/10\",\"children\":[\"$\",\"img\",null,{\"src\":\"/images/blog/genshin-impact/genshin-energy-recharge-guide/hero-xingqiu.webp\",\"alt\":\"Xingqiu in his dark blue and gold Liyue robes surrounded by floating Hydro Rain Swords, the four-star support whose Elemental Skill drops five Hydro particles per cast.\",\"loading\":\"lazy\",\"className\":\"w-full h-full object-contain group-hover:scale-[1.03] transition-transform duration-300\"}]}],[\"$\",\"div\",null,{\"className\":\"p-5 md:p-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-3 text-xs text-[#9999aa]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1 px-2 py-1 rounded-md bg-[#D4A853]/10 text-[#F0C850] font-semibold tracking-wider uppercase text-[10px]\",\"children\":[[\"$\",\"span\",null,{\"children\":\"🧠\"}],[\"$\",\"span\",null,{\"children\":\"Advanced Strategy\"}]]}],\"$L56\",\"$L57\",\"$L58\"]}],\"$L59\",\"$L5a\",\"$L5b\"]}]]}],\"$L5c\",\"$L5d\",\"$L5e\",\"$L5f\"]}]]}]\n"])</script><script>self.__next_f.push([1,"97:I[16168,[\"/_next/static/chunks/5e64c2f74dd0dc