{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "genshin-version-transition-behavior-shard-05-capture-checkpoint.schema.json",
  "title": "Genshin version transition behavior shard 05 capture checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generatedAt", "transitionId", "shardId", "status", "authoritativeCandidateCount", "authoritativeEntityCount", "requestedEntityCount", "requestedEntityIds", "capturedEntityCount", "capturedEntityIds", "skippedOverlapEntityCount", "skippedOverlapEntityIds", "revisions", "materializedSnapshot", "nextTask", "gateEligibility", "claim", "fieldDigestAlgorithm", "fieldDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "genshinVersionTransitionBehaviorShard05CaptureCheckpoint" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "transitionId": { "const": "genshin:6.7->7.0" },
    "shardId": { "const": "behavior:behaviorSpec:semanticDecisionRequired:standard:05" },
    "status": { "const": "complete" },
    "authoritativeCandidateCount": { "const": 100 },
    "authoritativeEntityCount": { "const": 8 },
    "requestedEntityCount": { "const": 8 },
    "requestedEntityIds": { "type": "array", "const": ["10000046", "10000047", "10000048", "10000049", "10000050", "10000051", "10000052", "10000053"] },
    "capturedEntityCount": { "const": 7 },
    "capturedEntityIds": { "type": "array", "const": ["10000047", "10000048", "10000049", "10000050", "10000051", "10000052", "10000053"] },
    "skippedOverlapEntityCount": { "const": 1 },
    "skippedOverlapEntityIds": { "type": "array", "const": ["10000046"] },
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": { "$ref": "#/$defs/progressBefore" },
        "after": { "$ref": "#/$defs/progressAfter" }
      }
    },
    "materializedSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fieldDigest", "entityCount", "recordCount", "changedRecordCount", "changedFieldCount"],
      "properties": {
        "path": { "const": "games/genshin/data/v2/version-transitions/6.7-to-7.0/behavior-shard-05-snapshot.json" },
        "fieldDigest": { "$ref": "#/$defs/sha256" },
        "entityCount": { "const": 7 },
        "recordCount": { "const": 14 },
        "changedRecordCount": { "type": "integer", "minimum": 0 },
        "changedFieldCount": { "type": "integer", "minimum": 0 }
      }
    },
    "nextTask": { "type": "string", "minLength": 1 },
    "gateEligibility": { "$ref": "#/$defs/gate" },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queueShardId", "queuePath", "authoritativeCandidateIdsDigest", "requestedEntityIds", "capturedEntityIds", "skippedOverlapEntityIds", "materializedSnapshotPath", "materializedSnapshotFieldDigest", "completedArtifactCount", "changedRecordCount", "changedFieldCount", "sourceFamilyCount", "canIssueEligibilityCertificate", "canPromoteCanonical"],
      "properties": {
        "queueShardId": { "const": "behavior:behaviorSpec:semanticDecisionRequired:standard:05" },
        "queuePath": { "const": "reports/genshin-evidence-task-queue.json" },
        "authoritativeCandidateIdsDigest": { "$ref": "#/$defs/sha256" },
        "requestedEntityIds": { "type": "array", "const": ["10000046", "10000047", "10000048", "10000049", "10000050", "10000051", "10000052", "10000053"] },
        "capturedEntityIds": { "type": "array", "const": ["10000047", "10000048", "10000049", "10000050", "10000051", "10000052", "10000053"] },
        "skippedOverlapEntityIds": { "type": "array", "const": ["10000046"] },
        "materializedSnapshotPath": { "const": "games/genshin/data/v2/version-transitions/6.7-to-7.0/behavior-shard-05-snapshot.json" },
        "materializedSnapshotFieldDigest": { "$ref": "#/$defs/sha256" },
        "completedArtifactCount": { "const": 14 },
        "changedRecordCount": { "type": "integer", "minimum": 0 },
        "changedFieldCount": { "type": "integer", "minimum": 0 },
        "sourceFamilyCount": { "const": 1 },
        "canIssueEligibilityCertificate": { "const": false },
        "canPromoteCanonical": { "const": false }
      }
    },
    "fieldDigestAlgorithm": { "const": "sha256-stable-json-v1" },
    "fieldDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameVersion", "revision", "status", "completedEntityIds", "completedArtifactCount", "skippedOverlapArtifactCount"],
      "properties": {
        "gameVersion": { "enum": ["6.7", "7.0"] },
        "revision": { "$ref": "#/$defs/revision" },
        "status": { "const": "complete" },
        "completedEntityIds": { "type": "array", "const": ["10000047", "10000048", "10000049", "10000050", "10000051", "10000052", "10000053"] },
        "completedArtifactCount": { "const": 14 },
        "skippedOverlapArtifactCount": { "const": 2 }
      }
    },
    "progressBefore": {
      "allOf": [
        { "$ref": "#/$defs/progress" },
        { "properties": { "gameVersion": { "const": "6.7" }, "revision": { "const": "1bab2cdba4d218fd5caa46b5f54e7884ee8359a2" } } }
      ]
    },
    "progressAfter": {
      "allOf": [
        { "$ref": "#/$defs/progress" },
        { "properties": { "gameVersion": { "const": "7.0" }, "revision": { "const": "8b15995fa220c88a4d0d7ffe1e21b041d0b32588" } } }
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sourceFamilyCount", "canIssueEligibilityCertificate", "canPromoteCanonical", "reasons"],
      "properties": {
        "status": { "const": "singleCorrelatedFamilyFailClosed" },
        "sourceFamilyCount": { "const": 1 },
        "canIssueEligibilityCertificate": { "const": false },
        "canPromoteCanonical": { "const": false },
        "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
