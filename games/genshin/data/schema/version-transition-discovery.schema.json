{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "genshin-version-transition-discovery.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generatedAt", "generatedFrom", "completeness", "claim", "summary", "gateEligibility", "fieldDigestAlgorithm", "fieldDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "genshinVersionTransitionPartialDiscovery" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generatedFrom": { "type": "object", "minProperties": 3 },
    "completeness": {
      "type": "object",
      "required": ["targetDataset", "entityCoverage", "claimCoverage", "completeEntityDiffAvailable"],
      "properties": {
        "targetDataset": { "enum": ["missing", "partial", "complete"] },
        "entityCoverage": { "const": "partial" },
        "claimCoverage": { "const": "unknown" },
        "completeEntityDiffAvailable": { "const": false }
      }
    },
    "claim": {
      "type": "object",
      "required": ["transitionId", "fromGameVersion", "toGameVersion", "status", "candidateInventoryDigest", "officialChangeIndexFieldDigest", "weaponReactionComparisonDigest", "candidateMappings"],
      "properties": {
        "transitionId": { "type": "string", "minLength": 1 },
        "fromGameVersion": { "type": "string", "minLength": 1 },
        "toGameVersion": { "type": "string", "minLength": 1 },
        "status": { "const": "partialEvidence" },
        "candidateInventoryDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "officialChangeIndexFieldDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "weaponReactionComparisonDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "candidateMappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["candidateId", "dataset", "layer", "entityId", "officialChangeId", "mappingStatus", "claimScope"],
            "properties": {
              "candidateId": { "type": "string", "minLength": 1 },
              "dataset": { "type": "string", "minLength": 1 },
              "layer": { "type": "string", "minLength": 1 },
              "entityId": { "type": "string", "minLength": 1 },
              "officialChangeId": { "type": "string", "minLength": 1 },
              "mappingStatus": { "enum": ["exactCandidateMapped", "structuralScopeCandidate", "conservativeEntityInvalidation", "reactionConsumerTransition"] },
              "claimScope": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "summary": { "type": "object" },
    "gateEligibility": {
      "type": "object",
      "required": ["status", "canSatisfyEntityDiff", "canIssueEligibilityCertificate", "canPromoteCanonical"],
      "properties": {
        "status": { "const": "discoveryOnlyFailClosed" },
        "canSatisfyEntityDiff": { "const": false },
        "canIssueEligibilityCertificate": { "const": false },
        "canPromoteCanonical": { "const": false }
      }
    },
    "fieldDigestAlgorithm": { "const": "sha256-stable-json-v1" },
    "fieldDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
