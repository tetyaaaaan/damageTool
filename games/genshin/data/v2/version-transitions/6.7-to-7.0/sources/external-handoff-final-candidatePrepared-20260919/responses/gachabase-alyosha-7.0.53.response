    10</span><!----> <!--[--><!--$s4--><!--[-1--><!----><div data-scope="slider" data-part="root" data-orientation="horizontal" id="slider:s4" dir="ltr" style="--slider-thumb-offset-0:calc(64.28571428571429% - 0px);--slider-thumb-transform:translateX(-50%);--slider-range-start:0%;--slider-range-end:35.71428571428571%;" class="relative flex w-full touch-none select-none items-center overflow-hidden h-8"><!--[--><!--[-1--><!----><div data-scope="slider" data-part="control" dir="ltr" id="slider:s4:control" data-orientation="horizontal" style="touch-action:none;user-select:none;webkit-user-select:none;position:relative;" class="w-full relative flex items-center"><!--[--><!--[-1--><!----><div data-scope="slider" data-part="track" dir="ltr" id="slider:s4:track" data-orientation="horizontal" style="position:relative;" class="bg-white relative h-1 w-full grow cursor-pointer rounded-full"><!--[--><!--[-1--><!----><div id="slider:s4:range" data-scope="slider" data-part="range" dir="ltr" data-orientation="horizontal" style="position:absolute;left:var(--slider-range-start);right:var(--slider-range-end);" class="bg-gi-electro text-section-body absolute h-full rounded-full"><!----><!----></div><!----><!--]--><!--]--><!----><!----></div><!----><!--]--><!--]--> <!--[--><!--[-1--><!----><div data-scope="slider" data-part="thumb" dir="ltr" data-index="0" id="slider:s4:thumb:0" data-orientation="horizontal" draggable="false" aria-labelledby="slider:s4:label" aria-orientation="horizontal" aria-valuemax="15" aria-valuemin="1" aria-valuenow="10" role="slider" tabindex="0" style="visibility:hidden;position:absolute;transform:var(--slider-thumb-transform);inset-inline-start:var(--slider-thumb-offset-0);" class="bg-white size-5 border-3 sm:size-3.5 rounded-full sm:border-2 border-gi-electro outline-none ring-0 cursor-pointer"><!--[--><!--[2--><!----><input type="text" hidden="" value="10" id="slider:s4:input:0"><!----><!--]--><!--]--><!----><!----></div><!----><!--]--><!----><!--]--><!----><!----></div><!----><!--]--><!--]--><!----><!----></div><!----><!--]--><!--]--></div><!----></div><!--]--></h3></div><!--]--> <!--[0--><div class="p-2.5 pt-0 flex flex-col gap-5"><div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_minmax(22rem,0.95fr)] gap-2.5 items-stretch min-w-0"><div class="flex flex-col gap-4 text-sm leading-4 min-w-0"><div class="text-sm"><p class="leading-6"><!--[0--><span class="gb-wrap-text text-sm leading-6 min-w-0 wrap-break-word"><!--[0--><!---->信頼する仲間<span style="color: #FFD780;">トゥガリン</span>を戦場に呼び寄せ、前方エリアを一時的に<span style="color: #FFD780;">雷の狩場</span>へと変化させる。<br/><br/><span style="color: #FFD780;">雷の狩場</span><br/>・周囲の敵を継続的に挑発し、敵の攻撃を引き付ける。<br/>・2秒ごとに、そこに足を踏み入れた敵に対して<span style="color: #FFACFF;">雷元素範囲ダメージ</span>を1回与える。<br/><br/><span style="color: #FFD780;">トゥガリン</span><br/>・周囲に敵がいるとき、2秒ごとにいずれかの敵の近くへ素早く移動して噛みつき、<span style="color: #FFACFF;">雷元素ダメージ</span>を与える。<br/>・<span style="color: #FFD780;">狩猟の印</span>の効果を受けている敵に命中した時、<span style="color: #FFD780;">狩猟の印</span>を発動させる。<br/>・トゥガリンは<span style="color: #FFD780;">狩猟の印</span>効果を受けている敵を優先的に攻撃する。<br/><br/><i>待つことだな。焦りが消えるまで待っていれば、アカハラチドリが白樺林を越えて、向こうから撃たれに来る。</i><!----><!--]--></span> <!--[-1--><!--]--><!--]--><!----></p></div></div> <!--[0--><div class="flex min-w-0 flex-col gap-2.5"><div class="min-w-0 overflow-x-auto"><div class="flex h-full flex-col gap-2.5 p-2.5 border border-white min-w-0 w-full" style="container-type: inline-size;"><div class="flex items-center justify-between gap-4 flex-wrap"><h3 class="text-sm leading-5 font-extrabold uppercase flex items-center gap-2.5 text-white">Skill Attributes</h3></div> <!--[0--><div class="overflow-x-auto min-w-0 w-full"><table class="table-auto min-w-full cursor-default text-sm leading-5"><thead><tr class="bg-gi-electro text-section-body"><th scope="col" class="p-2.5 text-left text-sm font-semibold align-middle">Attribute</th><th scope="col" class="p-2.5 text-right text-sm font-semibold whitespace-nowrap align-middle">Value</th></tr></thead><tbody><!--[--><tr class="bg-section-body"><td class="text-left font-extrabold p-2.5 align-top min-w-44">雷の狩場ダメージ</td><td class="p-2.5 text-right whitespace-nowrap"><!--[0--><!--[-1--><!--[--><!--[-1--><!--[--><!--[0--><!--[-1--><!--[-1--><!--]--><!--[-1--><span class="inline-block inline-flex cursor-pointer"><!---->134.9%<!----></span><!--]--><!--]--><!--]--><!--]--><!--]--><!--]--><!--]--><!--]--></td></tr><tr class="bg-section-header"><td class="text-left font-extrabold p-2.5 align-top min-w-44">トゥガリンのダメージ</td><td class="p-2.5 text-right whitespace-nowrap"><!--[0--><!--[-1--><!--[--><!--[-1--><!--[--><!--[0--><!--[-1--><!--[-1--><!--]--><!--[-1--><span class="inline-block inline-flex cursor-pointer"><!---->90.4%<!----></span><!--]--><!--]--><!--]--><!--]--><!--]--><!--]--><!--]--><!--]--></td></tr><tr class="bg-section-body"><td class="text-left font-extrabold p-2.5 align-top min-w-44">継続時間</td><td class="p-2.5 text-right whitespace-nowrap"><!--[0--><!--[-1--><!--[--><!--[-1--><!--[--><!--[0--><!--[-1--><!--[-1--><!--]--><!--[-1--><span class="inline-block inline-flex cursor-pointer"><!---->14.0<!----></span><!--]--><!--]--><!--]--><!--]--><!--]--><!--[0--><!---->秒<!----><!--]--><!--]--><!--]--><!--]--></td></tr><tr class="bg-section-header"><td class="text-left font-extrabold p-2.5 align-top min-w-44">クールタイム</td><td class="p-2.5 text-right whitespace-nowrap"><!--[0--><!--[-1--><!--[--><!--[-1--><!--[--><!--[0--><!--[-1--><!--[-1--><!--]--><!--[-1--><span class="inline-block inline-flex cursor-pointer"><!---->18.0<!----></span><!--]--><!--]--><!--]--><!--]--><!--]--><!--[0--><!---->秒<!----><!--]--><!--]--><!--]--><!--]--></td></tr><tr class="bg-section-body"><td class="text-left font-extrabold p-2.5 align-top min-w-44">元素エネルギー</td><td class="p-2.5 text-right whitespace-nowrap"><!--[0--><!--[-1--><!--[--><!--[-1--><!--[--><!--[0--><!--[-1--><!--[-1--><!--]--><!--[-1--><span class="inline-block inline-flex cursor-pointer"><!---->70<!----></span><!--]--><!--]--><!-