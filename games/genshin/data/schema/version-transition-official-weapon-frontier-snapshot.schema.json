{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "genshin-version-transition-official-weapon-frontier-snapshot.schema.json",
  "title": "Genshin bounded official weapon frontier snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generatedAt", "status", "claim", "summary", "gateEligibility", "fieldDigestAlgorithm", "fieldDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "genshinVersionTransitionOfficialWeaponFrontierSnapshot" },
    "generatedAt": { "const": "2026-08-28T00:00:00.000Z" },
    "status": { "const": "officialRawCapturedTargetVersionUnbound" },
    "claim": { "$ref": "#/$defs/claim" },
    "summary": { "$ref": "#/$defs/summary" },
    "gateEligibility": { "$ref": "#/$defs/gate" },
    "fieldDigestAlgorithm": { "const": "sha256-stable-json-v1" },
    "fieldDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "claim": {
      "type": "object",
      "additionalProperties": true,
      "required": ["transitionId", "targetGameVersion", "dataset", "provider", "providerId", "sourceFamily", "independenceGroup", "lineage", "immutable", "revision", "searchScope", "queue", "localIdentity", "captureManifest", "entities", "candidateClaims", "gateDisposition"],
      "properties": {
        "transitionId": { "const": "genshin:6.7->7.0" },
        "targetGameVersion": { "const": "7.0" },
        "dataset": { "const": "weapons" },
        "provider": { "const": "HoYoverse HoYoWiki" },
        "providerId": { "const": "hoyoverse-hoyowiki" },
        "sourceFamily": { "const": "official-hoyoverse" },
        "independenceGroup": { "const": "official-hoyoverse" },
        "lineage": { "type": "string", "minLength": 1 },
        "immutable": { "const": false },
        "revision": { "type": "object", "required": ["status", "value"], "properties": { "status": { "const": "mutableEndpointNoRevision" }, "value": { "type": ["null", "string"] } } },
        "searchScope": { "type": "object", "required": ["status", "provider", "providersExamined", "exactEntityIds", "exhaustive", "accessStatus", "reopenTrigger"], "properties": { "status": { "const": "boundedOfficialProviderCapture" }, "provider": { "const": "HoYoverse HoYoWiki" }, "providersExamined": { "type": "array", "contains": { "const": "HoYoverse HoYoWiki" } }, "exactEntityIds": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true }, "exhaustive": { "const": false }, "accessStatus": { "const": "captured" }, "reopenTrigger": { "type": "string", "minLength": 1 } } },
        "queue": { "type": "object" },
        "localIdentity": { "type": "object" },
        "captureManifest": { "type": "object", "required": ["path", "digest", "bytes"], "properties": { "path": { "type": "string" }, "digest": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 1 } } },
        "entities": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/entity" } },
        "candidateClaims": { "type": "array", "items": { "$ref": "#/$defs/candidateClaim" } },
        "gateDisposition": { "$ref": "#/$defs/gateDisposition" }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["entityId", "localNameJa", "provider", "identityResolution", "sourceEvidence", "parsedFields", "providerVersionEvidence", "candidateClaims", "candidateCoverage", "sourceFamilyCount", "canIssueEligibilityCertificate", "canPromoteCanonical"],
      "properties": {
        "entityId": { "enum": ["11301", "11302", "11303"] },
        "localNameJa": { "type": "string", "minLength": 1 },
        "provider": { "type": "object" },
        "identityResolution": { "type": "object" },
        "sourceEvidence": { "type": "object" },
        "parsedFields": { "type": "object" },
        "providerVersionEvidence": { "type": "object" },
        "candidateClaims": { "type": "array" },
        "candidateCoverage": { "enum": ["queueClaimsPresent", "noV2CandidateClaimForEntity"] },
        "sourceFamilyCount": { "const": 1 },
        "canIssueEligibilityCertificate": { "const": false },
        "canPromoteCanonical": { "const": false }
      }
    },
    "candidateClaim": {
      "type": "object",
      "additionalProperties": true,
      "required": ["candidateId", "claimId", "entityId", "field", "providerField", "fieldCoverage", "strictGameVersionBinding", "disposition"],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "claimId": { "type": "string", "minLength": 1 },
        "entityId": { "type": "string", "minLength": 1 },
        "field": { "enum": ["activation", "refinement", "targets", "value"] },
        "providerField": { "type": "object", "required": ["status", "key", "rawValue", "rawLocator"], "properties": { "status": { "const": "rawFieldPresent" }, "key": { "type": "string" }, "rawValue": {}, "rawLocator": { "type": "object" } } },
        "fieldCoverage": { "type": "object" },
        "strictGameVersionBinding": { "type": "object", "required": ["targetGameVersion", "status", "captureTimestampIsNotVersionEvidence"], "properties": { "targetGameVersion": { "const": "7.0" }, "status": { "const": "missing" }, "captureTimestampIsNotVersionEvidence": { "const": true } } },
        "disposition": { "type": "object", "required": ["status", "blockers", "canIssueEligibilityCertificate", "canPromoteCanonical"], "properties": { "status": { "const": "blocked" }, "blockers": { "type": "array", "minItems": 1 }, "canIssueEligibilityCertificate": { "const": false }, "canPromoteCanonical": { "const": false } } }
      }
    },
    "gateDisposition": {
      "type": "object",
      "required": ["status", "sourceFamilyCount", "strictGameVersionBinding", "canIssueEligibilityCertificate", "canPromoteCanonical"],
      "properties": {
        "status": { "const": "officialRawAvailableButTargetVersionUnbound" },
        "sourceFamilyCount": { "const": 1 },
        "strictGameVersionBinding": { "const": "missing" },
        "canIssueEligibilityCertificate": { "const": false },
        "canPromoteCanonical": { "const": false }
      }
    },
    "summary": {
      "type": "object",
      "required": ["entities", "directRawRecords", "aggregateRawRecords", "candidateClaims", "rawPassiveFields", "noV2CandidateClaimEntities", "strictTargetVersionBoundEntities", "sourceFamilyCount", "certificateEligibleClaims", "canonicalPromotionCount"],
      "properties": {
        "entities": { "const": 3 },
        "directRawRecords": { "const": 3 },
        "aggregateRawRecords": { "const": 3 },
        "candidateClaims": { "const": 12 },
        "rawPassiveFields": { "const": 3 },
        "noV2CandidateClaimEntities": { "const": 1 },
        "strictTargetVersionBoundEntities": { "const": 0 },
        "sourceFamilyCount": { "const": 1 },
        "certificateEligibleClaims": { "const": 0 },
        "canonicalPromotionCount": { "const": 0 }
      }
    },
    "gate": {
      "type": "object",
      "required": ["status", "sourceFamilyCount", "canIssueEligibilityCertificate", "canPromoteCanonical"],
      "properties": {
        "status": { "const": "officialRawAvailableButTargetVersionUnbound" },
        "sourceFamilyCount": { "const": 1 },
        "canIssueEligibilityCertificate": { "const": false },
        "canPromoteCanonical": { "const": false }
      }
    }
  }
}
